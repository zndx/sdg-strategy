    skos:altLabel "AdministrativeRole" ;
    skos:altLabel "Person" ;
    skos:altLabel "AdministrativeActivity" ;
    skos:definition "{AdministrativeRole} is a role that inheres in exactly one {Person}, and that is realized in some {AdministrativeActivity} As a role, {AdministrativeRole} is characterised by the inheres in relation to exactly one {Person}, and the is realized in relation to at least one {AdministrativeActivity}. Each {AdministrativeRole} is defined as a role which inheres in exactly one {Person}, and which is realized in some {AdministrativeActivity}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_EXECUTIVE_OFFICER_ROLE> a skos:Concept ;
    skos:prefLabel "Executive Officer Role" ;
    skos:notation "5.42" ;
    skos:altLabel "EXECUTIVE_OFFICER_ROLE" ;
    skos:altLabel "ExecutiveOfficerRole" ;
