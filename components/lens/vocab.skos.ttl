@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sdg:  <https://signals.zndx.org/sdg#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://signals.zndx.org/sdg/scheme> a skos:ConceptScheme ;
    skos:prefLabel "SDG column-type vocabulary (ontology-derived)" .

<https://signals.zndx.org/sdg#SDG_PROCESS> a skos:Concept ;
    skos:prefLabel "Process" ;
    skos:notation "1" ;
    skos:altLabel "PROC" ;
    skos:definition "A BFO process (occurrent): an entity that unfolds in time, e.g. an observation, a program execution, a governance activity." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> a skos:Concept ;
    skos:prefLabel "Independent Continuant" ;
    skos:notation "2" ;
    skos:altLabel "INDCONT" ;
    skos:definition "A BFO independent continuant: a bearer of qualities that persists through time." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ARTIFACT> a skos:Concept ;
    skos:prefLabel "Artifact" ;
    skos:notation "2.1" ;
    skos:altLabel "ARTIFACT" ;
    skos:definition "A CCO artifact: an object intentionally made to realize a function (instruments, systems, datasets-as-objects)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC> a skos:Concept ;
    skos:prefLabel "Generically Dependent Continuant" ;
    skos:notation "3" ;
    skos:altLabel "GDC" ;
    skos:definition "A BFO generically dependent continuant: a continuant that depends on one or more bearers and can migrate between them (information, patterns, designs)." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE> a skos:Concept ;
    skos:prefLabel "Information Content Entity" ;
    skos:notation "3.0" ;
    skos:altLabel "ICE" ;
    skos:definition "A CCO information content entity: a generically dependent continuant that is about, or carries information concerning, some entity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY> a skos:Concept ;
    skos:prefLabel "Quality" ;
    skos:notation "4" ;
    skos:altLabel "QUAL" ;
    skos:definition "A BFO quality: a specifically dependent continuant that is exhibited whenever its bearer exists (a measurable/observable attribute)." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE> a skos:Concept ;
    skos:prefLabel "Role" ;
    skos:notation "5" ;
    skos:altLabel "ROLE" ;
    skos:definition "A BFO role: a realizable specifically dependent continuant a bearer has in virtue of external circumstances (physician role, foreign-key role)." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_DISPOSITION> a skos:Concept ;
    skos:prefLabel "Disposition" ;
    skos:notation "6" ;
    skos:altLabel "DISP" ;
    skos:definition "A BFO disposition: a realizable entity grounded in the bearer's physical make-up (a capacity or tendency to be realized in a process)." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> a skos:Concept ;
    skos:prefLabel "Material Entity" ;
    skos:notation "2.2" ;
    skos:altLabel "MATENT" ;
    skos:definition "A BFO material entity: an independent continuant that has matter as a part." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> a skos:Concept ;
    skos:prefLabel "Descriptive Information Content Entity" ;
    skos:notation "3.1" ;
    skos:altLabel "DESCICE" ;
    skos:definition "An ICE that describes an entity or state of affairs (measurements, records, observations)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> a skos:Concept ;
    skos:prefLabel "Directive Information Content Entity" ;
    skos:notation "3.2" ;
    skos:altLabel "DIRICE" ;
    skos:definition "An ICE that prescribes or directs (plans, rules, requirements, policies)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> a skos:Concept ;
    skos:prefLabel "Designative Information Content Entity" ;
    skos:notation "3.3" ;
    skos:altLabel "DESIGICE" ;
    skos:definition "An ICE that designates or names an entity (identifiers, codes, keys)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC> a skos:Concept ;
    skos:prefLabel "Generic Entity" ;
    skos:notation "0" ;
    skos:altLabel "GENERIC" ;
    skos:definition "Foundational / domain-agnostic axiom patterns without a specific BFO/CCO anchor." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_PARENTING_ROLE> a skos:Concept ;
    skos:prefLabel "Parenting Role" ;
    skos:notation "5.1" ;
    skos:altLabel "PARENTING_ROLE" ;
    skos:altLabel "ParentingRole" ;
    skos:altLabel "DisabledAdult" ;
    skos:altLabel "ParentingActivity" ;
    skos:definition "{ParentingRole} is a role that inheres in exactly one {DisabledAdult}, and that is realized in some {ParentingActivity} As a role, {ParentingRole} is characterised by the inheres in relation to exactly one {DisabledAdult}, and the is realized in relation to at least one {ParentingActivity}. Every {ParentingRole} stands in the inheres in relation to exactly one {DisabledAdult}, and the is realized in relation to at least one {ParentingActivity}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CLINICAL_DOCUMENTATION_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Clinical Documentation Activity" ;
    skos:notation "1.1" ;
    skos:altLabel "CLINICAL_DOCUMENTATION_ACTIVITY" ;
    skos:altLabel "ClinicalDocumentationActivity" ;
    skos:altLabel "InformationSystem" ;
    skos:altLabel "PatientEncounter" ;
    skos:definition "ClinicalDocumentationActivity is a process that utilizes an InformationSystem and records a PatientEncounter." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_PDF_EXPORT_PROCESS> a skos:Concept ;
    skos:prefLabel "Pdf Export Process" ;
    skos:notation "1.2" ;
    skos:altLabel "PDF_EXPORT_PROCESS" ;
    skos:altLabel "PdfExportProcess" ;
    skos:altLabel "ScannedImageSet" ;
    skos:altLabel "PdfDocument" ;
    skos:altLabel "ExportExecution" ;
    skos:definition "A PdfExportProcess is defined as a Process that ingests a ScannedImageSet, produces a PdfDocument, and inherits in an ExportExecution. The Process type PdfExportProcess is characterized by the ingestion of a ScannedImageSet, the production of a PdfDocument, and its inheritance in an ExportExecution." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_LECTURE_SESSION> a skos:Concept ;
    skos:prefLabel "Lecture Session" ;
    skos:notation "1.3" ;
    skos:altLabel "LECTURE_SESSION" ;
    skos:altLabel "LectureSession" ;
    skos:altLabel "LectureNotes" ;
    skos:altLabel "MathematicaExample" ;
    skos:definition "A LectureSession is defined as an Occurrent that possesses at least one LectureNotes via has_educational_resource and at least one MathematicaExample via has_computational_example. Every instance of LectureSession qualifies as an Occurrent, and each such instance necessarily includes at least one LectureNotes entity linked by has_educational_resource alongside at least one MathematicaExample entity linked by has_computational_example. The relation has_educational_resource associates every LectureSession with at least one LectureNotes entity, while the relation has_computational_example associates every LectureSession with at least one MathematicaExample entity, and each LectureSession constitutes an Occurrent." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_YOUNG_RESEARCHER_ROLE> a skos:Concept ;
    skos:prefLabel "Young Researcher Role" ;
    skos:notation "5.2" ;
    skos:altLabel "YOUNG_RESEARCHER_ROLE" ;
    skos:altLabel "YoungResearcherRole" ;
    skos:altLabel "IndependentContinuant" ;
    skos:altLabel "YoungResearcherResearchProcess" ;
    skos:definition "{YoungResearcherRole} is a role that is borne by exactly one {IndependentContinuant}, and that is realized in some {YoungResearcherResearchProcess} For an entity to count as {YoungResearcherRole}, it must bear the is borne by relation to exactly one {IndependentContinuant}, and the is realized in relation to at least one {YoungResearcherResearchProcess}. As a role, {YoungResearcherRole} is characterised by the is borne by relation to exactly one {IndependentContinuant}, and the is realized in relation to at least one {YoungResearcherResearchProcess}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_LIBRARY_STUDENT_ASSISTANT_ROLE> a skos:Concept ;
    skos:prefLabel "Library Student Assistant Role" ;
    skos:notation "5.3" ;
    skos:altLabel "LIBRARY_STUDENT_ASSISTANT_ROLE" ;
    skos:altLabel "LibraryStudentAssistantRole" ;
    skos:altLabel "Student" ;
    skos:altLabel "LibraryAssistanceActivity" ;
    skos:definition "{LibraryStudentAssistantRole} is a role that is borne by exactly one {Student}, and that is realized in some {LibraryAssistanceActivity} For an entity to count as {LibraryStudentAssistantRole}, it must bear the is borne by relation to exactly one {Student}, and the is realized in relation to at least one {LibraryAssistanceActivity}. Every {LibraryStudentAssistantRole} stands in the is borne by relation to exactly one {Student}, and the is realized in relation to at least one {LibraryAssistanceActivity}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT_CONDIMENT_STATION> a skos:Concept ;
    skos:prefLabel "Condiment Station" ;
    skos:notation "2.1" ;
    skos:altLabel "CONDIMENT_STATION" ;
    skos:altLabel "CondimentStation" ;
    skos:altLabel "AvailableTopping" ;
    skos:altLabel "StationLocation" ;
    skos:definition "A CondimentStation is a material entity that offers at least one AvailableTopping and is located at at least one StationLocation. A CondimentStation is a material entity that provides at least one AvailableTopping and occupies at least one StationLocation. Each CondimentStation, as a material entity, supplies at least one AvailableTopping and is situated at a minimum of one StationLocation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_INDIGENOUS_CHILD_ROLE> a skos:Concept ;
    skos:prefLabel "Indigenous Child Role" ;
    skos:notation "5.4" ;
    skos:altLabel "INDIGENOUS_CHILD_ROLE" ;
    skos:altLabel "IndigenousChildRole" ;
    skos:altLabel "IndependentContinuant" ;
    skos:altLabel "RightsExerciseProcess" ;
    skos:definition "{IndigenousChildRole} is a role that is borne by exactly one {IndependentContinuant}, and that is realized in some {RightsExerciseProcess} As a role, {IndigenousChildRole} is characterised by the is borne by relation to exactly one {IndependentContinuant}, and the is realized in relation to at least one {RightsExerciseProcess}. Every {IndigenousChildRole} stands in the is borne by relation to exactly one {IndependentContinuant}, and the is realized in relation to at least one {RightsExerciseProcess}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_POLICE_OFFICER_ROLE> a skos:Concept ;
    skos:prefLabel "Police Officer Role" ;
    skos:notation "5.5" ;
    skos:altLabel "POLICE_OFFICER_ROLE" ;
    skos:altLabel "PoliceOfficerRole" ;
    skos:altLabel "LawEnforcementAgency" ;
    skos:altLabel "PolicePatrolProcess" ;
    skos:definition "{PoliceOfficerRole} is a role that is borne by exactly one {LawEnforcementAgency}, and that is realized in some {PolicePatrolProcess} Each {PoliceOfficerRole} is defined as a role which is borne by exactly one {LawEnforcementAgency}, and which is realized in some {PolicePatrolProcess}. Every {PoliceOfficerRole} stands in the is borne by relation to exactly one {LawEnforcementAgency}, and the is realized in relation to at least one {PolicePatrolProcess}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_RESPONSIVE_WEBSITE_DEVELOPMENT> a skos:Concept ;
    skos:prefLabel "Responsive Website Development" ;
    skos:notation "1.4" ;
    skos:altLabel "RESPONSIVE_WEBSITE_DEVELOPMENT" ;
    skos:altLabel "ResponsiveWebsiteDevelopment" ;
    skos:altLabel "WebPlatform" ;
    skos:altLabel "ResponsiveDesignTechnique" ;
    skos:definition "A ResponsiveWebsiteDevelopment process necessarily targets at least one WebPlatform and employs at least one ResponsiveDesignTechnique. To qualify as a ResponsiveWebsiteDevelopment process, an initiative must target some WebPlatform while also employing some ResponsiveDesignTechnique. Any process that targets some WebPlatform and employs some ResponsiveDesignTechnique constitutes a ResponsiveWebsiteDevelopment." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_CAMPAIGN_COORDINATION> a skos:Concept ;
    skos:prefLabel "Campaign Coordination" ;
    skos:notation "3.0.1" ;
    skos:altLabel "CAMPAIGN_COORDINATION" ;
    skos:altLabel "CampaignCoordination" ;
    skos:altLabel "OnlineChannel" ;
    skos:altLabel "OfflineChannel" ;
    skos:definition "A CampaignCoordination is an information content entity that coordinates some OnlineChannel, coordinates some OfflineChannel, and hasEngagementMetric some decimal. The coordination of some OnlineChannel and the coordination of some OfflineChannel, together with the assignment of hasEngagementMetric some decimal, characterize a CampaignCoordination as an information content entity. An information content entity qualifies as a CampaignCoordination only when it coordinates some OnlineChannel, coordinates some OfflineChannel, and hasEngagementMetric some decimal." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_BENEFIT_OPTION_ELECTION> a skos:Concept ;
    skos:prefLabel "Benefit Option Election" ;
    skos:notation "1.5" ;
    skos:altLabel "BENEFIT_OPTION_ELECTION" ;
    skos:altLabel "BenefitOptionElection" ;
    skos:altLabel "RetirementBenefitOption" ;
    skos:altLabel "Member" ;
    skos:definition "A BenefitOptionElection is defined as a process that elects a RetirementBenefitOption and possesses a Member. The election of a RetirementBenefitOption and the association of a Member characterize a process called a BenefitOptionElection. A process elects a RetirementBenefitOption and has a Member when it operates as a BenefitOptionElection." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE_RETIREMENT_BENEFIT_OPTION> a skos:Concept ;
    skos:prefLabel "Retirement Benefit Option" ;
    skos:notation "3.1.1" ;
    skos:altLabel "RETIREMENT_BENEFIT_OPTION" ;
    skos:altLabel "RetirementBenefitOption" ;
    skos:definition "A RetirementBenefitOption is a descriptive information entity that specifies a survivor percentage and specifies guarantee months. (This is too identical to the original. I need to change syntax.) A RetirementBenefitOption constitutes a descriptive information entity that specifies a survivor percentage and specifies guarantee months. A survivor percentage and guarantee months are specified by a RetirementBenefitOption, which is a descriptive information entity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_MARITAL_STATUS_CERTIFICATION> a skos:Concept ;
    skos:prefLabel "Marital Status Certification" ;
    skos:notation "3.0.2" ;
    skos:altLabel "MARITAL_STATUS_CERTIFICATION" ;
    skos:altLabel "MaritalStatusCertification" ;
    skos:altLabel "MaritalState" ;
    skos:altLabel "SpousalConsentReason" ;
    skos:definition "A MaritalStatusCertification is defined as an information content entity that certifies a MaritalState and specifies a SpousalConsentReason. Certifying a MaritalState and specifying a SpousalConsentReason are the defining relations of a MaritalStatusCertification, which is an information content entity. An information content entity qualifies as a MaritalStatusCertification when it certifies a MaritalState and specifies a SpousalConsentReason." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_BENEFICIARY_DESIGNATION> a skos:Concept ;
    skos:prefLabel "Beneficiary Designation" ;
    skos:notation "5.6" ;
    skos:altLabel "BENEFICIARY_DESIGNATION" ;
    skos:altLabel "BeneficiaryDesignation" ;
    skos:definition "A BeneficiaryDesignation constitutes a directive information content entity that designates a DesignatedBeneficiary and governs a RetirementBenefitOption. A directive information content entity operates as a BeneficiaryDesignation when it designates a DesignatedBeneficiary and governs a RetirementBenefitOption. The designation of a DesignatedBeneficiary and the governance of a RetirementBenefitOption are both carried out by a directive information content entity classified as a BeneficiaryDesignation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CLINICAL_QUALITY_IMPROVEMENT_PROGRAM> a skos:Concept ;
    skos:prefLabel "Clinical Quality Improvement Program" ;
    skos:notation "1.6" ;
    skos:altLabel "CLINICAL_QUALITY_IMPROVEMENT_PROGRAM" ;
    skos:altLabel "ClinicalQualityImprovementProgram" ;
    skos:altLabel "QuantitativeAnalyticTool" ;
    skos:altLabel "ClinicalPerformanceData" ;
    skos:definition "A ClinicalQualityImprovementProgram is defined as a Process that employs some QuantitativeAnalyticTool and assesses some ClinicalPerformanceData. The application of some QuantitativeAnalyticTool and the evaluation of some ClinicalPerformanceData are intrinsic to a Process identified as a ClinicalQualityImprovementProgram. As a Process, a ClinicalQualityImprovementProgram executes by applying some QuantitativeAnalyticTool and by examining some ClinicalPerformanceData." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_LAW_AND_SOCIETY_TRACK_REQUIREMENT> a skos:Concept ;
    skos:prefLabel "Law And Society Track Requirement" ;
    skos:notation "1.7" ;
    skos:altLabel "LAW_AND_SOCIETY_TRACK_REQUIREMENT" ;
    skos:altLabel "LawAndSocietyTrackRequirement" ;
    skos:altLabel "StudentRole" ;
    skos:definition "The filler associated with specifiesCourseSelection is now a process (bfo:0000015), having replaced CourseSelectionSet, which satisfies the property domain constraints and eliminates the conflict with continuant/occurrent disjointness. Replacing the CourseSelectionSet filler in specifiesCourseSelection with a process (bfo:0000015) fulfills the property domain constraints and resolves the continuant/occurrent disjointness. To satisfy the property domain constraints and address the continuant/occurrent disjointness, the specifiesCourseSelection filler must be a process (bfo:0000015) rather than a CourseSelectionSet." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_SENIOR_ANIMAL_SERVICES_OFFICER_ROLE> a skos:Concept ;
    skos:prefLabel "Senior Animal Services Officer Role" ;
    skos:notation "5.7" ;
    skos:altLabel "SENIOR_ANIMAL_SERVICES_OFFICER_ROLE" ;
    skos:altLabel "SeniorAnimalServicesOfficerRole" ;
    skos:altLabel "SeniorAnimalServicesOfficer" ;
    skos:altLabel "AnimalControlActivity" ;
    skos:definition "A SeniorAnimalServicesOfficerRole is a Role that exactly realizes a function in an AnimalServicesOrganization and realizes some AnimalControlActivity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_VECTOR_CONTROL_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Vector Control Activity" ;
    skos:notation "1.8" ;
    skos:altLabel "VECTOR_CONTROL_ACTIVITY" ;
    skos:altLabel "VectorControlActivity" ;
    skos:altLabel "VectorControlProgram" ;
    skos:altLabel "ResidentialStreet" ;
    skos:definition "Every VectorControlActivity qualifies as an Occurrent, and it implements at least one VectorControlProgram while targeting at least one ResidentialStreet. To constitute a VectorControlActivity, an Occurrent must implement a VectorControlProgram and direct its aim toward a ResidentialStreet. Each VectorControlActivity instantiates an Occurrent, establishes an implementation link to a VectorControlProgram, and directs a targeting relation toward a ResidentialStreet." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_SPECIFICATION_TESTING_EVENT> a skos:Concept ;
    skos:prefLabel "Specification Testing Event" ;
    skos:notation "1.9" ;
    skos:altLabel "SPECIFICATION_TESTING_EVENT" ;
    skos:altLabel "SpecificationTestingEvent" ;
    skos:altLabel "TestingProtocol" ;
    skos:altLabel "TargetMaterial" ;
    skos:definition "Every SpecificationTestingEvent qualifies as an Occurrent that carries out a TestingProtocol and directs its action toward a Material. When a SpecificationTestingEvent occurs, it performs a TestingProtocol and aims at a Material as an Occurrent. A SpecificationTestingEvent must function as an Occurrent that carries out a TestingProtocol and points to a Material." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_MATHEMATICAL_LEARNING_PROCESS> a skos:Concept ;
    skos:prefLabel "Mathematical Learning Process" ;
    skos:notation "1.10" ;
    skos:altLabel "MATHEMATICAL_LEARNING_PROCESS" ;
    skos:altLabel "MathematicalLearningProcess" ;
    skos:altLabel "MathematicalConcept" ;
    skos:altLabel "StudentRole" ;
    skos:definition "A MathematicalLearningProcess is defined as an occurrent that includes a mathematical concept and directs its aim toward a student role. Any occurrent that involves a mathematical concept and targets a student role constitutes a MathematicalLearningProcess. Every MathematicalLearningProcess, as an occurrent, stands in an involvement relation to a mathematical concept and in a targeting relation to a student role." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_DATA_CONTROLLER_ROLE> a skos:Concept ;
    skos:prefLabel "Data Controller Role" ;
    skos:notation "5.8" ;
    skos:altLabel "DATA_CONTROLLER_ROLE" ;
    skos:altLabel "DataControllerRole" ;
    skos:altLabel "LegalEntityOrPerson" ;
    skos:altLabel "DataDeterminationActivity" ;
    skos:definition "The DataControllerRole constitutes an agent_role exclusively instantiated by a single LegalEntityOrPerson and fulfilling the DataDeterminationFunction that specifies purposes and means for personal data processing. Exactly one LegalEntityOrPerson bears a DataControllerRole, an agent_role that realizes the DataDeterminationFunction responsible for determining purposes and means regarding personal data processing. A DataControllerRole operates as an agent_role carried by precisely one LegalEntityOrPerson, thereby actualizing the DataDeterminationFunction of determining purposes and means for personal data processing." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_PERSONAL_DATA_PROCESSING_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Personal Data Processing Activity" ;
    skos:notation "1.11" ;
    skos:altLabel "PERSONAL_DATA_PROCESSING_ACTIVITY" ;
    skos:altLabel "PersonalDataProcessingActivity" ;
    skos:altLabel "AutomatedSystem" ;
    skos:altLabel "PersonalDataRecord" ;
    skos:definition "A PersonalDataProcessingActivity is a process that executes a DataProcessingOperation via an AutomatedSystem and targets a PersonalDataRecord." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_STRAP_FIXING_PROCESS> a skos:Concept ;
    skos:prefLabel "Strap Fixing Process" ;
    skos:notation "1.12" ;
    skos:altLabel "STRAP_FIXING_PROCESS" ;
    skos:altLabel "StrapFixingProcess" ;
    skos:altLabel "LateralRestraintStrap" ;
    skos:altLabel "BuildingFloorStructure" ;
    skos:definition "A StrapFixingProcess belongs to the class of BFO processes, defined by its requirement to attach a LateralRestraintStrap and secure that strap to a BuildingFloorStructure. The execution of a StrapFixingProcess consists of two actions within a BFO process framework: attaching a LateralRestraintStrap and securing it to a BuildingFloorStructure. When a StrapFixingProcess occurs as a BFO process, it relates a LateralRestraintStrap to a BuildingFloorStructure through the acts of attachment and subsequent securing." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_INVESTOR_RELATIONS_DIRECTOR_ROLE> a skos:Concept ;
    skos:prefLabel "Investor Relations Director Role" ;
    skos:notation "5.9" ;
    skos:altLabel "INVESTOR_RELATIONS_DIRECTOR_ROLE" ;
    skos:altLabel "InvestorRelationsDirectorRole" ;
    skos:altLabel "InvestorRelationsActivity" ;
    skos:definition "An InvestorRelationsDirectorRole is the role held by exactly one CorporateAgent that realizes an InvestorRelationsActivity. Exactly one CorporateAgent bears an InvestorRelationsDirectorRole, and that CorporateAgent realizes an InvestorRelationsActivity. An InvestorRelationsDirectorRole is constituted by exactly one CorporateAgent that realizes an InvestorRelationsActivity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CORPORATE_INFORMATION_DISCLOSURE_PROCESS> a skos:Concept ;
    skos:prefLabel "Corporate Information Disclosure Process" ;
    skos:notation "1.13" ;
    skos:altLabel "CORPORATE_INFORMATION_DISCLOSURE_PROCESS" ;
    skos:altLabel "CorporateInformationDisclosureProcess" ;
    skos:altLabel "RegulatoryBody" ;
    skos:altLabel "FinancialReport" ;
    skos:definition "The class CorporateInformationDisclosureProcess denotes an occurrent whose activities include communicating with a RegulatoryBody and generating a FinancialReport. Executing a CorporateInformationDisclosureProcess requires communicating with a RegulatoryBody and producing a FinancialReport. Communication with a RegulatoryBody and the production of a FinancialReport characterize an occurrent classified as a CorporateInformationDisclosureProcess." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_PERSONAL_HEALTH_RECORD> a skos:Concept ;
    skos:prefLabel "Personal Health Record" ;
    skos:notation "3.0.3" ;
    skos:altLabel "PERSONAL_HEALTH_RECORD" ;
    skos:altLabel "PersonalHealthRecord" ;
    skos:altLabel "HealthCondition" ;
    skos:altLabel "ClientProfile" ;
    skos:definition "A PersonalHealthRecord constitutes a CCO Information Content Entity that asserts a HealthCondition and occupies the subject position within a ClientProfile. A PersonalHealthRecord operates as a CCO Information Content Entity, linking to a HealthCondition via a stating relation and appearing as the subject of a ClientProfile. The PersonalHealthRecord category designates a CCO Information Content Entity that records a HealthCondition and is assigned the subject role relative to a ClientProfile." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_CHIEF_COMPLIANCE_OFFICER_ROLE> a skos:Concept ;
    skos:prefLabel "Chief Compliance Officer Role" ;
    skos:notation "5.10" ;
    skos:altLabel "CHIEF_COMPLIANCE_OFFICER_ROLE" ;
    skos:altLabel "ChiefComplianceOfficerRole" ;
    skos:altLabel "Person" ;
    skos:altLabel "ChiefComplianceOfficerServiceDeliveryProcess" ;
    skos:definition "{ChiefComplianceOfficerRole} is a role that is borne by exactly one {Person}, and that is realized in some {ChiefComplianceOfficerServiceDeliveryProcess} As a role, {ChiefComplianceOfficerRole} is characterised by the is borne by relation to exactly one {Person}, and the is realized in relation to at least one {ChiefComplianceOfficerServiceDeliveryProcess}. Every {ChiefComplianceOfficerRole} stands in the is borne by relation to exactly one {Person}, and the is realized in relation to at least one {ChiefComplianceOfficerServiceDeliveryProcess}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_PROTECTED_DISCLOSURE_PROCESS> a skos:Concept ;
    skos:prefLabel "Protected Disclosure Process" ;
    skos:notation "1.14" ;
    skos:altLabel "PROTECTED_DISCLOSURE_PROCESS" ;
    skos:altLabel "ProtectedDisclosureProcess" ;
    skos:altLabel "ReportingChannel" ;
    skos:altLabel "CollegeOfficial" ;
    skos:definition "A ProtectedDisclosureProcess is defined as a Process that bears a directedTo relationship to some ReportingChannel and a reportedBy relationship to some CollegeOfficial. Every ReportingChannel that is the target of a directedTo relationship from a Process, and every CollegeOfficial who is the agent of a reportedBy relationship to that Process, together constitute a ProtectedDisclosureProcess only insofar as that Process satisfies both relations. To instantiate a ProtectedDisclosureProcess, one must identify a Process that is directedTo some ReportingChannel and reportedBy some CollegeOfficial." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_IMPROPER_CONDUCT_EVENT> a skos:Concept ;
    skos:prefLabel "Improper Conduct Event" ;
    skos:notation "1.15" ;
    skos:altLabel "IMPROPER_CONDUCT_EVENT" ;
    skos:altLabel "ImproperConductEvent" ;
    skos:altLabel "CollegeResource" ;
    skos:altLabel "CollegeCommunityMember" ;
    skos:definition "An ImproperConductEvent is a Process that misuses some CollegeResource and performedBy some CollegeCommunityMember." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_COLLEGE_OFFICIAL_ROLE> a skos:Concept ;
    skos:prefLabel "College Official Role" ;
    skos:notation "5.11" ;
    skos:altLabel "COLLEGE_OFFICIAL_ROLE" ;
    skos:altLabel "CollegeOfficialRole" ;
    skos:altLabel "Person" ;
    skos:altLabel "CollegeAdministrationProcess" ;
    skos:definition "{CollegeOfficialRole} is a role that inheres in exactly one {Person}, and that is realized in some {CollegeAdministrationProcess} As a role, {CollegeOfficialRole} is characterised by the inheres in relation to exactly one {Person}, and the is realized in relation to at least one {CollegeAdministrationProcess}. Every {CollegeOfficialRole} stands in the inheres in relation to exactly one {Person}, and the is realized in relation to at least one {CollegeAdministrationProcess}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_COMPLIANCE_COORDINATOR_ROLE> a skos:Concept ;
    skos:prefLabel "Compliance Coordinator Role" ;
    skos:notation "5.12" ;
    skos:altLabel "COMPLIANCE_COORDINATOR_ROLE" ;
    skos:altLabel "ComplianceCoordinatorRole" ;
    skos:altLabel "AcademicRecord" ;
    skos:altLabel "EligibilityComplianceCheck" ;
    skos:definition "The ComplianceCoordinatorRole denotes a role defined by the exact certification of AcademicStanding for an AcademicRecord and the monitoring of EligibilityStatus throughout an EligibilityComplianceCheck. When assuming a ComplianceCoordinatorRole, one exactly certifiesAcademicStanding for an AcademicRecord and monitorsEligibilityStatus during an EligibilityComplianceCheck. The role that exactly certifiesAcademicStanding for an AcademicRecord and monitorsEligibilityStatus during an EligibilityComplianceCheck is a ComplianceCoordinatorRole." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CREDIT_HOUR_CERTIFICATION_PROCESS> a skos:Concept ;
    skos:prefLabel "Credit Hour Certification Process" ;
    skos:notation "1.16" ;
    skos:altLabel "CREDIT_HOUR_CERTIFICATION_PROCESS" ;
    skos:altLabel "CreditHourCertificationProcess" ;
    skos:altLabel "AcademicTerm" ;
    skos:definition "An occurrent classified as a CreditHourCertificationProcess must participate in an AcademicTerm. When a CreditHourCertificationProcess occurs, it takes part in an AcademicTerm as an occurrent. Participation in an AcademicTerm is a required relation for any occurrent that qualifies as a CreditHourCertificationProcess." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_ATHLETIC_ATTENDANT_ROLE> a skos:Concept ;
    skos:prefLabel "Athletic Attendant Role" ;
    skos:notation "5.13" ;
    skos:altLabel "ATHLETIC_ATTENDANT_ROLE" ;
    skos:altLabel "AthleticAttendantRole" ;
    skos:altLabel "Person" ;
    skos:altLabel "AthleticMonitoringActivity" ;
    skos:definition "{AthleticAttendantRole} is a role that has role bearer exactly one {Person}, and that is realized in some {AthleticMonitoringActivity} For an entity to count as {AthleticAttendantRole}, it must bear the has role bearer relation to exactly one {Person}, and the is realized in relation to at least one {AthleticMonitoringActivity}. Each {AthleticAttendantRole} is defined as a role which has role bearer exactly one {Person}, and which is realized in some {AthleticMonitoringActivity}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_CONFERENCE_PROGRAMME> a skos:Concept ;
    skos:prefLabel "Conference Programme" ;
    skos:notation "3.0.4" ;
    skos:altLabel "CONFERENCE_PROGRAMME" ;
    skos:altLabel "ConferenceProgramme" ;
    skos:altLabel "AcademicPresentation" ;
    skos:definition "A conference programme qualifies as an information content entity precisely when it contains_presentation at least one academic presentation. The contains_presentation relation links a conference programme to an academic presentation, establishing the former as an information content entity. In the ontology, a conference programme must be modeled as an information content entity that carries a contains_presentation link to an academic presentation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_SCIENTIFIC_ORGANIZATION> a skos:Concept ;
    skos:prefLabel "Scientific Organization" ;
    skos:notation "2.2.1" ;
    skos:altLabel "SCIENTIFIC_ORGANIZATION" ;
    skos:altLabel "ScientificOrganization" ;
    skos:altLabel "AcademicJournal" ;
    skos:altLabel "ScientificMeeting" ;
    skos:definition "An artifact qualifies as a scientific organization if and only if it publishes_journal an academic journal and organizes_meetings a scientific meeting. The relation publishes_journal connects a scientific organization to an academic journal, while the relation organizes_meetings connects the same organization to a scientific meeting, identifying the entity as an artifact. To operate as a scientific organization, an artifact must execute the action publishes_journal upon an academic journal and execute the action organizes_meetings upon a scientific meeting." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DONOR_PROFILE> a skos:Concept ;
    skos:prefLabel "Donor Profile" ;
    skos:notation "3.0.5" ;
    skos:altLabel "DONOR_PROFILE" ;
    skos:altLabel "DonorProfile" ;
    skos:altLabel "ContactInformation" ;
    skos:definition "A DonorProfile is an InformationContentEntity that has some ContactInformation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DONATION_TRANSACTION_RECORD> a skos:Concept ;
    skos:prefLabel "Donation Transaction Record" ;
    skos:notation "3.0.6" ;
    skos:altLabel "DONATION_TRANSACTION_RECORD" ;
    skos:altLabel "DonationTransactionRecord" ;
    skos:altLabel "Donor" ;
    skos:altLabel "GiftAllocationPurpose" ;
    skos:definition "(Definitional) A DonationTransactionRecord is classified as an InformationContentEntity that involves a Donor, allocates to a GiftAllocationPurpose, and carries a monetary value. (Relational-fronted) The involvement of a Donor, the allocation to a GiftAllocationPurpose, and the holding of a monetary value define an InformationContentEntity recognized as a DonationTransaction" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_MEMBERSHIP_TRANSFER_PROCESS> a skos:Concept ;
    skos:prefLabel "Membership Transfer Process" ;
    skos:notation "1.17" ;
    skos:altLabel "MEMBERSHIP_TRANSFER_PROCESS" ;
    skos:altLabel "MembershipTransferProcess" ;
    skos:altLabel "Membership" ;
    skos:altLabel "Individual" ;
    skos:definition "MembershipTransferProcess denotes a BFO process defined by its involvement with a Membership and its targeting of an Individual. A Membership and an Individual are respectively involved and targeted by a MembershipTransferProcess, which is a BFO process. As a BFO process, MembershipTransferProcess is specified to involve a Membership and to target an Individual." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_RETAINING_EMPLOYEE_ROLE> a skos:Concept ;
    skos:prefLabel "Retaining Employee Role" ;
    skos:notation "5.14" ;
    skos:altLabel "RETAINING_EMPLOYEE_ROLE" ;
    skos:altLabel "RetainingEmployeeRole" ;
    skos:altLabel "DepartingEmployee" ;
    skos:altLabel "TransferAuthorization" ;
    skos:definition "{RetainingEmployeeRole} is a role that inheres in exactly one {DepartingEmployee}, and that grants transfer permission some {TransferAuthorization} As a role, {RetainingEmployeeRole} is characterised by the inheres in relation to exactly one {DepartingEmployee}, and the grants transfer permission relation to at least one {TransferAuthorization}. Every {RetainingEmployeeRole} stands in the inheres in relation to exactly one {DepartingEmployee}, and the grants transfer permission relation to at least one {TransferAuthorization}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_MEMBERSHIP_TRANSFER_REQUEST> a skos:Concept ;
    skos:prefLabel "Membership Transfer Request" ;
    skos:notation "3.0.7" ;
    skos:altLabel "MEMBERSHIP_TRANSFER_REQUEST" ;
    skos:altLabel "MembershipTransferRequest" ;
    skos:altLabel "SocialServicesDepartment" ;
    skos:definition "A MembershipTransferRequest functions as an InformationContentEntity that is submitted by a SocialServicesDepartment. A SocialServicesDepartment submits a MembershipTransferRequest, which constitutes an InformationContentEntity. When a MembershipTransferRequest is submitted by a SocialServicesDepartment, it is classified as an InformationContentEntity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE_EDUCATION_HEALTH_CARE_PLAN> a skos:Concept ;
    skos:prefLabel "Education Health Care Plan" ;
    skos:notation "3.2.1" ;
    skos:altLabel "EDUCATION_HEALTH_CARE_PLAN" ;
    skos:altLabel "EducationHealthCarePlan" ;
    skos:altLabel "Student" ;
    skos:altLabel "SpecialEducationalNeeds" ;
    skos:definition "An EducationHealthCarePlan is an InformationContentEntity that describes some StudentProfile and specifies some InterventionRequirements for SpecialEducationalNeeds." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_EDUCATIONAL_PLACEMENT_PROCESS> a skos:Concept ;
    skos:prefLabel "Educational Placement Process" ;
    skos:notation "1.18" ;
    skos:altLabel "EDUCATIONAL_PLACEMENT_PROCESS" ;
    skos:altLabel "EducationalPlacementProcess" ;
    skos:altLabel "Student" ;
    skos:altLabel "Curriculum" ;
    skos:definition "An EducationalPlacementProcess constitutes an Occurrent that affects a Student and produces a Curriculum. A Student is affected and a Curriculum is produced by an EducationalPlacementProcess, which is an Occurrent. An EducationalPlacementProcess functions as an Occurrent by affecting a Student and producing a Curriculum." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_PROVIDER_CHANGE_REQUEST_PROCESS> a skos:Concept ;
    skos:prefLabel "Provider Change Request Process" ;
    skos:notation "1.19" ;
    skos:altLabel "PROVIDER_CHANGE_REQUEST_PROCESS" ;
    skos:altLabel "ProviderChangeRequestProcess" ;
    skos:altLabel "RequestingClient" ;
    skos:altLabel "RequestedProviderType" ;
    skos:definition "A ProviderChangeRequestProcess belongs to the Process category and simultaneously holds a RequestingClient while designating a RequestedProviderType. For any entity classified as a ProviderChangeRequestProcess, it is necessarily a Process that contains a RequestingClient and points to a RequestedProviderType. A ProviderChangeRequestProcess belongs to the Process class and necessarily includes a RequestingClient alongside a RequestedProviderType that it targets." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_OZONE_THERAPY_SESSION> a skos:Concept ;
    skos:prefLabel "Ozone Therapy Session" ;
    skos:notation "1.20" ;
    skos:altLabel "OZONE_THERAPY_SESSION" ;
    skos:altLabel "OzoneTherapySession" ;
    skos:altLabel "OzoneOxygenMixture" ;
    skos:altLabel "AutohemotherapyProcedure" ;
    skos:definition "The OzoneTherapySession is defined as a process that administers an OzoneOxygenMixture and utilizes an AutohemotherapyProcedure. During an OzoneTherapySession, the process administers an OzoneOxygenMixture and utilizes an AutohemotherapyProcedure. The administration of an OzoneOxygenMixture and the utilization of an AutohemotherapyProcedure together constitute an OzoneTherapySession as a process." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE_CLOUD_STORAGE_ALLOCATION> a skos:Concept ;
    skos:prefLabel "Storage Allocation" ;
    skos:notation "3.1.2" ;
    skos:altLabel "CLOUD_STORAGE_ALLOCATION" ;
    skos:altLabel "StorageAllocation" ;
    skos:altLabel "Student" ;
    skos:altLabel "CloudStorageVolume" ;
    skos:definition "A StorageAllocation is a descriptive information content entity that allocates to exactly one Student and provides exactly one CloudStorageVolume." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_MEASUREMENT_CAPABILITY> a skos:Concept ;
    skos:prefLabel "Measurement Capability" ;
    skos:notation "3.0.8" ;
    skos:altLabel "MEASUREMENT_CAPABILITY" ;
    skos:altLabel "MeasurementCapability" ;
    skos:altLabel "MeasurementParameter" ;
    skos:altLabel "MeasurementRange" ;
    skos:definition "Every MeasurementCapability qualifies as an InformationContentEntity by possessing a MeasurementParameter, a MeasurementRange, and a decimal ExpandedUncertainty. The presence of a MeasurementParameter, a MeasurementRange, and a decimal ExpandedUncertainty characterizes a MeasurementCapability as an InformationContentEntity. The composition of a MeasurementCapability requires an InformationContentEntity base supplemented by a MeasurementParameter, a MeasurementRange, and a decimal ExpandedUncertainty." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CYBERSECURITY_INCIDENT> a skos:Concept ;
    skos:prefLabel "Cybersecurity Incident" ;
    skos:notation "1.21" ;
    skos:altLabel "CYBERSECURITY_INCIDENT" ;
    skos:altLabel "CybersecurityIncident" ;
    skos:altLabel "HealthcareNetworkInfrastructure" ;
    skos:altLabel "OperationalDisruption" ;
    skos:definition "A CybersecurityIncident is a Process that targets a HealthcareNetworkInfrastructure and produces an OperationalDisruption." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DEVICE_INVENTORY_RECORD> a skos:Concept ;
    skos:prefLabel "Device Inventory Record" ;
    skos:notation "3.0.9" ;
    skos:altLabel "DEVICE_INVENTORY_RECORD" ;
    skos:altLabel "DeviceInventoryRecord" ;
    skos:altLabel "MedicalDevice" ;
    skos:definition "A DeviceInventoryRecord constitutes an InformationContentEntity that enumerates a MedicalDevice. The enumeration of a MedicalDevice characterizes a DeviceInventoryRecord, which is classified as an InformationContentEntity. A DeviceInventoryRecord shall be treated as an InformationContentEntity that enumerates a MedicalDevice." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_COMMUNITY_LEARNING_DISABILITY_NURSE> a skos:Concept ;
    skos:prefLabel "Community Learning Disability Nurse" ;
    skos:notation "5.15" ;
    skos:altLabel "COMMUNITY_LEARNING_DISABILITY_NURSE" ;
    skos:altLabel "CommunityLearningDisabilityNurse" ;
    skos:altLabel "HealthcareAgent" ;
    skos:altLabel "CommunityHealthcareServiceDeliveryProcess" ;
    skos:definition "{CommunityLearningDisabilityNurse} is a role that is borne by exactly one {HealthcareAgent}, and that is realized in some {CommunityHealthcareServiceDeliveryProcess} As a role, {CommunityLearningDisabilityNurse} is characterised by the is borne by relation to exactly one {HealthcareAgent}, and the is realized in relation to at least one {CommunityHealthcareServiceDeliveryProcess}. Every {CommunityLearningDisabilityNurse} stands in the is borne by relation to exactly one {HealthcareAgent}, and the is realized in relation to at least one {CommunityHealthcareServiceDeliveryProcess}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_ROLE_PERCEPTION> a skos:Concept ;
    skos:prefLabel "Role Perception" ;
    skos:notation "3.0.10" ;
    skos:altLabel "ROLE_PERCEPTION" ;
    skos:altLabel "RolePerception" ;
    skos:altLabel "RoleConcept" ;
    skos:definition "RolePerception is defined as an information content entity that cognitivelyRepresents a RoleConcept. The cognitivelyRepresents relation links RolePerception, which is an information content entity, to a RoleConcept. RolePerception is to be treated as an information content entity that cognitivelyRepresents a RoleConcept." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
