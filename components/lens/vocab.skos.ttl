    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_INCUBATION_PROGRAM> a skos:Concept ;
    skos:prefLabel "Incubation Program" ;
