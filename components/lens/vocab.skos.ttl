    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE_FILLER_SERVICEPERFORMANCEMETRIC> a skos:Concept ;
    skos:prefLabel "Filler Serviceperformancemetric" ;
