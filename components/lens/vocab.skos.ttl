    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_ACADEMIC_CURRICULUM_PROGRAM> a skos:Concept ;
    skos:prefLabel "Academic Curriculum Program" ;
    skos:notation "1.42" ;
    skos:altLabel "ACADEMIC_CURRICULUM_PROGRAM" ;
    skos:altLabel "AcademicCurriculumProgram" ;
    skos:altLabel "InterdisciplinaryEducation" ;
    skos:altLabel "StudentTalentCultivation" ;
    skos:definition "An academic curriculum program constitutes a process defined by its delivery of some interdisciplinary education and its targeting of some student talent cultivation. The process known as an academic curriculum program operates by delivering some interdisciplinary education while simultaneously targeting some student talent cultivation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_RETAIL_LEADERSHIP_TEAM_MEMBER> a skos:Concept ;
