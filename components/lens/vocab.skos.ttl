    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_FILLER_INFORMATIONCAPABILITY> a skos:Concept ;
    skos:prefLabel "Filler Informationcapability" ;
    skos:notation "0.13" ;
    skos:altLabel "FILLER_INFORMATIONCAPABILITY" ;
    skos:altLabel "information capability" ;
