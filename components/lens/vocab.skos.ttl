<https://signals.zndx.org/sdg#SDG_QUALITY_MARKET_DEMAND> a skos:Concept ;
    skos:prefLabel "Market Demand" ;
    skos:notation "4.1" ;
    skos:altLabel "MARKET_DEMAND" ;
    skos:altLabel "Market Demand" ;
    skos:altLabel "Consumer Demand Metric" ;
    skos:altLabel "Stock Demand Value" ;
    skos:altLabel "Commodity Demand Indicator" ;
    skos:altLabel "Market Desire Measure" ;
    skos:definition "A financial value that quantifies the desire of consumers for a specific stock or commodity. This concept captures the measurable level of interest or willingness to purchase a financial asset or commodity, often reflected in trading volumes, order book depth, or market sentiment indicators. A financial value is defined as a metric that quantifies consumer desire for a particular stock or commodity. Consumer desire for a specific stock or commodity is quantified by a financial value. Applies to financial markets where the desire for a specific stock or commodity is quantified." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_MARKET_TREND> a skos:Concept ;
    skos:prefLabel "Market Trend" ;
    skos:notation "4.2" ;
    skos:altLabel "MARKET_TREND" ;
