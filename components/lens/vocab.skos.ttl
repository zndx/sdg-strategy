    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_FACULTY_MEMBER_ROLE> a skos:Concept ;
    skos:prefLabel "Academic Role" ;
    skos:notation "5.40" ;
