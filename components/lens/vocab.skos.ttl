<https://signals.zndx.org/sdg#SDG_PROCESS_GRADUATION_ELIGIBILITY_ASSESSMENT> a skos:Concept ;
    skos:prefLabel "Graduation Eligibility Assessment" ;
    skos:notation "1.80" ;
    skos:altLabel "GRADUATION_ELIGIBILITY_ASSESSMENT" ;
    skos:altLabel "GraduationEligibilityAssessment" ;
    skos:altLabel "ProgramOfStudy" ;
    skos:altLabel "StudentAgent" ;
    skos:definition "A GraduationEligibilityAssessment is a process that involves at least one ProgramOfStudy through the assessesProgram relation and at least one StudentAgent through the evaluatesStudent relation. When a process functions as a GraduationEligibilityAssessment, it performs an assessment of ProgramOfStudy via assessesProgram and an evaluation of StudentAgent via evaluatesStudent. Any process identified as a GraduationEligibilityAssessment must satisfy the condition that assessesProgram links it to a ProgramOfStudy and evaluatesStudent links it to a StudentAgent." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_RESIDENCY_REQUIREMENT> a skos:Concept ;
