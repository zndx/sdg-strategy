    skos:altLabel "Service Request Type" ;
    skos:altLabel "Requested Service Offering" ;
    skos:altLabel "Provider Request Type" ;
    skos:definition "A service type that is requested by a provider change request process. This term applies when a specific service offering is formally requested as part of a modification to an existing service arrangement, capturing the desired state of the service after the change. Tracks the specific service type requested by a provider change request process. Used to manage service modification requests." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_REQUESTINGCLIENT> a skos:Concept ;
