    skos:notation "2.3" ;
    skos:altLabel "MENU_COURSE" ;
    skos:altLabel "MenuCourse" ;
    skos:altLabel "Dish" ;
    skos:definition "Each MenuCourse constitutes a material entity containing a Dish as a part. A Dish serves as a part of any material entity identified as a MenuCourse. When constructing a MenuCourse, one assembles a Dish as a constituent part within a material entity framework." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_SERVICE_STAFF_ROLE> a skos:Concept ;
