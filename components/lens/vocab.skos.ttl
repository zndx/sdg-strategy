    skos:altLabel "SocialMediaAccountManagementProcess" ;
    skos:definition "{StaffSocialMediaAccountAdministratorRole} is a role that inheres in exactly one {StaffMember}, and that is realized in some {SocialMediaAccountManagementProcess} Every {StaffSocialMediaAccountAdministratorRole} stands in the inheres in relation to exactly one {StaffMember}, and the is realized in relation to at least one {SocialMediaAccountManagementProcess}. As a role, {StaffSocialMediaAccountAdministratorRole} is characterised by the inheres in relation to exactly one {StaffMember}, and the is realized in relation to at least one {SocialMediaAccountManagementProcess}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE_SOCIAL_NETWORKING_SERVICE_PLATFORM> a skos:Concept ;
    skos:prefLabel "Social Networking Service Platform" ;
    skos:notation "3.3.1" ;
    skos:altLabel "SOCIAL_NETWORKING_SERVICE_PLATFORM" ;
    skos:altLabel "SocialNetworkingServicePlatform" ;
    skos:altLabel "SocialNetworkingServiceType" ;
    skos:definition "A Social Networking Service Platform is classified as a descriptive information content entity whose defining characteristic is the designation of some Social Networking Service Type. A Social Networking Service Platform is a descriptive information content entity defined by its designation of some Social Networking Service Type. Some Social Networking Service Type is designated by a Social Networking Service Platform, which is a descriptive information content entity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_BACK_SHELL_DIMENSION_SPEC> a skos:Concept ;
    skos:prefLabel "Back Shell Dimension Spec" ;
    skos:notation "3.0.17" ;
    skos:altLabel "BACK_SHELL_DIMENSION_SPEC" ;
    skos:altLabel "BackShellDimensionSpec" ;
    skos:altLabel "WidthMeasurement" ;
    skos:altLabel "HeightMeasurement" ;
    skos:definition "The BackShellDimensionSpec is an information content entity defined by its specification of a WidthMeasurement and a HeightMeasurement, alongside its possession of a DepthValue. Any BackShellDimensionSpec must function as an information content entity that specifies a WidthMeasurement and a HeightMeasurement, and it must include a DepthValue. An information content entity designated as a BackShellDimensionSpec functions to specify a WidthMeasurement and a HeightMeasurement while also possessing a DepthValue." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT_MENU_COURSE> a skos:Concept ;
