    skos:notation "3.1.3" ;
    skos:altLabel "ACADEMIC_PROGRAM_REQUIREMENT" ;
    skos:altLabel "AcademicProgramRequirement" ;
    skos:definition "An AcademicProgramRequirement constitutes a descriptive information content entity that specifies a minimum credit hours value and a maximum credit hours value. Any descriptive information content entity that specifies a minimum credit hours value and a maximum credit hours value is identified as an AcademicProgramRequirement. An AcademicProgramRequirement must be a descriptive information content entity that specifies a minimum credit hours value and a maximum credit hours value." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE_SEQUENCING_COVERAGE_PARAMETER> a skos:Concept ;
