<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_INTELLIGENCEOUTPUT> a skos:Concept ;
    skos:prefLabel "Filler Intelligenceoutput" ;
    skos:notation "2.2.33" ;
