    skos:altLabel "TraditionalReligiousHealingProcess" ;
    skos:altLabel "HumanAgent" ;
    skos:definition "{TraditionalReligiousHealingProcess} is a process that has participant some {HumanAgent} For an entity to count as {TraditionalReligiousHealingProcess}, it must bear the has participant relation to at least one {HumanAgent}. Every {TraditionalReligiousHealingProcess} stands in the has participant relation to at least one {HumanAgent}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

