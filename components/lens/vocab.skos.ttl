    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE_SUBJECT_CONCEPT> a skos:Concept ;
    skos:prefLabel "Subject Concept" ;
    skos:notation "3.3.5" ;
    skos:altLabel "SUBJECT_CONCEPT" ;
    skos:altLabel "subject concept" ;
    skos:altLabel "designative concept" ;
    skos:altLabel "referent concept" ;
    skos:altLabel "entity denotation" ;
    skos:altLabel "target concept" ;
    skos:definition "This term captures the concrete referent that a designative information content entity points to, such as a specific physical object, digital record, or abstract entity. It establishes the link between the symbolic representation and the real-world or digital target it describes. Practitioners use it to define the exact object being referenced in data models or documentation. A designative information content entity is characterized by its denotation of a specific object or entity. A designative information content entity is defined as that which denotes a specific object or entity. Used when documenting the specific object, entity, or target that an information artifact, such as a label, tag, or metadata field, refers to or identifies within a system." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_TARGET_MATERIAL> a skos:Concept ;
    skos:prefLabel "Target Material" ;
    skos:notation "2.2.43" ;
    skos:altLabel "TARGET_MATERIAL" ;
    skos:altLabel "Target Substance" ;
    skos:altLabel "Material Target" ;
    skos:altLabel "Targeted Component" ;
    skos:altLabel "Specimen Material" ;
    skos:altLabel "Targeted Portion" ;
    skos:definition "Target material serves as the target of a targeting act, such as in medical treatments or industrial processes. It is the specific portion of material that receives the directed energy or action. The term applies to contexts where precise targeting is required for effective outcomes, ensuring that the action is applied to the intended substance or component. The entity is defined as a material portion that functions as the target within a targeting act. Whenever a targeting act occurs, the material portion designated as its target constitutes this entity. This material serves as the target of a targeting act, such as in medical treatments or industrial processes. It is the specific portion of material that receives the directed energy or action. The term applies to contexts where precise targeting is required for effective outcomes." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_TAXI_RIDE_PROCESS> a skos:Concept ;
