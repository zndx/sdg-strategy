    skos:altLabel "Raffle Execution Activity" ;
    skos:altLabel "Fundraising Raffle Activity" ;
    skos:altLabel "Raffle Management Activity" ;
    skos:definition "Raffle conducting activity is an organizational activity that involves conducting a raffle. This activity encompasses the planning, organization, and execution of a raffle draw, often aimed at raising funds or promoting an organization or event. Used for organizational activities that involve organizing and executing a raffle, often for fundraising or promotional purposes." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_RECEIVINGFACILITYSTAFF> a skos:Concept ;
    skos:prefLabel "Filler Receivingfacilitystaff" ;
