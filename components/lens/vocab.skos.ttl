    skos:altLabel "Pdf encoded document" ;
    skos:altLabel "Pdf document entity" ;
    skos:definition "A document content entity that utilizes the Pdf Format for its structural encoding. The entity maintains its content and layout integrity through the specific characteristics of the Portable Document Format. A document content entity is defined as an entity whose content is encoded using the Portable Document Format. The Portable Document Format serves as the encoding scheme for a document content entity. A document content entity that is encoded using the Portable Document Format." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_PERSONAL_DATA_RECORD> a skos:Concept ;
    skos:prefLabel "Personal Data Record" ;
    skos:notation "3.0.45" ;
