    skos:altLabel "Equine identity tag" ;
    skos:definition "An arbitrary identifier that uniquely designates a specific horse. This identifier serves as the primary reference for linking records and managing the lifecycle of the animal. Applies to an arbitrary identifier that uniquely designates a specific horse within a registry or tracking system." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_HOUSINGCLIENT> a skos:Concept ;
