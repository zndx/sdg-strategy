    skos:altLabel "currency value" ;
    skos:altLabel "financial sum" ;
    skos:altLabel "cash amount" ;
    skos:altLabel "denominated value" ;
    skos:definition "This term represents a quantifiable sum of money that is explicitly denominated in a specific currency unit. It captures the precise financial value and its associated monetary standard, such as dollars or euros. Practitioners use it to document transactions, balances, or valuations in financial records. Used when recording a specific sum of money tied to a particular currency unit, such as USD, EUR, or JPY." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_FILLER_MONITORINGPROTOCOL> a skos:Concept ;
