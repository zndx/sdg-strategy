    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_LECTURE_SESSION> a skos:Concept ;
    skos:prefLabel "Lecture Session" ;
    skos:notation "1.3" ;
    skos:altLabel "LECTURE_SESSION" ;
    skos:altLabel "LectureSession" ;
    skos:altLabel "LectureNotes" ;
    skos:altLabel "MathematicaExample" ;
    skos:definition "A LectureSession is an Occurrent that has_educational_resource some LectureNotes and has_computational_example some MathematicaExample." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_YOUNG_RESEARCHER_ROLE> a skos:Concept ;
    skos:prefLabel "Young Researcher Role" ;
