    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_JUVENILE_OFFENDER_PATIENT_ROLE> a skos:Concept ;
    skos:prefLabel "Juvenile Offender Patient Role" ;
    skos:notation "5.49" ;
    skos:altLabel "JUVENILE_OFFENDER_PATIENT_ROLE" ;
    skos:altLabel "JuvenileOffenderPatientRole" ;
    skos:definition "The filler for the realized_in property was updated from IndependentContinuant to process (bfo:0000015) so that it matches the property range, because roles are realized in processes rather than continuants. The realized_in property requires a process (bfo:0000015) as its filler instead of IndependentContinuant to align with its declared range, reflecting that roles are realized in processes and not in continuants. IndependentContinuant is replaced by process (bfo:0000015) as the filler for realized_in to satisfy the property range, since the relation between roles and their realizations occurs within processes rather than continuants." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE_PAYMENT_METHOD_CATEGORY> a skos:Concept ;
