    skos:altLabel "Processed Intelligence" ;
    skos:altLabel "Healthcare Data Output" ;
    skos:definition "Intelligence Output is an information processing artifact that results from healthcare analytics processes. It represents the tangible outcomes of analyzing healthcare data, such as reports, dashboards, or alerts, which provide actionable insights for stakeholders. This output is generated through the application of analytical methods to healthcare data, enabling the extraction of meaningful information to support decision-making and operational improvements. This term describes an information processing artifact generated from healthcare analytics, representing the results of analyzing healthcare data. It includes the outputs produced by processes that transform raw data into actionable insights, supporting decision-making and operational improvements." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_FILLER_INTERDISCIPLINARYEDUCATION> a skos:Concept ;
    skos:prefLabel "Filler Interdisciplinaryeducation" ;
    skos:notation "1.98" ;
    skos:altLabel "FILLER_INTERDISCIPLINARYEDUCATION" ;
