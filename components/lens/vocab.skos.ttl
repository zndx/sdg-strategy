    skos:altLabel "Building Level Structure" ;
    skos:definition "This term describes the physical horizontal division of a building that separates one level from another. It encompasses the structural components, flooring materials, and load-bearing elements that create distinct stories within a construction project. Referenced in architectural blueprints, construction contracts, and building safety codes to specify the physical layout and structural integrity of multi-story facilities." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_FILLER_CYBERSECURITYINCIDENT> a skos:Concept ;
    skos:prefLabel "Filler Cybersecurityincident" ;
    skos:notation "0.22" ;
    skos:altLabel "FILLER_CYBERSECURITYINCIDENT" ;
    skos:altLabel "Security Breach Event" ;
    skos:altLabel "Network Intrusion Alert" ;
    skos:altLabel "Malware Outbreak" ;
    skos:altLabel "Unauthorized Access Event" ;
    skos:altLabel "Data Exfiltration Incident" ;
    skos:definition "A cyber security incident is a process that participates in a computer network and involves a communication security aspect. These events manifest as unauthorized intrusions, malware propagation, or data exfiltration attempts that trigger automated security alerts and require immediate incident response protocols to isolate compromised systems and restore network integrity. Active security events occurring within computer networks that involve unauthorized access, data theft, or system compromise requiring immediate digital response." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_FILLER_DATACOLLECTIONPROCESS> a skos:Concept ;
    skos:prefLabel "Filler Datacollectionprocess" ;
    skos:notation "1.117" ;
    skos:altLabel "FILLER_DATACOLLECTIONPROCESS" ;
    skos:altLabel "Information Gathering Activity" ;
    skos:altLabel "Database Population Procedure" ;
    skos:altLabel "Monitoring Data Acquisition" ;
    skos:altLabel "Systematic Data Gathering" ;
    skos:altLabel "Observation Recording Process" ;
    skos:definition "The data collection process functions as an information processing activity that accomplishes monitoring protocols through systematic database participation. Practitioners execute this process to gather structured information through database interactions that support ongoing monitoring requirements. The workflow incorporates database systems as active participants in the data gathering procedures to ensure accurate recording and retrieval of monitored information. This term applies to information processing activities that accomplish monitoring protocols while utilizing databases as primary participants in the data gathering workflow." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_FILLER_DATAINPUT> a skos:Concept ;
    skos:prefLabel "Filler Datainput" ;
    skos:notation "1.118" ;
