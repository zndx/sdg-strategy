    skos:altLabel "Housing Agreement Client" ;
    skos:altLabel "Housing Service Client" ;
    skos:altLabel "Rental Agreement Client" ;
    skos:definition "A material entity that enters into a rental agreement for housing. This term describes individuals or organizations that participate in housing rental arrangements through formal agreements. The concept encompasses all material entities engaging in housing rental transactions, from individual residents to organizational entities participating in structured housing rental agreements. Applies to material entities that enter into rental agreements for housing purposes. Used when documenting individuals or entities participating in housing rental arrangements." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_FILLER_HOUSINGDEBTISSUE> a skos:Concept ;
