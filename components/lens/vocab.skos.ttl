    skos:notation "5.26" ;
    skos:altLabel "RETAIL_LEADERSHIP_TEAM_MEMBER" ;
    skos:altLabel "RetailLeadershipTeamMember" ;
    skos:altLabel "CorporateEmployee" ;
    skos:definition "The corporate employee realizes a process, and the role is realized within that corporate employee. A role is instantiated in a corporate employee, and that corporate employee realizes a process. When a role is realized in a corporate employee, that corporate employee realizes a process." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_TEAM_ASSESSMENT_EVENT> a skos:Concept ;
    skos:prefLabel "Team Assessment Event" ;
    skos:notation "1.43" ;
    skos:altLabel "TEAM_ASSESSMENT_EVENT" ;
    skos:altLabel "TeamAssessmentEvent" ;
    skos:altLabel "AssessmentParticipant" ;
    skos:altLabel "EvaluationOutcome" ;
    skos:altLabel "TeamEvaluation" ;
    skos:definition "A TeamAssessmentEvent constitutes a process involving at least one AssessmentParticipant and yielding at least one EvaluationOutcome. When a TeamAssessmentEvent occurs, it operates as a process that incorporates an AssessmentParticipant and generates an EvaluationOutcome. An AssessmentParticipant participates in a TeamAssessmentEvent process, which in turn yields an EvaluationOutcome." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE_ABUSE_INDICATOR> a skos:Concept ;
    skos:prefLabel "Abuse Indicator" ;
    skos:notation "3.1.6" ;
    skos:altLabel "ABUSE_INDICATOR" ;
    skos:altLabel "AbuseIndicator" ;
    skos:altLabel "PhysicalManifestation" ;
    skos:definition "An instance classified as an AbuseIndicator belongs to the DescriptiveICE category and exhibits the manifestsAs relationship pointing to a PhysicalManifestation. The manifestsAs relation links each AbuseIndicator to a PhysicalManifestation, while simultaneously classifying that AbuseIndicator as a DescriptiveICE. When modeling an AbuseIndicator, the schema must assign it the type DescriptiveICE and enforce a manifestsAs connection to an entity of type PhysicalManifestation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_SAFEGUARDING_REPORT_PROCESS> a skos:Concept ;
    skos:prefLabel "Safeguarding Report Process" ;
    skos:notation "1.44" ;
    skos:altLabel "SAFEGUARDING_REPORT_PROCESS" ;
    skos:altLabel "SafeguardingReportProcess" ;
    skos:altLabel "ChildProtectionTeam" ;
    skos:altLabel "ExternalAgency" ;
    skos:definition "The SafeguardingReportProcess denotes an Occurrent defined by execution by a ChildProtectionTeam and direction to an ExternalAgency. When a ChildProtectionTeam executes a SafeguardingReportProcess and directs it to an ExternalAgency, the resulting activity is classified as an Occurrent. (This changes the meaning slightly to a conditional/process view. The axiom is a static definition.) As an Occurrent, the SafeguardingReportProcess stands in an executedBy relation to a ChildProtectionTeam and a directedTo relation to an ExternalAgency." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_LEGAL_SERVICE_ADVERTISER_ROLE> a skos:Concept ;
    skos:prefLabel "Legal Service Advertiser Role" ;
    skos:notation "5.27" ;
    skos:altLabel "LEGAL_SERVICE_ADVERTISER_ROLE" ;
    skos:altLabel "LegalServiceAdvertiserRole" ;
    skos:altLabel "LegalProfessional" ;
    skos:altLabel "LegalAdvertisementActivity" ;
    skos:definition "{LegalServiceAdvertiserRole} is a role that inheres in exactly one {LegalProfessional}, and that is realized in some {LegalAdvertisementActivity} For an entity to count as {LegalServiceAdvertiserRole}, it must bear the inheres in relation to exactly one {LegalProfessional}, and the is realized in relation to at least one {LegalAdvertisementActivity}. Every {LegalServiceAdvertiserRole} stands in the inheres in relation to exactly one {LegalProfessional}, and the is realized in relation to at least one {LegalAdvertisementActivity}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_DONATION_EVENT> a skos:Concept ;
    skos:prefLabel "Donation Event" ;
    skos:notation "1.45" ;
    skos:altLabel "DONATION_EVENT" ;
    skos:altLabel "DonationEvent" ;
    skos:altLabel "DonorAgent" ;
    skos:altLabel "MonetaryAmount" ;
    skos:definition "A DonationEvent is defined as an occurrent wherein a DonorAgent is involved and a MonetaryAmount is present. Involvement of a DonorAgent and possession of a MonetaryAmount characterize an occurrent classified as a DonationEvent. When a DonorAgent participates and a MonetaryAmount is associated, the resulting occurrent constitutes a DonationEvent." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_INTERNATIONAL_GROWTH_INITIATIVE> a skos:Concept ;
    skos:prefLabel "International Growth Initiative" ;
    skos:notation "1.46" ;
    skos:altLabel "INTERNATIONAL_GROWTH_INITIATIVE" ;
    skos:altLabel "InternationalGrowthInitiative" ;
    skos:altLabel "GeographicRegion" ;
    skos:altLabel "MarketingPlan" ;
    skos:definition "An InternationalGrowthInitiative is a process that targets some GeographicRegion and employs some MarketingPlan." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_PROMOTIONAL_CALENDAR_ORDER> a skos:Concept ;
    skos:prefLabel "Promotional Calendar Order" ;
    skos:notation "1.47" ;
    skos:altLabel "PROMOTIONAL_CALENDAR_ORDER" ;
    skos:altLabel "PromotionalCalendarOrder" ;
    skos:altLabel "OrderConstraint" ;
    skos:altLabel "CalendarProductSpecification" ;
    skos:definition "A PromotionalCalendarOrder constitutes a process that incorporates an OrderConstraint and designates a CalendarProductSpecification." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_CLINICAL_PERFORMANCE_DATA_EVALUATION> a skos:Concept ;
    skos:prefLabel "Clinical Performance Data Evaluation" ;
    skos:notation "3.0.18" ;
    skos:altLabel "CLINICAL_PERFORMANCE_DATA_EVALUATION" ;
    skos:altLabel "ClinicalPerformanceDataEvaluation" ;
    skos:altLabel "ClinicalSystem" ;
    skos:altLabel "IndividualClinician" ;
    skos:definition "A ClinicalPerformanceDataEvaluation is an InformationContentEntity defined by its evaluation of a ClinicalSystem, its evaluation of an IndividualClinician, and its possession of a decimal MetricValue. When an InformationContentEntity evaluates a ClinicalSystem and evaluates an IndividualClinician while also holding a decimal MetricValue, it constitutes a ClinicalPerformanceDataEvaluation. The evaluation links for a ClinicalPerformanceDataEvaluation, which is an InformationContentEntity, connect to a ClinicalSystem and to an IndividualClinician, accompanied by a decimal MetricValue." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_QUALITY_IMPROVEMENT_PRESENTATION> a skos:Concept ;
    skos:prefLabel "Quality Improvement Presentation" ;
    skos:notation "3.0.19" ;
    skos:altLabel "QUALITY_IMPROVEMENT_PRESENTATION" ;
    skos:altLabel "QualityImprovementPresentation" ;
    skos:altLabel "EvidenceBasedMedicine" ;
    skos:altLabel "QualityImprovementFramework" ;
    skos:definition "An InformationContentEntity qualifies as a QualityImprovementPresentation when it addresses at least one EvidenceBasedMedicine and formulates at least one QualityImprovementFramework. The class of QualityImprovementPresentation comprises InformationContentEntity instances that address some EvidenceBasedMedicine and formulate some QualityImprovementFramework. Each QualityImprovementPresentation relates to some EvidenceBasedMedicine through an addresses relationship and to some QualityImprovementFramework through a formulates relationship, while remaining an InformationContentEntity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT_ENERGY_EFFICIENT_APPLIANCE> a skos:Concept ;
    skos:prefLabel "Energy Efficient Appliance" ;
    skos:notation "2.4" ;
    skos:altLabel "ENERGY_EFFICIENT_APPLIANCE" ;
    skos:altLabel "EnergyEfficientAppliance" ;
    skos:altLabel "EnergySavingComponent" ;
    skos:definition "An independent continuant qualifies as an EnergyEfficientAppliance when it contains a component that is an EnergySavingComponent. The composition of an EnergyEfficientAppliance requires that this independent continuant possesses a component classified as an EnergySavingComponent. An EnergyEfficientAppliance stands as an independent continuant defined by its possession of a component that is an EnergySavingComponent." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_ANIMATION_SEQUENCE_CREATION> a skos:Concept ;
    skos:prefLabel "Animation Sequence Creation" ;
    skos:notation "1.48" ;
    skos:altLabel "ANIMATION_SEQUENCE_CREATION" ;
    skos:altLabel "AnimationSequenceCreation" ;
    skos:altLabel "KeyframeTimeline" ;
    skos:altLabel "RenderingEngine" ;
    skos:definition "An AnimationSequenceCreation is defined as an occurrent that employs a KeyframeTimeline and performs rendering through a RenderingEngine. (Definitional) During an AnimationSequenceCreation, the process operates by drawing upon a KeyframeTimeline and executing rendering via a RenderingEngine. (Procedural) A KeyframeTimeline is utilized by an AnimationSequenceCreation, and a RenderingEngine is the component with which that occurrent carries out rendering. (Relational-fronted)" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_INDEPENDENT_COMMITTEE_INVESTIGATION> a skos:Concept ;
    skos:prefLabel "Independent Committee Investigation" ;
    skos:notation "1.49" ;
    skos:altLabel "INDEPENDENT_COMMITTEE_INVESTIGATION" ;
    skos:altLabel "IndependentCommitteeInvestigation" ;
    skos:altLabel "DataCollectionProcess" ;
    skos:altLabel "AnalyticalMethod" ;
    skos:definition "An Independent Committee Investigation constitutes a process characterized by its utilization of a Data Collection Process and its employment of an Analytical Method. A Data Collection Process and an Analytical Method are both engaged by an Independent Committee Investigation, which functions as a process. An Independent Committee Investigation operates as a process through the utilization of a Data Collection Process and the employment of an Analytical Method." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_DIGITAL_FORENSIC_ANALYSIS> a skos:Concept ;
    skos:prefLabel "Digital Forensic Analysis" ;
    skos:notation "1.50" ;
    skos:altLabel "DIGITAL_FORENSIC_ANALYSIS" ;
    skos:altLabel "DigitalForensicAnalysis" ;
    skos:altLabel "CyberSecurityIncident" ;
    skos:definition "A Digital Forensic Analysis is defined as a process that participates in a Cyber Security Incident. Participation in a Cyber Security Incident is the role assumed by the process known as a Digital Forensic Analysis. When a Digital Forensic Analysis is conducted, it operates as a process that participates in a Cyber Security Incident." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_LEGAL_TECH_SERVICE_PROVISION> a skos:Concept ;
    skos:prefLabel "Legal Tech Service Provision" ;
    skos:notation "5.28" ;
    skos:altLabel "LEGAL_TECH_SERVICE_PROVISION" ;
    skos:altLabel "LegalTechServiceProvision" ;
    skos:altLabel "ServiceProvider" ;
