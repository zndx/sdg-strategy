    skos:altLabel "Visual Rendering Engine" ;
    skos:altLabel "Rendering Processing Engine" ;
    skos:altLabel "Animation Visualization Engine" ;
    skos:altLabel "Rendering Pipeline Engine" ;
    skos:definition "This term identifies a computational engine that processes animation sequence creation data and renders it into final visual output. Practitioners apply this label when documenting software components, graphics processing units, or rendering farms that convert 3D models, lighting data, and animation timelines into viewable frames for films, games, or simulations. A computational engine that processes and renders animation sequence creation data into visual output." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_FILLER_RENDERINGENVIRONMENT> a skos:Concept ;
