    skos:altLabel "Facility Intake Staff" ;
    skos:altLabel "Healthcare Reception Team" ;
    skos:altLabel "Notification Processing Staff" ;
    skos:altLabel "Facility Intake Personnel" ;
    skos:definition "Receiving facility staff function as healthcare facility employees responsible for managing the intake of communicable disease notifications. These personnel process incoming reports through established facility workflows to ensure proper documentation and follow-up procedures. The staff members operate within facility administrative structures to coordinate notification handling and maintain compliance with reporting requirements. This term applies to personnel employed by healthcare facilities who manage the intake and processing of incoming communicable disease notifications." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT_FILLER_RECOVEREDSTATE> a skos:Concept ;
    skos:prefLabel "Filler Recoveredstate" ;
    skos:notation "2.12" ;
    skos:altLabel "FILLER_RECOVEREDSTATE" ;
    skos:altLabel "Post-Deficiency Recovery State" ;
    skos:altLabel "Restored Health State" ;
    skos:altLabel "Recovered Nutritional Status" ;
    skos:altLabel "Health Recovery Phase" ;
    skos:altLabel "Post-Illness Restoration" ;
    skos:definition "A constituent state representing the successful restoration of health or nutritional status following a period of deficiency or illness. The state captures the moment when clinical markers, dietary intake, or physiological indicators confirm that the entity has moved beyond the vulnerable condition and achieved stable recovery. This state marks the point where health metrics or nutritional indicators return to baseline levels after a prior deficiency or illness. The constituent state appears in clinical monitoring, public health tracking, and nutritional rehabilitation programs where recovery is measured against prior vulnerable conditions." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_FILLER_SERVICEMANAGEMENTPROCESS> a skos:Concept ;
