@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sdg:  <https://signals.zndx.org/sdg#> .

<https://signals.zndx.org/sdg/scheme> a skos:ConceptScheme ;
    skos:prefLabel "SDG column-type vocabulary (ontology-derived)" .

<https://signals.zndx.org/sdg#SDG_PROCESS> a skos:Concept ;
    skos:prefLabel "Process" ;
    skos:notation "1" ;
    skos:altLabel "PROC" ;
    skos:definition "A BFO process (occurrent): an entity that unfolds in time, e.g. an observation, a program execution, a governance activity." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> a skos:Concept ;
    skos:prefLabel "Independent Continuant" ;
    skos:notation "2" ;
    skos:altLabel "INDCONT" ;
    skos:definition "A BFO independent continuant: a bearer of qualities that persists through time." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ARTIFACT> a skos:Concept ;
    skos:prefLabel "Artifact" ;
    skos:notation "2.1" ;
    skos:altLabel "ARTIFACT" ;
    skos:definition "A CCO artifact: an object intentionally made to realize a function (instruments, systems, datasets-as-objects)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE> a skos:Concept ;
    skos:prefLabel "Information Content Entity" ;
    skos:notation "3" ;
    skos:altLabel "ICE" ;
    skos:definition "A CCO information content entity: a generically dependent continuant that is about, or carries information concerning, some entity." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> a skos:Concept ;
    skos:prefLabel "Descriptive Information Content Entity" ;
    skos:notation "3.1" ;
    skos:altLabel "DESCICE" ;
    skos:definition "An ICE that describes an entity or state of affairs (measurements, records, observations)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> a skos:Concept ;
    skos:prefLabel "Directive Information Content Entity" ;
    skos:notation "3.2" ;
    skos:altLabel "DIRICE" ;
    skos:definition "An ICE that prescribes or directs (plans, rules, requirements, policies)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> a skos:Concept ;
    skos:prefLabel "Designative Information Content Entity" ;
    skos:notation "3.3" ;
    skos:altLabel "DESIGICE" ;
    skos:definition "An ICE that designates or names an entity (identifiers, codes, keys)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC> a skos:Concept ;
    skos:prefLabel "Generic Entity" ;
    skos:notation "0" ;
    skos:altLabel "GENERIC" ;
    skos:definition "Foundational / domain-agnostic axiom patterns without a specific BFO/CCO anchor." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_PARENTING_ROLE> a skos:Concept ;
    skos:prefLabel "Parenting Role" ;
    skos:notation "0.1" ;
    skos:altLabel "PARENTING_ROLE" ;
    skos:definition "A ParentingRole is a role that inheresIn exactly one DisabledAdult and realizes some ParentingActivity. — Class: {ParentingRole:Class} SubClassOf: bfo:0000023, sdg:inheresIn exactly 1 {DisabledAdult:Class}, sdg:realizes some {ParentingActivity:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CLINICAL_DOCUMENTATION_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Clinical Documentation Activity" ;
    skos:notation "0.2" ;
    skos:altLabel "CLINICAL_DOCUMENTATION_ACTIVITY" ;
    skos:definition "ClinicalDocumentationActivity is a process that utilizes an InformationSystem and records a PatientEncounter. — Class: {ClinicalDocumentationActivity:Class} EquivalentTo: bfo:0000015 and sdg:utilizes_information_system some {InformationSystem:Class} and sdg:records_patient_encounter some {PatientEncounter:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_PDF_EXPORT_PROCESS> a skos:Concept ;
    skos:prefLabel "Pdf Export Process" ;
    skos:notation "0.3" ;
    skos:altLabel "PDF_EXPORT_PROCESS" ;
    skos:definition "A PdfExportProcess is a Process that ingests a ScannedImageSet and produces a PdfDocument, inheriting in an ExportExecution. — Class: {PdfExportProcess:Class} EquivalentTo: bfo:0000015 and sdg:ingestsImageSet some {ScannedImageSet:Class} and sdg:producesOutputFile some {PdfDocument:Class} and bfo:0000057 some {ExportExecution:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_LECTURE_SESSION> a skos:Concept ;
    skos:prefLabel "Lecture Session" ;
    skos:notation "0.4" ;
    skos:altLabel "LECTURE_SESSION" ;
    skos:definition "A LectureSession is an Occurrent that has_educational_resource some LectureNotes and has_computational_example some MathematicaExample. — Class: {LectureSession:Class} EquivalentTo: bfo:0000015 and sdg:hasEducationalResource some {LectureNotes:Class} and sdg:hasComputationalExample some {MathematicaExample:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_YOUNG_RESEARCHER_ROLE> a skos:Concept ;
    skos:prefLabel "Young Researcher Role" ;
    skos:notation "0.5" ;
    skos:altLabel "YOUNG_RESEARCHER_ROLE" ;
    skos:definition "A YoungResearcherRole is a role borne by exactly one IndependentContinuant that realizes some ResearchActivity. — Class: {YoungResearcherRole:Class} SubClassOf: bfo:0000023, sdg:bearsRole exactly 1 {IndependentContinuant:Class}, sdg:realizes some {ResearchActivity:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_LIBRARY_STUDENT_ASSISTANT_ROLE> a skos:Concept ;
    skos:prefLabel "Library Student Assistant Role" ;
    skos:notation "0.6" ;
    skos:altLabel "LIBRARY_STUDENT_ASSISTANT_ROLE" ;
    skos:definition "LibraryStudentAssistantRole is a role borne by exactly one student and realizes some library assistance activity. — Class: {LibraryStudentAssistantRole:Class} SubClassOf: bfo:0000023, sdg:borneBy exactly 1 {Student:Class}, sdg:realizes some {LibraryAssistanceActivity:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CONDIMENT_STATION> a skos:Concept ;
    skos:prefLabel "Condiment Station" ;
    skos:notation "0.7" ;
    skos:altLabel "CONDIMENT_STATION" ;
    skos:definition "A CondimentStation is a material entity that offers at least one AvailableTopping and is located at at least one StationLocation. — Class: {CondimentStation:Class} EquivalentTo: bfo:0000004 and sdg:offersTopping some {AvailableTopping:Class} and sdg:locatedAt some {StationLocation:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_INDIGENOUS_CHILD_ROLE> a skos:Concept ;
    skos:prefLabel "Indigenous Child Role" ;
    skos:notation "0.8" ;
    skos:altLabel "INDIGENOUS_CHILD_ROLE" ;
    skos:definition "An IndigenousChildRole is a role borne by exactly one IndependentContinuant that realizes a RightsExercise. — Class: {IndigenousChildRole:Class} SubClassOf: bfo:0000023, sdg:bearsOn exactly 1 {IndependentContinuant:Class}, sdg:realizes some {RightsExercise:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_POLICE_OFFICER_ROLE> a skos:Concept ;
    skos:prefLabel "Police Officer Role" ;
    skos:notation "0.9" ;
    skos:altLabel "POLICE_OFFICER_ROLE" ;
    skos:definition "A PoliceOfficerRole is a role that inheres in exactly one LawEnforcementAgency and realizes some OperationalUnit. — Class: {PoliceOfficerRole:Class} SubClassOf: bfo:0000023, sdg:bearsRole exactly 1 {LawEnforcementAgency:Class}, sdg:realizes some {OperationalUnit:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_RESPONSIVE_WEBSITE_DEVELOPMENT> a skos:Concept ;
    skos:prefLabel "Responsive Website Development" ;
    skos:notation "0.10" ;
    skos:altLabel "RESPONSIVE_WEBSITE_DEVELOPMENT" ;
    skos:definition "A ResponsiveWebsiteDevelopment is a process that targetsPlatform some WebPlatform and employsTechnique some ResponsiveDesignTechnique. — Class: {ResponsiveWebsiteDevelopment:Class} EquivalentTo: bfo:0000015 and sdg:targetsPlatform some {WebPlatform:Class} and sdg:employsTechnique some {ResponsiveDesignTechnique:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_CAMPAIGN_COORDINATION> a skos:Concept ;
    skos:prefLabel "Campaign Coordination" ;
    skos:notation "3.1" ;
    skos:altLabel "CAMPAIGN_COORDINATION" ;
    skos:definition "A CampaignCoordination is an information content entity that coordinates some OnlineChannel and coordinates some OfflineChannel and hasEngagementMetric some decimal. — Class: {CampaignCoordination:Class} EquivalentTo: cco:InformationContentEntity and sdg:coordinates some {OnlineChannel:Class} and sdg:coordinates some {OfflineChannel:Class} and sdg:hasEngagementMetric some xsd:decimal" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_BENEFIT_OPTION_ELECTION> a skos:Concept ;
    skos:prefLabel "Benefit Option Election" ;
    skos:notation "0.11" ;
    skos:altLabel "BENEFIT_OPTION_ELECTION" ;
    skos:definition "A BenefitOptionElection is a process that elects a RetirementBenefitOption and has a Member. — Class: {BenefitOptionElection:Class} EquivalentTo: bfo:0000015 and sdg:electsBenefitOption some {RetirementBenefitOption:Class} and sdg:hasApplicant some {Member:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE_RETIREMENT_BENEFIT_OPTION> a skos:Concept ;
    skos:prefLabel "Retirement Benefit Option" ;
    skos:notation "3.1.1" ;
    skos:altLabel "RETIREMENT_BENEFIT_OPTION" ;
    skos:definition "A RetirementBenefitOption is a descriptive information entity that specifies a survivor percentage and specifies guarantee months. — Class: {RetirementBenefitOption:Class} EquivalentTo: cco:DescriptiveICE and sdg:specifiesSurvivorPercentage some xsd:decimal and sdg:specifiesGuaranteeMonths some xsd:decimal" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_MARITAL_STATUS_CERTIFICATION> a skos:Concept ;
    skos:prefLabel "Marital Status Certification" ;
    skos:notation "3.2" ;
    skos:altLabel "MARITAL_STATUS_CERTIFICATION" ;
    skos:definition "A MaritalStatusCertification is an information content entity that certifies a MaritalState and specifies a SpousalConsentReason. — Class: {MaritalStatusCertification:Class} EquivalentTo: cco:InformationContentEntity and sdg:certifiesMaritalState some {MaritalState:Class} and sdg:specifiesConsentReason some {SpousalConsentReason:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE_BENEFICIARY_DESIGNATION> a skos:Concept ;
    skos:prefLabel "Beneficiary Designation" ;
    skos:notation "3.2.1" ;
    skos:altLabel "BENEFICIARY_DESIGNATION" ;
    skos:definition "A BeneficiaryDesignation is a directive information content entity that designates a DesignatedBeneficiary and governs a RetirementBenefitOption. — Class: {BeneficiaryDesignation:Class} SubClassOf: bfo:0000023, bfo:0000052 some bfo:0000002" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CLINICAL_QUALITY_IMPROVEMENT_PROGRAM> a skos:Concept ;
    skos:prefLabel "Clinical Quality Improvement Program" ;
    skos:notation "0.12" ;
    skos:altLabel "CLINICAL_QUALITY_IMPROVEMENT_PROGRAM" ;
    skos:definition "A ClinicalQualityImprovementProgram is a Process that utilizes some QuantitativeAnalyticTool and evaluates some ClinicalPerformanceData. — Class: {ClinicalQualityImprovementProgram:Class} EquivalentTo: bfo:0000015 and sdg:utilizesAnalyticTool some {QuantitativeAnalyticTool:Class} and sdg:evaluatesPerformanceData some {ClinicalPerformanceData:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE_LAW_AND_SOCIETY_TRACK_REQUIREMENT> a skos:Concept ;
    skos:prefLabel "Law And Society Track Requirement" ;
    skos:notation "3.2.2" ;
    skos:altLabel "LAW_AND_SOCIETY_TRACK_REQUIREMENT" ;
    skos:definition "LawAndSocietyTrackRequirement is a DirectiveICE that specifies a CourseSelectionSet and applies to a StudentRole. — Class: {LawAndSocietyTrackRequirement:Class} EquivalentTo: cco:DirectiveICE and sdg:specifiesCourseSelection some {CourseSelectionSet:Class} and sdg:appliesToStudent some {StudentRole:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_SENIOR_ANIMAL_SERVICES_OFFICER_ROLE> a skos:Concept ;
    skos:prefLabel "Senior Animal Services Officer Role" ;
    skos:notation "0.13" ;
    skos:altLabel "SENIOR_ANIMAL_SERVICES_OFFICER_ROLE" ;
    skos:definition "A SeniorAnimalServicesOfficerRole is a Role that exactly realizes a function in an AnimalServicesOrganization and realizes some AnimalControlActivity. — Class: {SeniorAnimalServicesOfficerRole:Class} SubClassOf: bfo:0000023, bfo:0000052 some {SeniorAnimalServicesOfficer:Class}, bfo:0000054 some {AnimalControlActivity:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_VECTOR_CONTROL_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Vector Control Activity" ;
    skos:notation "0.14" ;
    skos:altLabel "VECTOR_CONTROL_ACTIVITY" ;
    skos:definition "A VectorControlActivity is an Occurrent that implements some VectorControlProgram and targets some ResidentialStreet. — Class: {VectorControlActivity:Class} EquivalentTo: bfo:0000015 and sdg:implementsProgram some {VectorControlProgram:Class} and sdg:targetsLocation some {ResidentialStreet:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_SPECIFICATION_TESTING_EVENT> a skos:Concept ;
    skos:prefLabel "Specification Testing Event" ;
    skos:notation "0.15" ;
    skos:altLabel "SPECIFICATION_TESTING_EVENT" ;
    skos:definition "A SpecificationTestingEvent is an Occurrent that executes a TestingProtocol and targets a Material. — Class: {SpecificationTestingEvent:Class} EquivalentTo: bfo:0000015 and sdg:executesProtocol some {TestingProtocol:Class} and sdg:targetsMaterial some {TargetMaterial:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_MATHEMATICAL_LEARNING_PROCESS> a skos:Concept ;
    skos:prefLabel "Mathematical Learning Process" ;
    skos:notation "0.16" ;
    skos:altLabel "MATHEMATICAL_LEARNING_PROCESS" ;
    skos:definition "MathematicalLearningProcess is an occurrent that involves some mathematical concept and targets some student role. — Class: {MathematicalLearningProcess:Class} EquivalentTo: bfo:0000015 and sdg:involvesConcept some {MathematicalConcept:Class} and sdg:targetsStudent some {StudentRole:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_DATA_CONTROLLER_ROLE> a skos:Concept ;
    skos:prefLabel "Data Controller Role" ;
    skos:notation "0.17" ;
    skos:altLabel "DATA_CONTROLLER_ROLE" ;
    skos:definition "A DataControllerRole is an agent_role borne by exactly one LegalEntityOrPerson that realizes the DataDeterminationFunction of determining purposes and means for personal data processing. — Class: {DataControllerRole:Class} SubClassOf: bfo:0000023, bfo:0000052 some {LegalEntityOrPerson:Class}, bfo:0000054 some {DataDeterminationActivity:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_PERSONAL_DATA_PROCESSING_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Personal Data Processing Activity" ;
    skos:notation "0.18" ;
    skos:altLabel "PERSONAL_DATA_PROCESSING_ACTIVITY" ;
    skos:definition "A PersonalDataProcessingActivity is a process that executes a DataProcessingOperation via an AutomatedSystem and targets a PersonalDataRecord. — Class: {PersonalDataProcessingActivity:Class} EquivalentTo: bfo:0000015 and sdg:executesDataProcessingOperation some {AutomatedSystem:Class} and sdg:targetsDataEntity some {PersonalDataRecord:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_STRAP_FIXING_PROCESS> a skos:Concept ;
    skos:prefLabel "Strap Fixing Process" ;
    skos:notation "0.19" ;
    skos:altLabel "STRAP_FIXING_PROCESS" ;
    skos:definition "A StrapFixingProcess is a BFO process that involves attaching a LateralRestraintStrap and securing it to a BuildingFloorStructure. — Class: {StrapFixingProcess:Class} EquivalentTo: bfo:0000015 and sdg:attachesTo some {LateralRestraintStrap:Class} and sdg:securesTo some {BuildingFloorStructure:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_INVESTOR_RELATIONS_DIRECTOR_ROLE> a skos:Concept ;
    skos:prefLabel "Investor Relations Director Role" ;
    skos:notation "0.20" ;
    skos:altLabel "INVESTOR_RELATIONS_DIRECTOR_ROLE" ;
    skos:definition "An InvestorRelationsDirectorRole is a role borne by exactly one CorporateAgent that realizes an InvestorRelationsActivity. — Class: {InvestorRelationsDirectorRole:Class} SubClassOf: bfo:0000023, bfo:0000052 some {CorporateAgent:Class}, bfo:0000054 some {InvestorRelationsActivity:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CORPORATE_INFORMATION_DISCLOSURE_PROCESS> a skos:Concept ;
    skos:prefLabel "Corporate Information Disclosure Process" ;
    skos:notation "0.21" ;
    skos:altLabel "CORPORATE_INFORMATION_DISCLOSURE_PROCESS" ;
    skos:definition "A CorporateInformationDisclosureProcess is an occurrent that communicates with a RegulatoryBody and produces a FinancialReport. — Class: {CorporateInformationDisclosureProcess:Class} EquivalentTo: bfo:0000015 and sdg:communicatesWithEntity some {RegulatoryBody:Class} and sdg:producesDocument some {FinancialReport:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_PERSONAL_HEALTH_RECORD> a skos:Concept ;
    skos:prefLabel "Personal Health Record" ;
    skos:notation "3.3" ;
    skos:altLabel "PERSONAL_HEALTH_RECORD" ;
    skos:definition "A PersonalHealthRecord is a CCO Information Content Entity that states some HealthCondition and is subject of some ClientProfile. — Class: {PersonalHealthRecord:Class} EquivalentTo: cco:InformationContentEntity and sdg:states some {HealthCondition:Class} and sdg:subjectOf some {ClientProfile:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CHIEF_COMPLIANCE_OFFICER_ROLE> a skos:Concept ;
    skos:prefLabel "Chief Compliance Officer Role" ;
    skos:notation "0.22" ;
    skos:altLabel "CHIEF_COMPLIANCE_OFFICER_ROLE" ;
    skos:definition "A ChiefComplianceOfficerRole is a Role that inheresIn exactly 1 Person and realizes some CollegeAdministration. — Class: {ChiefComplianceOfficerRole:Class} SubClassOf: bfo:0000023, sdg:inheresIn exactly 1 {Person:Class}, sdg:realizes some {CollegeAdministration:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_PROTECTED_DISCLOSURE_PROCESS> a skos:Concept ;
    skos:prefLabel "Protected Disclosure Process" ;
    skos:notation "0.23" ;
    skos:altLabel "PROTECTED_DISCLOSURE_PROCESS" ;
    skos:definition "A ProtectedDisclosureProcess is a Process that directedTo some ReportingChannel and reportedBy some CollegeOfficial. — Class: {ProtectedDisclosureProcess:Class} EquivalentTo: bfo:0000015 and sdg:directedTo some {ReportingChannel:Class} and sdg:reportedBy some {CollegeOfficial:Class}" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_IMPROPER_CONDUCT_EVENT> a skos:Concept ;
    skos:prefLabel "Improper Conduct Event" ;
    skos:notation "0.24" ;
    skos:altLabel "IMPROPER_CONDUCT_EVENT" ;
