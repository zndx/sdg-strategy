    skos:altLabel "Human Actor" ;
    skos:definition "An agent that encompasses or is constituted by a human person. This term applies to any individual acting in a professional or official capacity, where the agent role is directly tied to the biological and social identity of a specific person. Identifies an agent that encompasses or is constituted by a human person. Used to distinguish human actors from organizational entities." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_IMAGINGEQUIPMENT> a skos:Concept ;
