<https://signals.zndx.org/sdg#SDG_PROCESS_TELE_SALES_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Tele Sales Activity" ;
    skos:notation "1.111" ;
    skos:altLabel "TELE_SALES_ACTIVITY" ;
    skos:altLabel "Telesales Activity" ;
