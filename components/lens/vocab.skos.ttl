    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE_CARE_QUALITY_ASSESSMENT> a skos:Concept ;
    skos:prefLabel "Care Quality Assessment" ;
    skos:notation "3.2.4" ;
    skos:altLabel "CARE_QUALITY_ASSESSMENT" ;
    skos:altLabel "Clinical Care Quality Review" ;
    skos:altLabel "Care Quality Evaluation" ;
    skos:altLabel "Healthcare Quality Assessment" ;
    skos:altLabel "Clinical Quality Review" ;
    skos:altLabel "Care Quality Specification" ;
    skos:definition "A care quality assessment evaluates clinical care standards through systematic measurement of healthcare delivery outcomes. This evaluation process measures clinical interventions, patient outcomes, and service effectiveness against established quality benchmarks. A care quality assessment evaluates clinical care standards through systematic measurement of healthcare delivery outcomes. This evaluation process measures clinical interventions, patient outcomes, and service effectiveness against established quality benchmarks." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CERTIFICATION_TIME> a skos:Concept ;
