<https://signals.zndx.org/sdg#SDG_GDC_SOFTWARE_INTERFACE> a skos:Concept ;
    skos:prefLabel "Software Interface" ;
    skos:notation "3.4" ;
    skos:altLabel "SOFTWARE_INTERFACE" ;
