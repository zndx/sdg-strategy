    skos:altLabel "Operational Guideline" ;
    skos:altLabel "Site Protocol" ;
    skos:definition "Defines a standardized procedure or set of rules governing activities within a specific operational area or site. This entity ensures consistent execution of tasks and maintains safety standards in operational environments. Used to document standardized rules and procedures governing daily activities within a specific operational area or site." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_OPERATIONALUNIT> a skos:Concept ;
