    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CERTIFIED_INTERNAL_AUDITOR> a skos:Concept ;
    skos:prefLabel "Certified Internal Auditor" ;
