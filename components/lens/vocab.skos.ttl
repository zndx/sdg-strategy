    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CONCEPT_CONSTRUCTION_PROCESS> a skos:Concept ;
    skos:prefLabel "Concept Construction Process" ;
    skos:notation "1.30" ;
    skos:altLabel "CONCEPT_CONSTRUCTION_PROCESS" ;
    skos:altLabel "ConceptConstructionProcess" ;
    skos:altLabel "SubjectConcept" ;
    skos:altLabel "PredicateConcept" ;
    skos:definition "A ConceptConstructionProcess is defined as a Process that takes a SubjectConcept via constructsFrom and produces a PredicateConcept via yieldsResult. When a Process operates as a ConceptConstructionProcess, it executes constructsFrom on a SubjectConcept and completes by executing yieldsResult within a PredicateConcept. Within a ConceptConstructionProcess, a SubjectConcept is drawn from through constructsFrom and a PredicateConcept is reached through yieldsResult, characterizing the Process." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

