    skos:altLabel "individual data record" ;
    skos:altLabel "PII data record" ;
    skos:altLabel "personal data file" ;
    skos:altLabel "identity data record" ;
    skos:altLabel "personal information file" ;
    skos:definition "A document content entity that contains personally identifiable information. This term applies to records holding specific data points that identify a person. A document content entity is characterized by holding personally identifiable information about an individual. Personally identifiable information about an individual is contained within a document content entity. A document content entity that contains personally identifiable information about an individual. This record holds specific data points that identify a person." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_POLICY_VIOLATION> a skos:Concept ;
    skos:prefLabel "Policy Violation" ;
    skos:notation "1.102" ;
    skos:altLabel "POLICY_VIOLATION" ;
    skos:altLabel "Planned Policy Breach" ;
    skos:altLabel "Institutional Policy Breach" ;
    skos:altLabel "Planned Rule Infraction" ;
    skos:altLabel "Institutional Rule Breach" ;
    skos:altLabel "Deliberate Policy Breach" ;
    skos:altLabel "Planned Regulatory Breach" ;
    skos:definition "This term captures a planned act that directly contravenes a specified institutional policy or regulation. Practitioners apply this label when documenting deliberate infractions such as unauthorized access to restricted areas, misuse of institutional resources, or breaches of conduct codes within organizational settings. A planned act constitutes a contravention of a specified institutional policy. A specified institutional policy is contravened by a planned act. A deliberate act that contravenes a specified institutional policy or regulation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_PRACTICE_MANAGEMENT_TOPIC> a skos:Concept ;
    skos:prefLabel "Practice Management Topic" ;
    skos:notation "0.18" ;
    skos:altLabel "PRACTICE_MANAGEMENT_TOPIC" ;
    skos:altLabel "Practice Management Topic" ;
    skos:altLabel "Professional Practice Management" ;
    skos:altLabel "Practice Management Instruction" ;
    skos:altLabel "Management Training Topic" ;
    skos:altLabel "Professional Management Topic" ;
    skos:definition "A training instruction act focused on the management aspects of a professional practice. This term describes educational activities that address management procedures within professional practice frameworks. The concept encompasses instructional content covering operational management, procedural guidelines, and administrative procedures specific to professional practice environments. Applies to training instruction acts focused on managing professional practice operations. Used when documenting educational content related to practice management procedures and operational guidelines." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_PRACTICE_SESSION> a skos:Concept ;
