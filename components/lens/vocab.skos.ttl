    skos:notation "2.9" ;
    skos:altLabel "PICK_DROP_LOCATION" ;
    skos:altLabel "PickDropLocation" ;
    skos:altLabel "TransportRoute" ;
    skos:definition "Every PickDropLocation falls under the category of Continuant and exists as a part of a TransportRoute. (Definitional/Categorical) Each PickDropLocation stands as a Continuant while occupying a part within a TransportRoute. (Relational-fronted/Structural) A PickDropLocation is required to be a Continuant and to form a part of a TransportRoute. (Normative)" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
