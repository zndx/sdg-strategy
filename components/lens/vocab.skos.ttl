    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_PDF_DOCUMENT> a skos:Concept ;
    skos:prefLabel "Pdf Document" ;
    skos:notation "3.0.44" ;
    skos:altLabel "PDF_DOCUMENT" ;
