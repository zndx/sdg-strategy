    skos:altLabel "Mail Drop Point" ;
    skos:altLabel "Dispatch Location" ;
    skos:altLabel "Mail Collection Point" ;
    skos:altLabel "Mail Drop Facility" ;
    skos:definition "A mail drop location accepts mail for dispatch to facilitate mail collection and distribution processes. This mailing facility maintains collection infrastructure, processing equipment, and dispatch mechanisms that enable efficient mail handling and support organized mail flow through designated collection points. Mailing facilities that accept mail for dispatch to facilitate mail collection and distribution processes." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_MALNOURISHEDCHILD> a skos:Concept ;
    skos:prefLabel "Filler Malnourishedchild" ;
    skos:notation "2.2.57" ;
    skos:altLabel "FILLER_MALNOURISHEDCHILD" ;
    skos:altLabel "malnourished child" ;
    skos:altLabel "child with nutritional deficiency" ;
    skos:altLabel "undernourished child" ;
    skos:altLabel "child suffering malnutrition" ;
    skos:altLabel "pediatric malnutrition case" ;
    skos:definition "A material entity in the developmental stage of childhood that suffers from a nutritional deficiency. This condition affects physical growth, cognitive development, and overall health during the critical childhood period. The child exhibits clinical signs of inadequate nutrient intake or absorption impacting developmental milestones. A material entity in the developmental stage of childhood that suffers from a nutritional deficiency. This condition affects physical growth, cognitive development, and overall health during the critical childhood period." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_FILLER_MONETARYAMOUNT> a skos:Concept ;
    skos:prefLabel "Filler Monetaryamount" ;
    skos:notation "4.5" ;
