    skos:altLabel "Statistical Monitoring Plan" ;
    skos:altLabel "Client Monitoring Protocol" ;
    skos:altLabel "Monitoring Specification" ;
    skos:definition "A monitoring protocol specifies a procedure for a sensor using client statistical information. This document defines the operational parameters and data collection methods for continuous sensor monitoring. This term specifies a monitoring procedure for a sensor using client statistical information." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_MUNICIPALPOOLFACILITY> a skos:Concept ;
    skos:prefLabel "Filler Municipalpoolfacility" ;
    skos:notation "2.2.58" ;
    skos:altLabel "FILLER_MUNICIPALPOOLFACILITY" ;
    skos:altLabel "Public Swimming Pool Complex" ;
    skos:altLabel "Municipal Recreation Pool" ;
    skos:altLabel "Community Pool Facility" ;
    skos:altLabel "Public Aquatic Center" ;
    skos:altLabel "City Swimming Pool" ;
    skos:definition "A municipal pool facility is a facility that serves a municipal recreation purpose. The facility provides infrastructure for swimming, water sports, and recreational activities within a municipal setting. This facility serves municipal recreation by providing aquatic spaces for community use. The facility operates in public parks, community centers, or dedicated municipal sites where swimming and water activities support local recreation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_NETWORKINFRASTRUCTURE> a skos:Concept ;
    skos:prefLabel "Filler Networkinfrastructure" ;
    skos:notation "2.2.59" ;
    skos:altLabel "FILLER_NETWORKINFRASTRUCTURE" ;
    skos:altLabel "Data Transmission Network" ;
    skos:altLabel "Computer Communication System" ;
    skos:altLabel "Telecommunication Backbone" ;
    skos:altLabel "Network Connectivity Framework" ;
    skos:altLabel "Data Transfer Infrastructure" ;
    skos:definition "Network infrastructure functions as the telecommunication foundation that enables data transmission between computer network components. Practitioners deploy this infrastructure to establish reliable communication pathways for information exchange across distributed systems. The framework includes physical and logical elements that support continuous data flow and connectivity requirements for network operations. This term applies to telecommunication systems that provide the underlying framework for data transmission across computer networks." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_NETWORKPROVIDER> a skos:Concept ;
    skos:prefLabel "Filler Networkprovider" ;
    skos:notation "2.2.60" ;
    skos:altLabel "FILLER_NETWORKPROVIDER" ;
    skos:altLabel "Network access provider" ;
    skos:altLabel "Internet service provider" ;
    skos:altLabel "Network connectivity provider" ;
    skos:altLabel "ISP service provider" ;
    skos:altLabel "Network infrastructure provider" ;
    skos:definition "A network provider is a service provider that provides network access for a computer network. This term refers to organizations that offer the infrastructure and services necessary for connecting devices to the internet or private networks. It includes the provision of bandwidth, routing, and other essential networking services. Applies to entities that supply network access and connectivity services to end-users or organizations." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_FILLER_NETWORKRESOURCE> a skos:Concept ;
