<https://signals.zndx.org/sdg#SDG_PROCESS_CME_SEMINAR> a skos:Concept ;
    skos:prefLabel "C M E Seminar" ;
    skos:notation "1.57" ;
    skos:altLabel "CME_SEMINAR" ;
