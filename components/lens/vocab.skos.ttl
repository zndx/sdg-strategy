    skos:altLabel "System Resource" ;
    skos:altLabel "Computing Network Asset" ;
    skos:altLabel "Network-Allocated Resource" ;
    skos:definition "This resource is allocated to a computer network to support communication, computation, or data management tasks. Practitioners provision it to enable service delivery, manage bandwidth, or maintain system availability in distributed computing environments. Applies to hardware, software, or data assets assigned to a computer network for operational use, such as servers, bandwidth, or storage within enterprise or cloud infrastructures." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

