    skos:altLabel "operational apparatus" ;
    skos:altLabel "field equipment" ;
    skos:altLabel "operational infrastructure" ;
    skos:altLabel "deployment equipment" ;
    skos:altLabel "operational machinery" ;
    skos:definition "This term designates infrastructure systems and apparatus deployed within operational areas to support field activities. Operational equipment includes machinery, communication systems, and support apparatus necessary for mission execution. These systems enable resource deployment, activity coordination, and operational capability maintenance within designated areas. Applies to physical systems and apparatus deployed within operational areas to support field activities. Used in military operations, emergency response coordination, and industrial site management." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_FILLER_OPERATIONALPROTOCOL> a skos:Concept ;
