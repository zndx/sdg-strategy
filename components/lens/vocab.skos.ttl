<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_INDEPENDENTECONOMICAGENT> a skos:Concept ;
    skos:prefLabel "Filler Independenteconomicagent" ;
    skos:notation "2.2.76" ;
