    skos:altLabel "AcademicRole" ;
    skos:altLabel "Person" ;
    skos:altLabel "AcademicActivity" ;
    skos:definition "{AcademicRole} is a role that inheres in exactly one {Person}, and that is realized in some {AcademicActivity} As a role, {AcademicRole} is characterised by the inheres in relation to exactly one {Person}, and the is realized in relation to at least one {AcademicActivity}. Each {AcademicRole} is defined as a role which inheres in exactly one {Person}, and which is realized in some {AcademicActivity}." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_STUDENT_CONDUCT_ADMINISTRATOR_ROLE> a skos:Concept ;
