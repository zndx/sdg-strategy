    skos:altLabel "Person Entity" ;
    skos:altLabel "Material Human" ;
    skos:altLabel "Human Subject" ;
    skos:definition "A material entity that constitutes a human person. This term captures the physical human being as the foundational subject in legal, medical, and administrative documentation, serving as the primary entity for consent, treatment, or claim processing. Applies to any material entity that physically constitutes a human person in legal, medical, or administrative contexts. Practitioners use this term when documenting the biological subject of a study, patient, or claimant in formal records." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_OBSERVATORYMOUNTINGSTRUCTURE> a skos:Concept ;
