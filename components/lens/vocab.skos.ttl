    skos:altLabel "Law Enforcement Organization" ;
    skos:altLabel "Law Enforcement Body" ;
    skos:definition "A government organization empowered to enforce laws. This entity maintains public order and prevents crime through its official authority. A government organization is defined as an entity that holds the authorization to enforce laws, maintain public order, and prevent crime. A government organization operates with the granted capacity to enforce laws, maintain public order, and prevent crime. A government organization empowered to enforce laws." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT_MARITAL_STATE> a skos:Concept ;
