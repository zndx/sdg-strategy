<https://signals.zndx.org/sdg#SDG_ICE_PREDICATE_CONCEPT> a skos:Concept ;
    skos:prefLabel "Predicate Concept" ;
    skos:notation "3.0.46" ;
    skos:altLabel "PREDICATE_CONCEPT" ;
