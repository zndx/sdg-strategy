    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CYBER_SECURITY_INCIDENT> a skos:Concept ;
    skos:prefLabel "Cyber Security Incident" ;
    skos:notation "0.26" ;
    skos:altLabel "CYBER_SECURITY_INCIDENT" ;
    skos:altLabel "Security Breach Event" ;
    skos:altLabel "Network Intrusion Alert" ;
    skos:altLabel "Malware Outbreak" ;
    skos:altLabel "Unauthorized Access Event" ;
    skos:altLabel "Data Exfiltration Incident" ;
    skos:definition "A cyber security incident is a process that participates in a computer network and involves a communication security aspect. These events manifest as unauthorized intrusions, malware propagation, or data exfiltration attempts that trigger automated security alerts and require immediate incident response protocols to isolate compromised systems and restore network integrity. Every instance classified as a cyber security incident constitutes a process that operates within a computer network and encompasses a communication security aspect. (Definitional) A process qualifies as a cyber security incident if it takes part in a computer network and engages a communication security aspect. (Procedural/Conditional) Active security events occurring within computer networks that involve unauthorized access, data theft, or system compromise requiring immediate digital response." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_DATA_COLLECTION_PROCESS> a skos:Concept ;
    skos:prefLabel "Data Collection Process" ;
    skos:notation "1.116" ;
    skos:altLabel "DATA_COLLECTION_PROCESS" ;
    skos:altLabel "Information Gathering Activity" ;
    skos:altLabel "Database Population Procedure" ;
    skos:altLabel "Monitoring Data Acquisition" ;
    skos:altLabel "Systematic Data Gathering" ;
    skos:altLabel "Observation Recording Process" ;
    skos:definition "The data collection process functions as an information processing activity that accomplishes monitoring protocols through systematic database participation. Practitioners execute this process to gather structured information through database interactions that support ongoing monitoring requirements. The workflow incorporates database systems as active participants in the data gathering procedures to ensure accurate recording and retrieval of monitored information. This term applies to information processing activities that accomplish monitoring protocols while utilizing databases as primary participants in the data gathering workflow." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_DATA_INPUT> a skos:Concept ;
    skos:prefLabel "Data Input" ;
    skos:notation "0.27" ;
    skos:altLabel "DATA_INPUT" ;
    skos:altLabel "data input" ;
    skos:altLabel "information input" ;
    skos:altLabel "data entry process" ;
    skos:altLabel "form-based input" ;
    skos:altLabel "database ingestion" ;
    skos:definition "This term describes the act of processing information where a form document serves as the participant and a database acts as the involvement target. It captures the concrete workflow step where structured data moves from a user-facing form into a persistent storage system. Practitioners use it to model the ingestion phase of data pipelines. A data input constitutes an information processing act wherein a form document participates and a database is involved. When information processing takes a form document as a participant and engages a database, that processing act is classified as a data input. Used in data integration workflows to describe the step where information is entered via a form document into a target database system." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_DECISION_MAKING_PROCESS_DEFINITION> a skos:Concept ;
    skos:prefLabel "Decision Making Process Definition" ;
    skos:notation "0.28" ;
    skos:altLabel "DECISION_MAKING_PROCESS_DEFINITION" ;
    skos:altLabel "Planning Decision Process" ;
    skos:altLabel "Decision Action Sequence" ;
    skos:altLabel "Choice Planning Activity" ;
    skos:altLabel "Decision Transition Workflow" ;
    skos:altLabel "Strategic Planning Process" ;
    skos:definition "A decision making process is an act of planning that has a decision action and a decision transition action as parts. The process encompasses the full sequence where participants execute choice actions and move through transition actions to reach a finalized plan or outcome. This process structures the sequence of planning actions where decision actions and decision transition actions occur as integral parts. The process applies in governance frameworks, project management, and operational planning where discrete choice points and their transitions are formally documented." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_DEGRADED_SYSTEM_CONDITION> a skos:Concept ;
    skos:prefLabel "Degraded System Condition" ;
    skos:notation "0.29" ;
    skos:altLabel "DEGRADED_SYSTEM_CONDITION" ;
    skos:altLabel "DegradedSystemCondition" ;
    skos:definition "A degraded system condition constitutes a reduction in function that resides within a state action and carries a loss of dependent continuant as a quality. A decrease of function inhering in a state action possesses a loss of dependent continuant as a quality, thereby forming a degraded system condition. Any instance classified as a degraded system condition must manifest as a decrease of function within a state action, accompanied by a loss of dependent continuant as a quality." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_DEPARTING_EMPLOYEE> a skos:Concept ;
    skos:prefLabel "Departing Employee" ;
    skos:notation "2.2.49" ;
    skos:altLabel "DEPARTING_EMPLOYEE" ;
    skos:altLabel "DepartingEmployee" ;
    skos:definition "A departing employee is defined precisely by the presence of a specific role and a departure status, with the disjoint function conjunct explicitly excluded. The specific role and the departure status jointly constitute a departing employee, while the disjoint The classification of a departing employee requires the possession of both a specific role and a departure status, while explicitly omitting the disjoint function conjunct." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT_GEOGRAPHIC_REGION> a skos:Concept ;
    skos:prefLabel "Geographic Region" ;
    skos:notation "2.13" ;
    skos:altLabel "GEOGRAPHIC_REGION" ;
    skos:altLabel "Administrative Zone" ;
    skos:altLabel "Territorial Boundary" ;
    skos:altLabel "Jurisdictional Area" ;
    skos:altLabel "Census Designated Place" ;
    skos:altLabel "Geospatial District" ;
    skos:definition "A geospatial region defined by its bounded spatial extent or administrative jurisdiction. These areas establish precise geographic boundaries for land management, resource allocation, and jurisdictional authority, often aligned with political borders, watershed limits, or statistical reporting districts. A geospatial region is characterized by a definition derived from either its bounded spatial extent or its administrative jurisdiction. To establish a geospatial region, the definition must be set by either its bounded spatial extent or its administrative jurisdiction. Defined spatial areas bounded by physical or political boundaries used for administrative, statistical, or operational planning purposes." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE_GOVERNANCE_FUNCTION> a skos:Concept ;
    skos:prefLabel "Governance Function" ;
    skos:notation "3.3.7" ;
    skos:altLabel "GOVERNANCE_FUNCTION" ;
    skos:altLabel "Governance function" ;
    skos:altLabel "Administrative authority role" ;
    skos:altLabel "Oversight function" ;
    skos:altLabel "Executive governance role" ;
    skos:altLabel "Organizational control function" ;
    skos:definition "{GovernanceFunction} is exactly a function that exercises governance over some organization. Applies to entities holding the authority to direct, manage, and oversee the operations of an organization or specific domain." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_H_S_S_S_E_Q__SITUATION> a skos:Concept ;
    skos:prefLabel "H S S S E Q_ Situation" ;
    skos:notation "1.117" ;
    skos:altLabel "H_S_S_S_E_Q__SITUATION" ;
    skos:altLabel "Operational Stasis State" ;
    skos:altLabel "Readiness Level Document" ;
    skos:altLabel "System Status Record" ;
    skos:altLabel "Equipment Stasis Log" ;
    skos:altLabel "Unit Readiness Profile" ;
    skos:definition "The HSSSEQ situation represents a documented state of operational stasis that records the current readiness level of a system or unit. Practitioners update these records to reflect the operational status of equipment, personnel availability, or system functionality. The documentation serves as a baseline reference for operational planning and resource deployment decisions. A stasis condition is defined as the documentation of the operational status or readiness level of a system or unit. The act of documenting the operational status or readiness level of a system or unit constitutes a stasis condition. This term applies to documentation that captures the current operational readiness or stasis condition of a specific system, unit, or equipment set." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_HEALTH_CARE_SUMMARY> a skos:Concept ;
    skos:prefLabel "Health Care Summary" ;
    skos:notation "3.0.48" ;
    skos:altLabel "HEALTH_CARE_SUMMARY" ;
    skos:altLabel "Healthcare Summary" ;
    skos:altLabel "Clinical Care Summary" ;
    skos:altLabel "Patient Care Summary" ;
    skos:altLabel "Health Record Summary" ;
    skos:altLabel "Medical Summary" ;
    skos:definition "A healthcare summary is an information content entity that consolidates key clinical care and outcome data for a patient. It serves as a concise overview of a patient's medical history, treatments, and outcomes, facilitating effective communication among healthcare providers and supporting patient-centered care. An information content entity is defined as an entity that consolidates key clinical care and outcome An information content entity is defined as a record that brings together key clinical care and outcome data for a patient. Used for documents or records that summarize clinical care and outcome data for a patient, often used for continuity of care or patient education." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE_HEALTH_STANDARD_COMPLIANCE> a skos:Concept ;
    skos:prefLabel "Health Standard Compliance" ;
    skos:notation "3.2.11" ;
    skos:altLabel "HEALTH_STANDARD_COMPLIANCE" ;
    skos:altLabel "Health Standard Compliance" ;
    skos:altLabel "Safety Protocol Adherence" ;
    skos:altLabel "Regulatory Quality Specification" ;
    skos:altLabel "Healthcare Compliance Document" ;
    skos:altLabel "Standards Conformity Record" ;
    skos:definition "This specification verifies that processes, products, or organizations meet defined health and safety criteria through systematic assessment. Practitioners utilize it to certify operational readiness, support audit trails, and ensure patient or worker safety in regulated environments. A quality specification is defined as a document that records adherence to established health and safety standards. Documenting adherence to established health and safety standards constitutes the function of a quality specification. Applies to documented evidence or verified states demonstrating adherence to established health, safety, or quality benchmarks in clinical, industrial, or regulatory contexts." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_HEALTHCARE_AGENT> a skos:Concept ;
    skos:prefLabel "Healthcare Agent" ;
    skos:notation "2.2.50" ;
    skos:altLabel "HEALTHCARE_AGENT" ;
    skos:altLabel "healthcare service provider" ;
    skos:altLabel "medical care agent" ;
    skos:altLabel "healthcare professional" ;
    skos:altLabel "clinical care provider" ;
    skos:altLabel "health service agent" ;
    skos:altLabel "medical service provider" ;
    skos:definition "An agent that provides healthcare. This term applies to entities that deliver medical care or health services to patients. An entity is classified as an agent precisely when it delivers or coordinates healthcare services inside a medical facility or a community. The operational role of an agent consists of delivering or coordinating healthcare services within a medical facility or a community. An agent that delivers or coordinates healthcare services within a medical facility or community. This entity provides direct medical care or health services." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_LAW_ENFORCEMENT_PERSONNEL> a skos:Concept ;
    skos:prefLabel "Law Enforcement Personnel" ;
    skos:notation "5.62" ;
    skos:altLabel "LAW_ENFORCEMENT_PERSONNEL" ;
    skos:altLabel "Law Enforcement Officer" ;
    skos:altLabel "Police Personnel" ;
    skos:altLabel "Enforcement Staff Member" ;
    skos:altLabel "Law Enforcement Worker" ;
    skos:altLabel "Police Force Member" ;
    skos:definition "A civilian role filled by an individual who performs law enforcement duties. The role encompasses activities related to public safety, order maintenance, and enforcement of laws within community settings. A civilian role is defined as a position occupied by a person whose responsibilities include carrying out law enforcement duties. When an individual performs law enforcement duties, that individual occupies a civilian role. This civilian role filled by an individual who performs law enforcement duties applies to personnel engaged in public safety and order maintenance. The role operates within law enforcement agencies and community safety frameworks." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_LECTURE_NOTES> a skos:Concept ;
    skos:prefLabel "Lecture Notes" ;
    skos:notation "2.2.51" ;
    skos:altLabel "LECTURE_NOTES" ;
    skos:altLabel "Lecture Notes" ;
    skos:altLabel "Lecture Transcript" ;
    skos:altLabel "Class Notes" ;
    skos:altLabel "Lecture Content Record" ;
    skos:altLabel "Session Notes" ;
    skos:definition "A material copy of a transcript recording the content of a lecture session. This document preserves the spoken content and instructional details from an educational presentation. A material copy of a transcript is defined as the physical instance of a document that records the content of a lecture session. The content of a lecture session is documented by a transcript, and the item under consideration is the material copy of that transcript. This term represents a material copy of a transcript recording the content of a lecture session." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_LEGAL_ADVERTISEMENT_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Legal Advertisement Activity" ;
    skos:notation "1.118" ;
    skos:altLabel "LEGAL_ADVERTISEMENT_ACTIVITY" ;
    skos:altLabel "LegalAdvertisementActivity" ;
    skos:definition "An act within a legal system is defined by its role in promoting legal services to the public. Legal services to the public are promoted by an act belonging to a legal system. The function of promoting legal services to the public is carried out by a legal system act." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_LEGAL_ENTITY_OR_PERSON> a skos:Concept ;
    skos:prefLabel "Legal Entity Or Person" ;
    skos:notation "2.2.52" ;
    skos:altLabel "LEGAL_ENTITY_OR_PERSON" ;
    skos:altLabel "Legal entity" ;
    skos:altLabel "Legal person" ;
    skos:altLabel "Formal legal person" ;
    skos:altLabel "Material legal entity" ;
    skos:altLabel "Legal status holder" ;
    skos:definition "A material entity that holds formal legal personhood status. This quality confers the capacity to participate in legal relations and hold rights within a recognized jurisdiction. An entity is a material entity that holds formal legal personhood status. Formal legal personhood status is held by a material entity. Applies to material entities that hold formal legal personhood status recognized by law." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_LEGAL_PROFESSIONAL> a skos:Concept ;
    skos:prefLabel "Legal Professional" ;
    skos:notation "0.30" ;
    skos:altLabel "LEGAL_PROFESSIONAL" ;
    skos:altLabel "legal professional" ;
    skos:altLabel "qualified legal advocate" ;
    skos:altLabel "licensed legal practitioner" ;
    skos:altLabel "legal practitioner" ;
    skos:altLabel "legal counsel" ;
    skos:definition "A legal professional denotes an individual who possesses formal legal qualifications and actively performs advocacy duties within a recognized legal framework. Practitioners reference this term when documenting licensed attorneys, legal advisors, or advocates who represent clients in judicial proceedings, draft legal instruments, or provide specialized legal counsel. The role emphasizes the formal accreditation and active practice of law, distinguishing the individual by their authorized capacity to navigate legal systems and deliver professional legal services. A legal advocate role is defined as the position held by an individual who possesses formal legal qualifications. The filling of a legal advocate role is undertaken by an individual who possesses formal legal qualifications. Used in legal practice and regulatory contexts to identify individuals who hold formal qualifications and actively engage in legal advocacy, such as attorneys, barristers, or solicitors, within a jurisdicti" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_LEGAL_TECH_SOLUTION_LAB> a skos:Concept ;
    skos:prefLabel "Legal Tech Solution Lab" ;
    skos:notation "2.2.53" ;
    skos:altLabel "LEGAL_TECH_SOLUTION_LAB" ;
    skos:altLabel "Legal Tech Innovation Hub" ;
    skos:altLabel "Law Tech Lab" ;
    skos:altLabel "Legal Innovation Center" ;
    skos:altLabel "Legal Technology Lab" ;
    skos:definition "A commercial organization dedicated to developing and testing new legal technology tools. The facility fosters innovation through research, development, and collaboration with legal professionals. A commercial organization is defined as an entity whose purpose is to foster legal technology innovation. A commercial organization dedicated to fostering legal technology innovation operates by actively supporting the development and adoption of legal technology innovation. Applies to commercial organizations dedicated to developing and testing new legal technology tools. The facility fosters innovation through research, development, and collaboration." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_LEGISLATIVE_DEPARTMENT> a skos:Concept ;
    skos:prefLabel "Legislative Department" ;
    skos:notation "2.2.54" ;
    skos:altLabel "LEGISLATIVE_DEPARTMENT" ;
    skos:altLabel "Legislative Department" ;
    skos:altLabel "Legislative Affairs Office" ;
    skos:altLabel "Government Legislative Body" ;
    skos:altLabel "Legislative Process Department" ;
    skos:altLabel "Legislative Affairs Department" ;
    skos:definition "A government organization responsible for handling legislative affairs. This term describes institutional structures within government frameworks that manage legislative workflows and procedural activities. The concept encompasses organizational units dedicated to legislative process management, including activities related to bill processing, regulatory implementation, and governmental legislative operations. The concept denotes a government organization that handles legislative affairs. Handling legislative affairs is the responsibility of a government organization. Applies to government organizations responsible for handling legislative affairs and processes. Used when documenting institutional structures that manage legislative workflows and procedures." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_LIFEGUARD_STAFF> a skos:Concept ;
    skos:prefLabel "Lifeguard Staff" ;
    skos:notation "5.63" ;
    skos:altLabel "LIFEGUARD_STAFF" ;
    skos:altLabel "Lifeguard staff" ;
    skos:altLabel "Aquatic safety staff" ;
    skos:altLabel "Lifeguard personnel" ;
    skos:altLabel "Pool safety staff" ;
    skos:altLabel "Aquatic safety personnel" ;
    skos:definition "This term identifies staff members who ensure aquatic safety through active monitoring and emergency response. It encompasses personnel responsible for preventing accidents and maintaining safety standards in aquatic environments. An organization member role is defined as a position occupied by staff who ensure aquatic safety. Use this term for staff members whose role is to ensure aquatic safety. It applies to individuals performing lifeguard duties, not to municipal pool management activities, board members, or law enforcement personnel." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_LOCAL_AUTHORITY> a skos:Concept ;
    skos:prefLabel "Local Authority" ;
    skos:notation "5.64" ;
    skos:altLabel "LOCAL_AUTHORITY" ;
    skos:altLabel "local government body" ;
    skos:altLabel "municipal authority" ;
    skos:altLabel "regional administrative body" ;
    skos:altLabel "local governance entity" ;
    skos:altLabel "municipal government" ;
    skos:definition "This term represents an authority role that exercises jurisdiction over a local administrative region. The role encompasses governance functions including public service delivery, regulatory enforcement, and resource allocation within the designated territory. Local authorities implement policies, manage infrastructure, and respond to community needs through structured administrative processes. An authority role is defined as the position that exercises jurisdiction over a local administrative region. Jurisdiction over a local administrative region is exercised by an authority role. An authority role exercising jurisdiction over a local administrative region." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_LOGIN_CREDENTIALS> a skos:Concept ;
    skos:prefLabel "Login Credentials" ;
    skos:notation "0.31" ;
    skos:altLabel "LOGIN_CREDENTIALS" ;
    skos:altLabel "Authentication Credential Record" ;
    skos:altLabel "Login Authorization Record" ;
    skos:altLabel "Digital Access Credential" ;
    skos:altLabel "Access Authorization Record" ;
    skos:altLabel "Login Credential Artifact" ;
    skos:definition "An authentication credential record stores account authorization data used to verify identity during digital access sessions. This artifact captures login details and access permissions required for system authentication workflows. An account authorization record functions as the instrument for authenticating digital access. The authentication of digital access is carried out by an account authorization record. Authentication Credential Record" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE_MACHINE_LEARNING_MODEL> a skos:Concept ;
    skos:prefLabel "Machine Learning Model" ;
    skos:notation "3.2.12" ;
    skos:altLabel "MACHINE_LEARNING_MODEL" ;
    skos:altLabel "Data Pattern Learning Algorithm" ;
    skos:altLabel "Predictive Learning Model" ;
    skos:altLabel "Algorithmic Pattern Recognizer" ;
    skos:altLabel "Machine Learning Predictor" ;
    skos:altLabel "Data-Driven Learning System" ;
    skos:definition "An algorithm that learns from data patterns to make predictions. The model processes input data through learning mechanisms to identify patterns and generate outputs based on those learned patterns. The algorithm learns from data patterns, thereby enabling predictions. (Maybe adds \"thereby enabling\"?) An algorithm is a method that learns from data patterns to make predictions. This model applies when an algorithm learns from data patterns to generate predictions or classifications. The model operates in computational environments where training data feeds into learning processes that produce actionable outputs." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_MAIL_DROP_LOCATION> a skos:Concept ;
    skos:prefLabel "Mail Drop Location" ;
    skos:notation "2.2.55" ;
    skos:altLabel "MAIL_DROP_LOCATION" ;
    skos:altLabel "Mail Drop Location" ;
    skos:altLabel "Mail Drop Point" ;
    skos:altLabel "Dispatch Location" ;
    skos:altLabel "Mail Collection Point" ;
    skos:altLabel "Mail Drop Facility" ;
    skos:definition "A mail drop location accepts mail for dispatch to facilitate mail collection and distribution processes. This mailing facility maintains collection infrastructure, processing equipment, and dispatch mechanisms that enable efficient mail handling and support organized mail flow through designated collection points. A mailing facility is defined as an entity that accepts mail for dispatch. The acceptance of mail for dispatch is a requisite property of a mailing facility. Mailing facilities that accept mail for dispatch to facilitate mail collection and distribution processes." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_MALNOURISHED_CHILD> a skos:Concept ;
    skos:prefLabel "Malnourished Child" ;
    skos:notation "2.2.56" ;
    skos:altLabel "MALNOURISHED_CHILD" ;
    skos:altLabel "malnourished child" ;
    skos:altLabel "child with nutritional deficiency" ;
    skos:altLabel "undernourished child" ;
    skos:altLabel "child suffering malnutrition" ;
    skos:altLabel "pediatric malnutrition case" ;
    skos:definition "A material entity in the developmental stage of childhood that suffers from a nutritional deficiency. This condition affects physical growth, cognitive development, and overall health during the critical childhood period. The child exhibits clinical signs of inadequate nutrient intake or absorption impacting developmental milestones. A material entity qualifies for this classification if and only if it exists in the developmental stage of childhood and exhibits a nutritional deficiency. The developmental stage of childhood and the condition of suffering from a nutritional deficiency jointly characterize a material entity. A material entity in the developmental stage of childhood that suffers from a nutritional deficiency. This condition affects physical growth, cognitive development, and overall health during the critical childhood period." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_MONETARY_AMOUNT> a skos:Concept ;
    skos:prefLabel "Monetary Amount" ;
    skos:notation "4.4" ;
    skos:altLabel "MONETARY_AMOUNT" ;
    skos:altLabel "monetary amount" ;
    skos:altLabel "currency value" ;
    skos:altLabel "financial sum" ;
    skos:altLabel "cash amount" ;
    skos:altLabel "denominated value" ;
    skos:definition "This term represents a quantifiable sum of money that is explicitly denominated in a specific currency unit. It captures the precise financial value and its associated monetary standard, such as dollars or euros. Practitioners use it to document transactions, balances, or valuations in financial records. Every monetary amount qualifies as an amount designated by a specific currency unit. (Definitional) Denomination in a specific currency unit is the required attribute that each monetary amount possesses. (Relational-fronted/Property-focused) Used when recording a specific sum of money tied to a particular currency unit, such as USD, EUR, or JPY." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_MONITORING_PROTOCOL> a skos:Concept ;
    skos:prefLabel "Monitoring Protocol" ;
    skos:notation "0.32" ;
    skos:altLabel "MONITORING_PROTOCOL" ;
    skos:altLabel "Monitoring Protocol" ;
    skos:altLabel "Sensor Monitoring Procedure" ;
    skos:altLabel "Statistical Monitoring Plan" ;
    skos:altLabel "Client Monitoring Protocol" ;
    skos:altLabel "Monitoring Specification" ;
    skos:definition "A monitoring protocol specifies a procedure for a sensor using client statistical information. This document defines the operational parameters and data collection methods for continuous sensor monitoring. Client statistical information that specifies a monitoring procedure for a sensor constitutes a monitoring protocol. (Definitional) A monitoring procedure for a sensor is specified by client statistical information, which is identified as a monitoring protocol. (Relational-fronted) This term specifies a monitoring procedure for a sensor using client statistical information." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_MUNICIPAL_POOL_FACILITY> a skos:Concept ;
    skos:prefLabel "Municipal Pool Facility" ;
    skos:notation "2.2.57" ;
    skos:altLabel "MUNICIPAL_POOL_FACILITY" ;
    skos:altLabel "Public Swimming Pool Complex" ;
    skos:altLabel "Municipal Recreation Pool" ;
    skos:altLabel "Community Pool Facility" ;
    skos:altLabel "Public Aquatic Center" ;
    skos:altLabel "City Swimming Pool" ;
    skos:definition "A municipal pool facility is a facility that serves a municipal recreation purpose. The facility provides infrastructure for swimming, water sports, and recreational activities within a municipal setting. A facility functions as a municipal pool facility precisely when it serves a municipal recreation purpose. (Maybe too strong with precisely when) Any facility that serves a municipal recreation purpose operates under the classification of a municipal pool facility. This facility serves municipal recreation by providing aquatic spaces for community use. The facility operates in public parks, community centers, or dedicated municipal sites where swimming and water activities support local recreation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_NETWORK_INFRASTRUCTURE> a skos:Concept ;
    skos:prefLabel "Network Infrastructure" ;
    skos:notation "2.2.58" ;
    skos:altLabel "NETWORK_INFRASTRUCTURE" ;
    skos:altLabel "Data Transmission Network" ;
    skos:altLabel "Computer Communication System" ;
    skos:altLabel "Telecommunication Backbone" ;
    skos:altLabel "Network Connectivity Framework" ;
    skos:altLabel "Data Transfer Infrastructure" ;
    skos:definition "Network infrastructure functions as the telecommunication foundation that enables data transmission between computer network components. Practitioners deploy this infrastructure to establish reliable communication pathways for information exchange across distributed systems. The framework includes physical and logical elements that support continuous data flow and connectivity requirements for network operations. Network infrastructure falls under telecommunication infrastructure, characterized by its support of data transmission for a computer network. Data transmission for a computer network is supported by network infrastructure, which constitutes a type of telecommunication infrastructure. This term applies to telecommunication systems that provide the underlying framework for data transmission across computer networks." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_NETWORK_PROVIDER> a skos:Concept ;
    skos:prefLabel "Network Provider" ;
    skos:notation "2.2.59" ;
    skos:altLabel "NETWORK_PROVIDER" ;
    skos:altLabel "Network access provider" ;
    skos:altLabel "Internet service provider" ;
    skos:altLabel "Network connectivity provider" ;
    skos:altLabel "ISP service provider" ;
    skos:altLabel "Network infrastructure provider" ;
    skos:definition "A network provider is a service provider that provides network access for a computer network. This term refers to organizations that offer the infrastructure and services necessary for connecting devices to the internet or private networks. It includes the provision of bandwidth, routing, and other essential networking services. Any entity classified as a network provider must simultaneously satisfy the criteria of a service provider and deliver network access for a computer network. Every instance of a network provider must fulfill the dual requirement of operating as a service provider and supplying network access for a computer network Applies to entities that supply network access and connectivity services to end-users or organizations." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_NETWORK_RESOURCE> a skos:Concept ;
    skos:prefLabel "Network Resource" ;
    skos:notation "0.33" ;
    skos:altLabel "NETWORK_RESOURCE" ;
    skos:altLabel "Network Resource" ;
    skos:altLabel "Allocated Network Asset" ;
    skos:altLabel "System Resource" ;
    skos:altLabel "Computing Network Asset" ;
    skos:altLabel "Network-Allocated Resource" ;
    skos:definition "This resource is allocated to a computer network to support communication, computation, or data management tasks. Practitioners provision it to enable service delivery, manage bandwidth, or maintain system availability in distributed computing environments. [Definitional] Every network resource constitutes a member of the resource category allocated to a computer network. [Relational-fronted] Allocation to a computer network determines the classification of a resource as a network resource. Applies to hardware, software, or data assets assigned to a computer network for operational use, such as servers, bandwidth, or storage within enterprise or cloud infrastructures." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_NETWORK_SCRUBBING_CENTER> a skos:Concept ;
    skos:prefLabel "Network Scrubbing Center" ;
    skos:notation "2.2.60" ;
    skos:altLabel "NETWORK_SCRUBBING_CENTER" ;
    skos:altLabel "NetworkScrubbingCenter" ;
    skos:definition "A telecommunication network node is defined as a network scrubbing center when it performs a traffic cleaning function. (Definitional) A network scrubbing center operates as a telecommunication network node by executing a traffic cleaning function. (Procedural)" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_NON_DIESEL_POWERED_VEHICLE> a skos:Concept ;
    skos:prefLabel "Non Diesel Powered Vehicle" ;
    skos:notation "2.2.61" ;
    skos:altLabel "NON_DIESEL_POWERED_VEHICLE" ;
    skos:altLabel "NonDieselPoweredVehicle" ;
    skos:definition "A non-diesel powered vehicle is defined as a ground motor vehicle that operates using a non-diesel power source, such as a fuel cell. (Definitional) Any ground motor vehicle that utilizes a non-diesel power source, such as a fuel cell, is classified as a non-diesel powered vehicle. (Relational-fronted / Predicate-fronted) A non-diesel powered vehicle constitutes a ground motor vehicle operating on a non-diesel power source, for example a fuel cell." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_NONPROFIT_ORGANIZATION> a skos:Concept ;
    skos:prefLabel "Nonprofit Organization" ;
    skos:notation "2.2.62" ;
    skos:altLabel "NONPROFIT_ORGANIZATION" ;
    skos:altLabel "Nonprofit Organization" ;
    skos:altLabel "Public Benefit Organization" ;
    skos:altLabel "Charitable Organization" ;
    skos:altLabel "Nonprofit Entity" ;
    skos:definition "An organization that operates for public benefit. This entity directs its resources and activities toward serving a public benefit purpose. Every nonprofit organization belongs to the class of organization precisely because it operates for a public benefit purpose. Operating for a public benefit purpose constitutes the defining operational characteristic that identifies a nonprofit organization as an organization. An organization that operates for public benefit." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_REFERRAL_PROCESS> a skos:Concept ;
    skos:prefLabel "Referral Process" ;
    skos:notation "0.34" ;
    skos:altLabel "REFERRAL_PROCESS" ;
    skos:altLabel "Referral Process" ;
    skos:altLabel "Case Referral Process" ;
    skos:altLabel "Client Referral Process" ;
    skos:altLabel "Service Referral Process" ;
    skos:altLabel "Referral Management Process" ;
    skos:definition "A Referral Process encompasses activities that involve requesting services or resources through a referral source role, including client intake and service coordination. This process facilitates the transfer of clients or cases to appropriate service providers based on established criteria. The activity manages referral documentation, tracks referral status, and ensures continuity of care through structured communication protocols. Applies to activities that involve requesting services or resources through a referral source role, including client intake and service coordination." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_REGULATORY_AUTHORITY> a skos:Concept ;
    skos:prefLabel "Regulatory Authority" ;
    skos:notation "5.65" ;
    skos:altLabel "REGULATORY_AUTHORITY" ;
    skos:altLabel "RegulatoryAuthority" ;
    skos:definition "An authority role is the entity that exercises regulation over a process. (Definitional) An authority role is the entity that exercises regulation over a process. An authority role exercises regulation over a process." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_REGULATORY_BODY> a skos:Concept ;
    skos:prefLabel "Regulatory Body" ;
    skos:notation "2.2.63" ;
    skos:altLabel "REGULATORY_BODY" ;
    skos:altLabel "Regulatory Body" ;
    skos:altLabel "Regulatory Authority" ;
    skos:altLabel "Regulatory Agency" ;
    skos:altLabel "Regulatory Commission" ;
    skos:definition "A regulatory body is a material entity that enforces a process regulation. This body ensures compliance with regulations and monitors regulatory adherence. The body operates within governance structures to enforce process regulations. A material entity is classified as an entity that enforces a process regulation. The enforcement of a process regulation is carried out by a material entity. A regulatory body is a material entity that enforces a process regulation. This body ensures compliance with regulations." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_RENDERING_ENGINE> a skos:Concept ;
    skos:prefLabel "Rendering Engine" ;
    skos:notation "2.2.64" ;
    skos:altLabel "RENDERING_ENGINE" ;
    skos:altLabel "Animation Rendering Engine" ;
    skos:altLabel "Animation Sequence Renderer" ;
    skos:altLabel "Visual Rendering Engine" ;
    skos:altLabel "Rendering Processing Engine" ;
    skos:altLabel "Animation Visualization Engine" ;
    skos:altLabel "Rendering Pipeline Engine" ;
    skos:definition "This term identifies a computational engine that processes animation sequence creation data and renders it into final visual output. Practitioners apply this label when documenting software components, graphics processing units, or rendering farms that convert 3D models, lighting data, and animation timelines into viewable frames for films, games, or simulations. An engine is defined as a component that renders an animation sequence creation process. The rendering of an animation sequence creation process is carried out by an engine. A computational engine that processes and renders animation sequence creation data into visual output." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_RENDERING_ENVIRONMENT_DEFINITION> a skos:Concept ;
    skos:prefLabel "Rendering Environment" ;
    skos:notation "0.35" ;
    skos:altLabel "RENDERING_ENVIRONMENT_DEFINITION" ;
    skos:altLabel "animation rendering space" ;
    skos:altLabel "3D rendering environment" ;
    skos:altLabel "rendering workspace" ;
    skos:altLabel "animation production environment" ;
    skos:altLabel "rendering setup" ;
    skos:definition "This term designates indoor environments configured for animation artifact rendering operations. These spaces contain computing infrastructure, display systems, and controlled lighting conditions necessary for processing digital animation outputs. The environment supports visualization, quality review, and technical validation of rendered animation sequences. An indoor environment is defined as a space that supports the rendering of an animation artifact. The rendering of an animation artifact is supported by an indoor environment. Applies to indoor settings where digital animation artifacts undergo computational rendering processes. Used in computer graphics production, architectural visualization, and virtual reality development workflows." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_REPORTING_CHANNEL> a skos:Concept ;
    skos:prefLabel "Reporting Channel" ;
    skos:notation "0.36" ;
    skos:altLabel "REPORTING_CHANNEL" ;
    skos:altLabel "Disclosure Channel" ;
    skos:altLabel "Whistleblower Line" ;
    skos:altLabel "Reporting Pathway" ;
    skos:altLabel "Complaint Channel" ;
    skos:altLabel "Intake Channel" ;
    skos:definition "A communication channel that transmits a protected disclosure process. This term describes communication pathways, such as hotlines, secure portals, or designated email addresses, that facilitate the submission and processing of protected disclosures, including whistleblower reports or compliance alerts. Applies to communication pathways that transmit protected disclosures, such as whistleblower reports or compliance alerts. Practitioners use this term when designing or managing systems for reporting misconduct, ethical violations, or regulatory concerns within organizations." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_REQUESTED_PROVIDER_TYPE> a skos:Concept ;
    skos:prefLabel "Requested Provider Type" ;
    skos:notation "0.37" ;
    skos:altLabel "REQUESTED_PROVIDER_TYPE" ;
    skos:altLabel "Requested Provider Type" ;
    skos:altLabel "Requested Service Type" ;
    skos:altLabel "Service Request Type" ;
    skos:altLabel "Requested Service Offering" ;
    skos:altLabel "Provider Request Type" ;
    skos:definition "A service type that is requested by a provider change request process. This term applies when a specific service offering is formally requested as part of a modification to an existing service arrangement, capturing the desired state of the service after the change. A service type is the target of a request made by a provider change request process. When a provider change request process operates, it requests a service type. Tracks the specific service type requested by a provider change request process. Used to manage service modification requests." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_REQUESTING_CLIENT> a skos:Concept ;
    skos:prefLabel "Requesting Client" ;
    skos:notation "2.2.65" ;
    skos:altLabel "REQUESTING_CLIENT" ;
    skos:altLabel "Client Making Request" ;
    skos:altLabel "Client Requestor" ;
    skos:altLabel "Service Requesting Client" ;
    skos:altLabel "Client Request Initiator" ;
    skos:altLabel "Client Change Requestor" ;
    skos:altLabel "Client Requesting Party" ;
    skos:definition "This term identifies a material entity that initiates a provider change request process by submitting formal documentation or digital submissions to service providers. Practitioners use this label when documenting entities such as healthcare organizations, insurance companies, or service departments that request modifications to existing provider networks, service agreements, or account configurations. A material entity serves as the agent that makes a provider change request process. (Adds \"serves as the agent that\" - maybe too much) A material entity is the entity that makes a provider change request process. A material entity that initiates a provider change request process through formal communication." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_REQUESTING_ENTITY> a skos:Concept ;
    skos:prefLabel "Requesting Entity" ;
    skos:notation "2.2.66" ;
    skos:altLabel "REQUESTING_ENTITY" ;
    skos:altLabel "Request submitter" ;
    skos:altLabel "Duplicating requestor" ;
    skos:altLabel "Request originator" ;
    skos:altLabel "Application entity" ;
    skos:altLabel "Request initiator" ;
    skos:definition "A RequestingEntity is a material entity that submits a duplicating request. It identifies the entity that initiates the request for duplication. This term applies when a material entity makes a formal request for a duplicate. A material entity is defined by its submission of a duplicating request. The submission of a duplicating request is carried out by a material entity. A RequestingEntity is a material entity that submits a duplicating request." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_RESEARCH_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Research Activity" ;
    skos:notation "0.38" ;
    skos:altLabel "RESEARCH_ACTIVITY" ;
    skos:altLabel "Research Project" ;
    skos:altLabel "Scientific Study" ;
    skos:altLabel "Investigation" ;
    skos:altLabel "Research Task" ;
    skos:altLabel "Academic Project" ;
    skos:definition "A research process that is conducted by a young researcher role. This term captures scientific investigations, data analysis, or experimental work actively performed by early-career researchers, such as doctoral candidates or postdoctoral fellows, often supported by mentorship or targeted funding programs. A research process is characterized as a process conducted by a young researcher role. The agent that conducts a research process is a young researcher role. Applies to research processes actively conducted by young researchers, such as doctoral candidates or early-career scientists. Practitioners use this term when tracking research outputs, funding allocations, or mentorship initiatives focused on emerging scholars." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FACILITY_INFRASTRUCTURE> a skos:Concept ;
    skos:prefLabel "Facility Infrastructure" ;
    skos:notation "2.2.67" ;
    skos:altLabel "FACILITY_INFRASTRUCTURE" ;
    skos:altLabel "Facility Infrastructure" ;
    skos:altLabel "Physical Infrastructure" ;
    skos:altLabel "Site Infrastructure" ;
    skos:altLabel "Facility Assets" ;
    skos:altLabel "Physical Plant" ;
    skos:definition "A facility that includes transportation infrastructure. This term applies to the physical structures and systems within a facility that support the movement of people and goods, including roads, walkways, and loading docks. A facility is defined as an entity that includes transportation infrastructure. (Definitional) A facility is characterized by its inclusion of transportation infrastructure. Tracks the physical infrastructure components of a facility. Used to manage and maintain physical assets." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_FINAL_INSPECTION_PROCESS> a skos:Concept ;
    skos:prefLabel "Final Inspection Process" ;
    skos:notation "1.119" ;
    skos:altLabel "FINAL_INSPECTION_PROCESS" ;
    skos:altLabel "FinalInspectionProcess" ;
    skos:definition "An act that performs material artifact processing is defined by having a process requirement as its objective. When material artifact processing occurs as an act, a process requirement functions as its objective. A process requirement serves as the objective for an act that executes material artifact processing." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FINANCIAL_FUND> a skos:Concept ;
    skos:prefLabel "Financial Fund" ;
    skos:notation "2.2.68" ;
    skos:altLabel "FINANCIAL_FUND" ;
    skos:altLabel "financial fund entity" ;
    skos:altLabel "fund agent" ;
    skos:altLabel "financial resource pool" ;
    skos:altLabel "fund entity" ;
    skos:definition "A financial facility that involves a financial resource. This entity serves as a container or mechanism for financial resources. The entity facilitates the aggregation and management of financial resources. A financial facility is defined as an entity that involves a financial resource. The involvement of a financial resource is attributed to a financial facility. A financial facility that involves a financial resource. This entity serves as a container or mechanism for financial resources." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_FINANCIAL_MANAGEMENT_PROCESS> a skos:Concept ;
    skos:prefLabel "Financial Management Process" ;
    skos:notation "0.39" ;
    skos:altLabel "FINANCIAL_MANAGEMENT_PROCESS" ;
    skos:altLabel "FinancialManagementProcess" ;
    skos:definition "A financial activity is an activity that involves financial strategy oversight. Financial strategy oversight is involved in a financial activity. When a financial activity is present, it includes financial strategy oversight." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FINANCIAL_PRODUCT> a skos:Concept ;
    skos:prefLabel "Financial Product" ;
    skos:notation "2.2.69" ;
    skos:altLabel "FINANCIAL_PRODUCT" ;
    skos:altLabel "financial instrument" ;
    skos:altLabel "financial artifact" ;
    skos:altLabel "investment product" ;
    skos:altLabel "financial vehicle" ;
    skos:altLabel "market instrument" ;
    skos:definition "This term captures financial instruments that function as tradeable assets or liabilities in capital markets. The instrument operates as a financial artifact enabling investment, financing, or risk transfer activities. Market participants deploy these instruments for portfolio construction, hedging strategies, or liquidity management. A financial instrument is defined by its possession of the function of a financial artifact. The function of a financial instrument is to serve as a financial artifact. A financial instrument serving as a tradeable asset or liability within capital markets." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_FINANCIAL_REPORT> a skos:Concept ;
    skos:prefLabel "Financial Report" ;
    skos:notation "3.0.49" ;
    skos:altLabel "FINANCIAL_REPORT" ;
    skos:altLabel "financial report entity" ;
    skos:altLabel "report content" ;
    skos:altLabel "financial information document" ;
    skos:altLabel "financial data report" ;
    skos:definition "An information content entity that concerns a financial resource. This entity represents a document or data set related to financial resources. The entity conveys information about financial resources through structured data or text. An information content entity is defined as any entity that concerns a financial resource. A financial resource serves as the subject of concern for an information content entity. An information content entity that concerns a financial resource. This entity represents a document or data set related to financial resources." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_FINANCIAL_RESOURCE> a skos:Concept ;
    skos:prefLabel "Financial Resource" ;
    skos:notation "4.5" ;
    skos:altLabel "FINANCIAL_RESOURCE" ;
    skos:altLabel "Financial Resource" ;
    skos:altLabel "Fin Resource" ;
    skos:altLabel "Financial Asset" ;
    skos:altLabel "Monetary Resource" ;
    skos:altLabel "Capital Resource" ;
    skos:definition "A Financial Resource is a financial value used for a financial activity. This resource includes funds, credit, or investments. The value supports operational needs and strategic initiatives. A financial value is defined as an amount applied to a financial activity. A financial activity is associated with a financial value that serves as its input. A Financial Resource is a financial value used for a financial activity. This resource includes funds, credit, or investments. The value supports operational needs and strategic initiatives." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_HEALTH_RECORD_TRANSFER_PROCESS> a skos:Concept ;
    skos:prefLabel "Health Record Transfer Process" ;
    skos:notation "1.120" ;
    skos:altLabel "HEALTH_RECORD_TRANSFER_PROCESS" ;
    skos:altLabel "HealthRecordTransferProcess" ;
    skos:definition "A telemetry process is one that conveys health record data between systems. Health record data is conveyed between systems by a telemetry process. Conveying health record data between systems is the activity performed by a telemetry process." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_HEALTHCARE_NETWORK_INFRASTRUCTURE> a skos:Concept ;
    skos:prefLabel "Healthcare Network Infrastructure" ;
    skos:notation "2.2.70" ;
    skos:altLabel "HEALTHCARE_NETWORK_INFRASTRUCTURE" ;
    skos:altLabel "Healthcare Network Infrastructure" ;
    skos:altLabel "Healthcare Network Support System" ;
    skos:altLabel "Medical Service Network Backbone" ;
    skos:altLabel "Clinical Service Network" ;
    skos:altLabel "Healthcare Connectivity Infrastructure" ;
    skos:definition "Healthcare Network Infrastructure constitutes the underlying network support system that facilitates the delivery of healthcare services. It includes the computer networks, servers, and communication channels that connect healthcare facilities, enabling the transmission of patient data, clinical information, and operational communications. This infrastructure ensures reliable and secure connectivity for healthcare operations, supporting the continuous provision of medical services and patient care. An infrastructure system is defined as the entity that delivers the underlying network support for healthcare services. The underlying network support for healthcare services is supplied by an infrastructure system. This term designates the physical and logical network components that provide connectivity for healthcare services within a designated operational area. It encompasses the hardware, software, and communication protocols that enable data exchange between healthcare facilities, pro" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_HEALTHCARE_ORGANIZATION> a skos:Concept ;
    skos:prefLabel "Healthcare Organization" ;
    skos:notation "2.2.71" ;
    skos:altLabel "HEALTHCARE_ORGANIZATION" ;
    skos:altLabel "Healthcare provider" ;
    skos:altLabel "Medical organization" ;
    skos:altLabel "Health service provider" ;
    skos:altLabel "Healthcare institution" ;
    skos:altLabel "Medical facility" ;
    skos:definition "A HealthcareOrganization is an Organization that provides healthcare services through healthcare facilities. It defines the entity responsible for delivering medical care. This term applies when an organization operates healthcare facilities to provide services. A HealthcareOrganization is an Organization that provides healthcare services through healthcare facilities." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE_HEIGHT_MEASUREMENT> a skos:Concept ;
    skos:prefLabel "Height Measurement" ;
    skos:notation "3.1.22" ;
    skos:altLabel "HEIGHT_MEASUREMENT" ;
    skos:altLabel "Height Measurement" ;
    skos:altLabel "Vertical Extent Measurement" ;
    skos:altLabel "Height Quantification" ;
    skos:altLabel "Vertical Dimension Measure" ;
    skos:altLabel "Height Data Point" ;
    skos:definition "A measurement unit that quantifies the vertical extent or height of an entity. This concept captures the physical distance from the base to the top of an object or structure, as recorded by precision instruments like laser levels or calipers. A measurement unit refers to a standard used to quantify the vertical extent or height of an entity. Applies to the measurement of vertical dimensions in manufacturing, construction, and physics contexts." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE_HORSE_IDENTITY> a skos:Concept ;
    skos:prefLabel "Horse Identity" ;
    skos:notation "3.3.8" ;
    skos:altLabel "HORSE_IDENTITY" ;
    skos:altLabel "Horse identifier" ;
    skos:altLabel "Horse identity code" ;
    skos:altLabel "Equine identifier" ;
    skos:altLabel "Horse designation" ;
    skos:altLabel "Equine identity tag" ;
    skos:definition "An arbitrary identifier that uniquely designates a specific horse. This identifier serves as the primary reference for linking records and managing the lifecycle of the animal. An identifier is defined as the unique designator for a specific horse. A specific horse is uniquely designated by an identifier. Applies to an arbitrary identifier that uniquely designates a specific horse within a registry or tracking system." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_HOUSING_CLIENT> a skos:Concept ;
    skos:prefLabel "Housing Client" ;
    skos:notation "2.2.72" ;
    skos:altLabel "HOUSING_CLIENT" ;
    skos:altLabel "Housing Client" ;
    skos:altLabel "Rental Housing Client" ;
    skos:altLabel "Housing Agreement Client" ;
    skos:altLabel "Housing Service Client" ;
    skos:altLabel "Rental Agreement Client" ;
    skos:definition "A material entity that enters into a rental agreement for housing. This term describes individuals or organizations that participate in housing rental arrangements through formal agreements. The concept encompasses all material entities engaging in housing rental transactions, from individual residents to organizational entities participating in structured housing rental agreements. A material entity is classified as such when it enters into a rental agreement for housing. The party that enters into a rental agreement for housing is a material entity. Applies to material entities that enter into rental agreements for housing purposes. Used when documenting individuals or entities participating in housing rental arrangements." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_HOUSING_DEBT_ISSUE> a skos:Concept ;
    skos:prefLabel "Housing Debt Issue" ;
    skos:notation "4.6" ;
    skos:altLabel "HOUSING_DEBT_ISSUE" ;
    skos:altLabel "Housing debt instrument" ;
    skos:altLabel "Rental-backed debt" ;
    skos:altLabel "Property debt obligation" ;
    skos:altLabel "Housing loan issue" ;
    skos:altLabel "Rental debt security" ;
    skos:definition "A financial value of property that arises from a rental agreement. This term captures the specific financial instrument tied to housing debt, where the underlying asset and cash flows originate from rental income streams. Practitioners use this to track and manage debt securities backed by rental properties. A financial value of property is the amount derived from a rental agreement. A rental agreement serves as the basis from which a financial value of property arises. Applies to financial instruments representing property debt obligations arising directly from rental agreements." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC_HOUSING_POLICY_TOPIC> a skos:Concept ;
    skos:prefLabel "Housing Policy Topic" ;
    skos:notation "3.5" ;
    skos:altLabel "HOUSING_POLICY_TOPIC" ;
    skos:altLabel "HousingPolicyTopic" ;
    skos:definition "A generically dependent continuant that addresses matters related to housing rentals." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_HUMAN_AGENT> a skos:Concept ;
    skos:prefLabel "Human Agent" ;
    skos:notation "2.2.73" ;
    skos:altLabel "HUMAN_AGENT" ;
    skos:altLabel "Human Agent" ;
    skos:altLabel "Individual Person" ;
    skos:altLabel "Human Person" ;
    skos:altLabel "Natural Person" ;
    skos:altLabel "Human Actor" ;
    skos:definition "An agent that encompasses or is constituted by a human person. This term applies to any individual acting in a professional or official capacity, where the agent role is directly tied to the biological and social identity of a specific person. An entity qualifies as an agent when it encompasses a human person or is constituted by a human person. The encompassing or constituting of a human person defines the agent in question. Identifies an agent that encompasses or is constituted by a human person. Used to distinguish human actors from organizational entities." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_IMAGING_EQUIPMENT> a skos:Concept ;
    skos:prefLabel "Imaging Equipment" ;
    skos:notation "2.2.74" ;
    skos:altLabel "IMAGING_EQUIPMENT" ;
    skos:altLabel "Diagnostic Imaging Instrument" ;
    skos:altLabel "Medical Imaging Equipment" ;
    skos:altLabel "Imaging Diagnostic Device" ;
    skos:altLabel "Diagnostic Imaging Apparatus" ;
    skos:altLabel "Clinical Imaging Equipment" ;
    skos:altLabel "Imaging Diagnostic Instrument" ;
    skos:definition "This term identifies specialized imaging instruments that facilitate diagnostic imaging procedures for clinical patient assessment. Practitioners apply this label when documenting MRI scanners, CT machines, ultrasound systems, or X-ray equipment used by radiologists and clinicians to visualize internal structures, detect abnormalities, and guide treatment decisions in medical facilities. A specialized instrument that facilitates diagnostic imaging procedures for clinical assessment." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_INDEPENDENT_ECONOMIC_AGENT> a skos:Concept ;
    skos:prefLabel "Independent Economic Agent" ;
    skos:notation "2.2.75" ;
    skos:altLabel "INDEPENDENT_ECONOMIC_AGENT" ;
    skos:altLabel "Independent Economic Agent" ;
    skos:altLabel "Market Participant" ;
    skos:altLabel "Autonomous Economic Actor" ;
    skos:altLabel "Independent Business Entity" ;
    skos:altLabel "Standalone Economic Agent" ;
    skos:definition "An Independent Economic Agent functions as an autonomous decision-maker that participates in market exchanges with external business partners. This entity maintains operational independence, negotiates contracts, and manages resources to achieve economic objectives. The agent engages in strategic market activities, including procurement, sales, and investment, to sustain its economic viability and competitive positioning. An agent is defined as a participant that engages in market exchange with external business partners. Engagement in market exchange with external business partners is conducted by an agent. Applies to economic entities that participate in market exchanges as autonomous decision-makers, independent of other organizations." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_INDIVIDUAL> a skos:Concept ;
    skos:prefLabel "Individual" ;
    skos:notation "2.2.76" ;
    skos:altLabel "INDIVIDUAL" ;
    skos:altLabel "Human Person" ;
    skos:altLabel "Human Individual" ;
    skos:altLabel "Person Entity" ;
    skos:altLabel "Material Human" ;
    skos:altLabel "Human Subject" ;
    skos:definition "A material entity that constitutes a human person. This term captures the physical human being as the foundational subject in legal, medical, and administrative documentation, serving as the primary entity for consent, treatment, or claim processing. A material entity is defined as anything that constitutes a human person. The constituting relation holds from a material entity to a human person. Applies to any material entity that physically constitutes a human person in legal, medical, or administrative contexts. Practitioners use this term when documenting the biological subject of a study, patient, or claimant in formal records." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_OBSERVATORY_MOUNTING_STRUCTURE> a skos:Concept ;
    skos:prefLabel "Observatory Mounting Structure" ;
    skos:notation "2.2.77" ;
    skos:altLabel "OBSERVATORY_MOUNTING_STRUCTURE" ;
    skos:altLabel "Observatory Mounting Structure" ;
    skos:altLabel "Telescope Mount" ;
    skos:altLabel "Observatory Equipment Support" ;
    skos:altLabel "Instrument Mount" ;
    skos:altLabel "Observatory Support Structure" ;
    skos:definition "An equipment mount that supports an observatory instrument. This structure provides the physical foundation and stabilization required for optical telescope operations. The support relationship holds between an equipment mount and an observatory instrument. An equipment mount serves to support an observatory instrument. This term represents an equipment mount that supports an observatory instrument." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_OFFLINE_CHANNEL> a skos:Concept ;
    skos:prefLabel "Offline Channel" ;
    skos:notation "0.40" ;
    skos:altLabel "OFFLINE_CHANNEL" ;
    skos:altLabel "Offline Channel" ;
    skos:altLabel "Offline Media Channel" ;
    skos:altLabel "Broadcast Channel" ;
    skos:altLabel "Television Channel" ;
    skos:altLabel "Non-Digital Channel" ;
    skos:definition "An Offline Channel is a dissemination channel that utilizes offline media. This channel includes television broadcasts, radio, and print. The channel reaches audiences through non-digital platforms. A dissemination channel that utilizes offline media relies on offline media for its operation. (adds \"for its operation\" - maybe too much) A dissemination channel that utilizes offline media employs offline media as its medium. An Offline Channel is a dissemination channel that utilizes offline media. This channel includes television broadcasts, radio, and print. The channel reaches audiences through non-digital platforms." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_ONLINE_CHANNEL> a skos:Concept ;
    skos:prefLabel "Online Channel" ;
    skos:notation "0.41" ;
    skos:altLabel "ONLINE_CHANNEL" ;
    skos:altLabel "Digital Channel" ;
    skos:altLabel "Web Channel" ;
    skos:altLabel "Online Platform" ;
    skos:altLabel "Internet Channel" ;
    skos:altLabel "Virtual Channel" ;
    skos:definition "A dissemination channel that utilizes online media. This term describes communication pathways that leverage internet infrastructure, such as websites, social media platforms, or digital messaging systems, to distribute information to target audiences. A dissemination channel is defined by its utilization of online media. A dissemination channel functions Applies to digital communication pathways that leverage internet infrastructure for information dissemination. Practitioners use this term when designing or analyzing outreach strategies that rely on websites, social media, or digital messaging platforms." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_OPERATIONAL_DISRUPTION> a skos:Concept ;
    skos:prefLabel "Operational Disruption" ;
    skos:notation "1.121" ;
    skos:altLabel "OPERATIONAL_DISRUPTION" ;
    skos:altLabel "Operational Disruption" ;
    skos:altLabel "Operational Area Stasis" ;
    skos:altLabel "Process Interruption" ;
    skos:altLabel "Operational Stasis" ;
    skos:altLabel "Service Disruption" ;
    skos:definition "Operational Disruption refers to a state of stasis in artifact operationality that impacts an operational area, resulting in a temporary halt or reduction of normal activities. This condition affects the ability to perform tasks, utilize resources, or deliver services within the designated operational area. The disruption may involve delays, pauses, or interruptions in the execution of processes, impacting the efficiency and effectiveness of operations. This term identifies a state of halted or impaired operational activity within a specific operational area, affecting the delivery of services or functions. It represents a temporary cessation or reduction in the normal functioning of processes, systems, or resources within the defined operational context." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_OPERATIONAL_EFFECTIVENESS> a skos:Concept ;
    skos:prefLabel "Operational Effectiveness" ;
    skos:notation "1.122" ;
    skos:altLabel "OPERATIONAL_EFFECTIVENESS" ;
    skos:altLabel "Operational Area Evaluation" ;
    skos:altLabel "Operational Stasis Assessment" ;
    skos:altLabel "Area Effectiveness Measure" ;
    skos:altLabel "Operational Performance State" ;
    skos:altLabel "Area Evaluation Stasis" ;
    skos:definition "An operational stasis that evaluates an operational area. The stasis captures the state where performance metrics, resource allocation, and outcome measures are assessed within a specific operational area to determine effectiveness. An operational stasis is defined as the entity that evaluates an operational area. The evaluation of an operational area is performed by an operational stasis. This operational stasis evaluates an operational area by measuring performance metrics within defined boundaries. The stasis applies in military, emergency response, or organizational contexts where area effectiveness is assessed through structured evaluation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_OPERATIONAL_EQUIPMENT> a skos:Concept ;
    skos:prefLabel "Operational Equipment" ;
    skos:notation "2.2.78" ;
    skos:altLabel "OPERATIONAL_EQUIPMENT" ;
    skos:altLabel "operational apparatus" ;
    skos:altLabel "field equipment" ;
    skos:altLabel "operational infrastructure" ;
    skos:altLabel "deployment equipment" ;
    skos:altLabel "operational machinery" ;
    skos:definition "This term designates infrastructure systems and apparatus deployed within operational areas to support field activities. Operational equipment includes machinery, communication systems, and support apparatus necessary for mission execution. These systems enable resource deployment, activity coordination, and operational capability maintenance within designated areas. Infrastructure systems or apparatus constitute equipment that is deployed to support activities within an operational area. To support activities within an operational area, infrastructure systems or apparatus are deployed. Applies to physical systems and apparatus deployed within operational areas to support field activities. Used in military operations, emergency response coordination, and industrial site management." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_OPERATIONAL_PROTOCOL> a skos:Concept ;
    skos:prefLabel "Operational Protocol" ;
    skos:notation "0.42" ;
    skos:altLabel "OPERATIONAL_PROTOCOL" ;
    skos:altLabel "Operational Protocol" ;
    skos:altLabel "Standard Operating Procedure" ;
    skos:altLabel "Operational Procedure" ;
    skos:altLabel "Field Protocol" ;
    skos:altLabel "Operational Guideline" ;
    skos:altLabel "Site Protocol" ;
    skos:definition "Defines a standardized procedure or set of rules governing activities within a specific operational area or site. This entity ensures consistent execution of tasks and maintains safety standards in operational environments. The property realized_by is defined to take a process (bfo:0000015) as its filler, replacing the prior continuant (ont00000567) value in accordance with the property range. The filler for realized_by was updated from a continuant (ont00000567) to a process (bfo:0000015), thereby aligning the value type with the specified property range. Used to document standardized rules and procedures governing daily activities within a specific operational area or site." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_OPERATIONAL_UNIT> a skos:Concept ;
    skos:prefLabel "Operational Unit" ;
    skos:notation "2.2.79" ;
    skos:altLabel "OPERATIONAL_UNIT" ;
    skos:altLabel "operational base" ;
    skos:altLabel "police unit" ;
    skos:altLabel "law enforcement base" ;
    skos:altLabel "operational entity" ;
    skos:definition "A base of operations or organizational entity comprising law enforcement personnel. This entity serves as a physical or organizational location for police officers. The entity provides the structural framework for police officer roles. A functional unit is defined as an entity that bears a police officer role. The bearing of a police officer role is carried out by a functional unit. A base of operations or organizational entity comprising law enforcement personnel. This entity serves as a physical or organizational location for police officers." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE_ORDER_CONSTRAINT> a skos:Concept ;
    skos:prefLabel "Order Constraint" ;
    skos:notation "3.1.23" ;
    skos:altLabel "ORDER_CONSTRAINT" ;
    skos:altLabel "Order Constraint" ;
    skos:altLabel "Sequence Rule" ;
    skos:altLabel "Positional Rule" ;
    skos:altLabel "Arrangement Constraint" ;
    skos:altLabel "Promotional Sequence Rule" ;
    skos:definition "This term encompasses rules that define the required sequence, position, or ordinal arrangement of items within promotional calendars, marketing campaigns, or scheduling systems. Practitioners apply it to classify organizational frameworks that specify item ordering requirements, positional dependencies, and sequence dependencies for promotional content deployment. A sequence position or ordinal rule is defined as a constraint that limits how items are arranged within a promotional calendar. When applied to a promotional calendar, a sequence position or ordinal rule limits the possible arrangements of items. Applies to rules that define the required sequence, position, or ordinal arrangement of items within promotional calendars, marketing campaigns, or scheduling systems." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_ORGANIZATION_MEMBER> a skos:Concept ;
    skos:prefLabel "Organization Member" ;
    skos:notation "5.66" ;
    skos:altLabel "ORGANIZATION_MEMBER" ;
    skos:altLabel "Organization Member" ;
    skos:altLabel "Organizational Participant" ;
    skos:altLabel "Member Entity" ;
    skos:altLabel "Organization Affiliates" ;
    skos:altLabel "Organizational Member" ;
    skos:altLabel "Member Role" ;
    skos:definition "Designates an individual or entity holding a formal membership role within an organization's structure. This entity represents the active affiliation of a participant with the organizational body. A role is held by an individual or entity that belongs to an organization. (Definitional) An individual or entity that is part of an organization holds a role. (Active/Relational-fronted) Applies to individuals or entities holding a formal membership role within an organization's structure." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_ORGANIZATIONAL_AGENT> a skos:Concept ;
    skos:prefLabel "Organizational Agent" ;
    skos:notation "2.2.80" ;
    skos:altLabel "ORGANIZATIONAL_AGENT" ;
    skos:altLabel "Corporate Agent" ;
    skos:altLabel "Business Representative" ;
    skos:altLabel "Organizational Actor" ;
    skos:altLabel "Company Representative" ;
    skos:altLabel "Institutional Agent" ;
    skos:definition "An agent acting on behalf of an organization during financial planning activities. This term identifies individuals or roles that execute financial planning tasks, such as budgeting, investment analysis, or fiscal strategy development, on behalf of an organization. An agent is defined as an entity that acts on behalf of an organization during financial planning activities. The agent performs actions on behalf of an organization throughout financial planning activities. Applies to agents acting on behalf of an organization during financial planning activities. Practitioners use this term when documenting roles responsible for budgeting, investment strategy, or fiscal decision-making within corporate or institutional settings." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_ORGANIZATIONAL_FUNCTION> a skos:Concept ;
    skos:prefLabel "Organizational Function" ;
    skos:notation "5.67" ;
    skos:altLabel "ORGANIZATIONAL_FUNCTION" ;
    skos:altLabel "Organizational Capability" ;
    skos:altLabel "Organizational Function" ;
    skos:altLabel "General Manager Function" ;
    skos:altLabel "Managerial Function" ;
    skos:definition "An organizational function is a capability of an organization that realizes the duties of a general manager. This capability directs organizational activities and resources. The function supports general manager duties and organizational operations. A capability of an organization is defined as the entity that realizes the duties of a general manager. The duties of a general manager are realized by a capability of an organization. An organizational function is a capability of an organization. This capability realizes the duties of a general manager." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_ORGANIZATIONAL_HEALTH_METRIC> a skos:Concept ;
    skos:prefLabel "Organizational Health Metric" ;
    skos:notation "0.43" ;
    skos:altLabel "ORGANIZATIONAL_HEALTH_METRIC" ;
    skos:altLabel "Organizational Health Metric" ;
    skos:altLabel "Workplace Health Measure" ;
    skos:altLabel "Employee Health Indicator" ;
    skos:altLabel "Organizational Wellbeing Metric" ;
    skos:altLabel "Workforce Health Metric" ;
    skos:definition "An organizational health metric quantifies employee wellbeing, workplace safety, or cultural health through structured survey data. The term encompasses indicators derived from employee feedback, engagement assessments, or health evaluations used to monitor workforce conditions and improve organizational performance. A health outcome measure is defined as any metric that is either derived from employee feedback surveys or applied to them. Employee feedback surveys serve as the source from which a health outcome measure is derived, or as the target to which that measure is applied. Applies when measuring employee wellbeing, workplace safety, or organizational culture through survey data. This term covers metrics derived from employee feedback, engagement surveys, or health assessments." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_ORGANIZATIONAL_LEADERSHIP_ROLE> a skos:Concept ;
    skos:prefLabel "Organizational Leadership Role" ;
    skos:notation "0.44" ;
    skos:altLabel "ORGANIZATIONAL_LEADERSHIP_ROLE" ;
    skos:altLabel "Organizational Leadership Role" ;
    skos:altLabel "Leadership Position" ;
    skos:altLabel "Management Role" ;
    skos:altLabel "Executive Role" ;
    skos:altLabel "Leadership Post" ;
    skos:definition "An organizational member role that is realized during executive leadership activities. This term applies to positions of authority within an organization that involve strategic decision-making and the direction of organizational activities. An organizational member role is a role that is realized during executive leadership activities. Executive leadership activities are the period during which an organizational member role is realized. Tracks the leadership role realized during executive leadership activities. Used to manage organizational hierarchy." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_OZONE_OXYGEN_MIXTURE> a skos:Concept ;
    skos:prefLabel "Ozone Oxygen Mixture" ;
    skos:notation "2.2.81" ;
    skos:altLabel "OZONE_OXYGEN_MIXTURE" ;
    skos:altLabel "Ozone-oxygen blend" ;
    skos:altLabel "Therapeutic ozone mix" ;
    skos:altLabel "Medical ozone preparation" ;
    skos:altLabel "Ozone therapy agent" ;
    skos:altLabel "Oxygen-ozone solution" ;
    skos:definition "A portion of oxidizer used as a therapeutic agent in ozone therapy sessions. This term refers to the specific gas mixture administered to patients for medical purposes. It is prepared and utilized in controlled clinical settings to deliver therapeutic benefits through ozone exposure. A therapeutic agent in ozone therapy sessions is defined as a portion of oxidizer. During ozone therapy sessions, the therapeutic agent administered is a specific portion of oxidizer. Applies to medical preparations containing a mixture of ozone and oxygen used in therapeutic treatments." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC_ACADEMIC_DEGREE> a skos:Concept ;
    skos:prefLabel "Academic Degree" ;
    skos:notation "3.6" ;
    skos:altLabel "ACADEMIC_DEGREE" ;
    skos:altLabel "AcademicDegree" ;
    skos:definition "An academic degree is a generically dependent continuant that signifies the completion of an academic curriculum program and is conferred by a higher education institution." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC_CALENDAR_PRODUCT> a skos:Concept ;
    skos:prefLabel "Calendar Product" ;
    skos:notation "3.7" ;
    skos:altLabel "CALENDAR_PRODUCT" ;
    skos:altLabel "CalendarProduct" ;
    skos:definition "A calendar product is classified as a generically dependent continuant that implements a calendar system and specifies temporal references for calendar months. The implementation of a calendar system and the specification of temporal references for calendar months characterize a calendar product as a generically dependent continuant. Any generically dependent continuant that implements a calendar system and specifies temporal references for calendar months qualifies as a calendar product." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_CALL_VOLUME> a skos:Concept ;
    skos:prefLabel "Call Volume" ;
    skos:notation "4.7" ;
    skos:altLabel "CALL_VOLUME" ;
    skos:altLabel "CallVolume" ;
    skos:definition "Call volume is a quality that measures the number of telephone calls occurring within a specified period." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CHILD> a skos:Concept ;
    skos:prefLabel "Child" ;
    skos:notation "2.2.82" ;
    skos:altLabel "CHILD" ;
    skos:altLabel "Child" ;
    skos:definition "A child denotes a person situated in the early developmental stage of life who possesses at least one biological parent. Every person who occupies the early developmental stage of life and possesses at least one biological parent is classified as a child. A child is defined as a person situated in the early developmental stage of life who possesses at least one biological parent." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CLINICAL_CARE> a skos:Concept ;
    skos:prefLabel "Clinical Care" ;
    skos:notation "1.123" ;
    skos:altLabel "CLINICAL_CARE" ;
    skos:altLabel "ClinicalCare" ;
    skos:definition "Clinical care denotes a process wherein a clinician delivers medical services to a patient for the purpose of diagnosing, treating, or preventing disease. When a clinician administers medical services to a patient with the aim of diagnosing, treating, or preventing disease, the resulting activity constitutes a process known as clinical care. In the process of clinical care, a clinician supplies medical services to a patient specifically to diagnose, treat, or prevent disease." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_COMMUNICATION_SECURITY_ASPECT> a skos:Concept ;
    skos:prefLabel "Communication Security Aspect" ;
    skos:notation "4.8" ;
    skos:altLabel "COMMUNICATION_SECURITY_ASPECT" ;
    skos:altLabel "CommunicationSecurityAspect" ;
    skos:definition "A communication security aspect constitutes a quality associated with a communication channel that ensures the security of a communication system. Pertaining to a communication channel, a communication security aspect serves as a quality that ensures the security of a communication system. The security of a communication system is ensured by a communication security aspect, which is a quality pertaining to a communication channel." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC_CONSTRUCTED_PREDICATE> a skos:Concept ;
    skos:prefLabel "Constructed Predicate" ;
    skos:notation "3.8" ;
    skos:altLabel "CONSTRUCTED_PREDICATE" ;
    skos:altLabel "ConstructedPredicate" ;
    skos:definition "A constructed predicate is a generically dependent continuant that encodes a logical relation from a prescriptive information entity and applies to a constructed feature. (Too similar to original) Any entity classified as a constructed predicate functions as a generically dependent continuant that encodes a logical relation originating from a prescriptive information entity and applies to a constructed feature. When encoding a logical relation derived from a prescriptive information entity and applying to a constructed feature, a constructed predicate operates as a generically dependent continuant." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CONTINUOUS_EMISSIONS_MONITORING_PROCESS> a skos:Concept ;
    skos:prefLabel "Continuous Emissions Monitoring Process" ;
    skos:notation "1.124" ;
    skos:altLabel "CONTINUOUS_EMISSIONS_MONITORING_PROCESS" ;
    skos:altLabel "ContinuousEmissionsMonitoringProcess" ;
    skos:definition "A continuous emissions monitoring process is classified as a sensing process that continuously monitors emissions originating from an industrial emission source. Emissions from an industrial emission source are continuously monitored by the continuous emissions monitoring process, which operates as a sensing process. The continuous emissions monitoring process functions as a sensing process that performs continuous monitoring of emissions released by an industrial emission source." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CORPORATE_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Corporate Activity" ;
    skos:notation "0.45" ;
    skos:altLabel "CORPORATE_ACTIVITY" ;
    skos:altLabel "CorporateActivity" ;
    skos:definition "Corporate activity constitutes an organizational activity performed by a commercial organization to further its business objectives." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CORPORATE_AUDIT_PROCESS> a skos:Concept ;
    skos:prefLabel "Corporate Audit Process" ;
    skos:notation "1.125" ;
    skos:altLabel "CORPORATE_AUDIT_PROCESS" ;
    skos:altLabel "CorporateAuditProcess" ;
    skos:definition "A corporate audit process is defined as a procedure that examines the records of a commercial organization and verifies compliance with established audit methodologies. The corporate audit process performs two functions: it examines the records of a commercial organization and verifies compliance with established audit methodologies. Examination of the records of a commercial organization and verification of compliance with established audit methodologies constitute the corporate audit process." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CORPORATE_EMPLOYMENT_PROCESS> a skos:Concept ;
    skos:prefLabel "Corporate Employment Process" ;
    skos:notation "1.126" ;
    skos:altLabel "CORPORATE_EMPLOYMENT_PROCESS" ;
    skos:altLabel "CorporateEmploymentProcess" ;
    skos:definition "A corporate employment process constitutes an organizational act of employment that engages a commercial agent and yields a corporate employee role. An act of employment carried out by an organization, which includes a commercial agent, constitutes a corporate employment process that produces a corporate employee role. The corporate employment process proceeds as an organizational act of employment involving a commercial agent, culminating in a corporate employee role." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_CORPORATE_REPUTATION> a skos:Concept ;
    skos:prefLabel "Corporate Reputation" ;
    skos:notation "4.9" ;
    skos:altLabel "CORPORATE_REPUTATION" ;
    skos:altLabel "CorporateReputation" ;
    skos:definition "Corporate reputation denotes a quality that reflects the perception of a commercial organization and is held by stakeholder roles. The perception of a commercial organization is reflected by a quality called corporate reputation, which is held by stakeholder roles. Stakeholder roles hold the quality known as corporate reputation, reflecting the perception of a commercial organization." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC_COURSE> a skos:Concept ;
    skos:prefLabel "Course" ;
    skos:notation "3.9" ;
    skos:altLabel "COURSE" ;
    skos:altLabel "Course" ;
    skos:definition "A course is a generically dependent continuant that constitutes a structured educational program with a defined curriculum and is delivered by a higher education institution." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CRIMINAL_JUSTICE_PROCESS> a skos:Concept ;
    skos:prefLabel "Criminal Justice Process" ;
    skos:notation "0.46" ;
    skos:altLabel "CRIMINAL_JUSTICE_PROCESS" ;
    skos:altLabel "CriminalJusticeProcess" ;
    skos:definition "A criminal justice process is a process that is realized within an administration process. The realization of a criminal justice process occurs in an administration process. An administration process is the process in which a criminal justice process is realized." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CUSTOMER_DEVICE> a skos:Concept ;
    skos:prefLabel "Customer Device" ;
    skos:notation "2.2.83" ;
    skos:altLabel "CUSTOMER_DEVICE" ;
    skos:altLabel "CustomerDevice" ;
    skos:definition "The substitution of realized_in with has_continuant_part was executed to align with the continuant range constraint when relating devices to networks. When relating devices to networks, the required continuant range is satisfied by replacing realized_in with has_continuant_part. The relation realized_in is superseded by has_continuant_part so that the continuant range matches the requirement for linking devices to networks." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_DATABASE_CONTAINER> a skos:Concept ;
    skos:prefLabel "Database Container" ;
    skos:notation "2.2.84" ;
    skos:altLabel "DATABASE_CONTAINER" ;
    skos:altLabel "DatabaseContainer" ;
    skos:definition "A container functions as a storage unit located within a cloud storage volume. Storage operations within a cloud storage volume are executed by means of a container. Within a cloud storage volume, a container fulfills a storage function." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_DECISION_ACTION> a skos:Concept ;
    skos:prefLabel "Decision Action" ;
    skos:notation "0.47" ;
    skos:altLabel "DECISION_ACTION" ;
    skos:definition "This concept is defined as an action that constitutes a constituent element within a decision-making process. A decision-making process is composed of an action that functions as one of its constituent segments. The framework positions an action as a constituent segment within the progression of a decision-making process." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_DECISION_TRANSITION_ACTION> a skos:Concept ;
    skos:prefLabel "Decision Transition Action" ;
    skos:notation "0.48" ;
    skos:altLabel "DECISION_TRANSITION_ACTION" ;
    skos:altLabel "DecisionTransitionAction" ;
    skos:definition "A decision transition action constitutes an occurrent process that is realized within a decision making process. A decision making process realizes an occurrent process classified as a decision transition action. The occurrent process instantiated within a decision making process is identified as a decision transition action." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_DIAGNOSTIC_IMAGING> a skos:Concept ;
    skos:prefLabel "Diagnostic Imaging" ;
    skos:notation "1.127" ;
    skos:altLabel "DIAGNOSTIC_IMAGING" ;
    skos:altLabel "DiagnosticImaging" ;
    skos:definition "The term designates a class of processes that serve diagnostic purposes and are enabled by imaging equipment. Imaging equipment facilitates processes that are directed toward diagnostic purposes. A process qualifies under this category when imaging equipment facilitates it for diagnostic purposes." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_ETHICAL_INVESTMENT> a skos:Concept ;
    skos:prefLabel "Ethical Investment" ;
    skos:notation "1.128" ;
    skos:altLabel "ETHICAL_INVESTMENT" ;
    skos:altLabel "EthicalInvestment" ;
    skos:definition "A financial activity is defined as an entity whose purpose is an ethical investment asset. The purpose directed by a financial activity is an ethical investment asset. A financial activity must have an ethical investment asset as its purpose." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE_ETHICAL_STANDARD> a skos:Concept ;
    skos:prefLabel "Ethical Standard" ;
    skos:notation "3.2.13" ;
    skos:altLabel "ETHICAL_STANDARD" ;
    skos:altLabel "EthicalStandard" ;
    skos:definition "A quality specification that serves as a standard for an ethical requirement." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_EXECUTIVE_DIRECTION> a skos:Concept ;
    skos:prefLabel "Executive Direction" ;
    skos:notation "1.129" ;
    skos:altLabel "EXECUTIVE_DIRECTION" ;
    skos:altLabel "ExecutiveDirection" ;
    skos:definition "A process is defined as a responsibility assigned to an executive director function. The executive director function holds responsibility for a process. Any process classified as a responsibility must belong to an executive director function." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_EXECUTIVE_IMPLEMENTATION> a skos:Concept ;
    skos:prefLabel "Executive Implementation" ;
    skos:notation "1.130" ;
    skos:altLabel "EXECUTIVE_IMPLEMENTATION" ;
    skos:altLabel "ExecutiveImplementation" ;
    skos:definition "The purpose of an executive execution function is constituted by a process. An executive execution function designates a process to act as its purpose. A process is characterized as the purpose fulfilled by an executive execution function." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_EXECUTIVE_LEADERSHIP_ROLE> a skos:Concept ;
    skos:prefLabel "Executive Leadership Role" ;
    skos:notation "0.49" ;
    skos:altLabel "EXECUTIVE_LEADERSHIP_ROLE" ;
    skos:altLabel "ExecutiveLeadershipRole" ;
    skos:definition "An executive leadership role is classified as an organizational leadership role and is characterized by containing at least one executive leadership process as a member. Every executive leadership role, serving as an organizational leadership role, maintains a member relationship with at least one executive leadership process. To qualify as an executive leadership role, an entity must first function as an organizational leadership role and must include at least one executive leadership process as a member." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_EXTERNAL_BUSINESS_PARTNER> a skos:Concept ;
    skos:prefLabel "External Business Partner" ;
    skos:notation "5.68" ;
    skos:altLabel "EXTERNAL_BUSINESS_PARTNER" ;
    skos:altLabel "ExternalBusinessPartner" ;
    skos:definition "An interpersonal relationship role is defined by its connection to an external agency and its participation in market exchange with an independent economic agent. To qualify as this type of interpersonal relationship role, the role must maintain a relationship with an external agency and conduct market exchange with an independent economic agent. An external agency relates to an interpersonal relationship role, which simultaneously engages in market exchange with an independent economic agent." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_FINANCIAL_INSTRUMENT> a skos:Concept ;
    skos:prefLabel "Financial Instrument" ;
    skos:notation "0.50" ;
    skos:altLabel "FINANCIAL_INSTRUMENT" ;
    skos:altLabel "FinancialInstrument" ;
    skos:altLabel "ClearingFunction" ;
    skos:definition "A financial instrument constitutes a specific category of financial product defined by its realization of a clearing function. The clearing function is realized by a financial instrument, which operates as a type of financial product. A financial product is designated as a financial instrument upon the realization of a clearing function." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_FINANCIAL_STRATEGY_OVERSIGHT> a skos:Concept ;
    skos:prefLabel "Financial Strategy Oversight" ;
    skos:notation "0.51" ;
    skos:altLabel "FINANCIAL_STRATEGY_OVERSIGHT" ;
    skos:altLabel "FinancialStrategyOversight" ;
    skos:definition "A process classified under this category is defined by its participation within a financial management process. When modeling this entity, treat it as a process that participates in a financial management process. A process classified under this term is defined by its participation within a financial management process." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_HIGHER_EDUCATION_INSTITUTION> a skos:Concept ;
    skos:prefLabel "Higher Education Institution" ;
    skos:notation "2.2.85" ;
    skos:altLabel "HIGHER_EDUCATION_INSTITUTION" ;
    skos:altLabel "HigherEducationInstitution" ;
    skos:definition "An entity is classified as an educational organization that confers academic degrees if and only if it functions as an educational organization and confers academic degrees. (Definitional) Verification of an educational organization that confers academic degrees requires confirming that the entity operates as an educational organization and confers academic degrees. (Procedural)" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_INSTITUTIONAL_INVESTOR> a skos:Concept ;
    skos:prefLabel "Institutional Investor" ;
    skos:notation "2.2.86" ;
    skos:altLabel "INSTITUTIONAL_INVESTOR" ;
    skos:altLabel "InstitutionalInvestor" ;
    skos:definition "A material entity is defined as a material entity that provides investor funding for financial situations. The provision of investor funding for financial situations is performed by a material entity. Investor funding for financial situations is supplied by a material entity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_LEGAL_PROCEEDING> a skos:Concept ;
    skos:prefLabel "Legal Proceeding" ;
    skos:notation "1.131" ;
    skos:altLabel "LEGAL_PROCEEDING" ;
    skos:altLabel "LegalProceeding" ;
    skos:definition "A legal system act is defined as an act that involves court documents. Court documents are involved in a legal system act. Involvement with court documents characterizes a legal system act." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_NETWORK_USER> a skos:Concept ;
    skos:prefLabel "Network User" ;
    skos:notation "2.2.87" ;
    skos:altLabel "NETWORK_USER" ;
    skos:altLabel "NetworkUser" ;
    skos:definition "A material entity is characterized by its use of a computer network. The use of a computer network applies to a material entity. Identification of a material entity relies on its use of a computer network." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_DISPOSITION_OBSERVATION_FUNCTION> a skos:Concept ;
    skos:prefLabel "Observation Function" ;
    skos:notation "6.4" ;
    skos:altLabel "OBSERVATION_FUNCTION" ;
    skos:altLabel "ObservationFunction" ;
    skos:definition "An observation artifact function that enables visible observation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_DISPOSITION> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_ORGANIZATION> a skos:Concept ;
    skos:prefLabel "Organization" ;
    skos:notation "2.2.88" ;
    skos:altLabel "ORGANIZATION" ;
    skos:altLabel "Organization" ;
    skos:definition "A material entity is defined as an entity that possesses organization members. Organization members are possessed by a material entity. A material entity maintains organization members within its scope." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_ORGANIZATIONAL_CULTURE> a skos:Concept ;
    skos:prefLabel "Organizational Culture" ;
    skos:notation "0.52" ;
    skos:altLabel "ORGANIZATIONAL_CULTURE" ;
    skos:altLabel "OrganizationalCulture" ;
    skos:definition "An organization capability that inheres in an organization." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_ORIGINAL_DOCUMENT> a skos:Concept ;
    skos:prefLabel "Original Document" ;
    skos:notation "3.0.50" ;
    skos:altLabel "ORIGINAL_DOCUMENT" ;
    skos:altLabel "OriginalDocument" ;
    skos:definition "A document content entity is defined as the source of information content for a copied document. The source of information content for a copied document is a document content entity. A document content entity serves as the source of information content for a copied document." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_PDF_FORMAT> a skos:Concept ;
    skos:prefLabel "Pdf Format" ;
    skos:notation "4.10" ;
    skos:altLabel "PDF_FORMAT" ;
    skos:altLabel "PdfFormat" ;
    skos:definition "A quality is defined by its application to a PDF document. A PDF document is the entity that receives application from a quality. A quality applies to a PDF document." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_PERSONALLY_IDENTIFIABLE_INFORMATION> a skos:Concept ;
    skos:prefLabel "Personally Identifiable Information" ;
    skos:notation "3.0.51" ;
    skos:altLabel "PERSONALLY_IDENTIFIABLE_INFORMATION" ;
    skos:altLabel "PersonallyIdentifiableInformation" ;
    skos:definition "An information content entity serves as the means by which a person is identified. The identification of a person is performed by an information content entity. An information content entity must function to identify a person." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_POPULATION> a skos:Concept ;
    skos:prefLabel "Population" ;
    skos:notation "2.2.89" ;
    skos:altLabel "POPULATION" ;
    skos:altLabel "Population" ;
    skos:definition "A collection of persons is defined as this class when it functions as the subject of a prevalence rate. The subject of a prevalence rate is identified as a group of persons. A set of individuals is classified as this entity by assuming the role of subject for a prevalence rate." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_PROFESSIONAL_EXPERIENCE> a skos:Concept ;
    skos:prefLabel "Professional Experience" ;
    skos:notation "1.132" ;
    skos:altLabel "PROFESSIONAL_EXPERIENCE" ;
    skos:altLabel "ProfessionalExperience" ;
    skos:definition "A process is defined as any entity that necessarily incorporates professional practice. Any process must satisfy the requirement of encompassing professional practice." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_QUALIFICATION_LEVEL> a skos:Concept ;
    skos:prefLabel "Qualification Level" ;
    skos:notation "3.0.52" ;
    skos:altLabel "QUALIFICATION_LEVEL" ;
    skos:altLabel "QualificationLevel" ;
    skos:definition "An academic degree is characterized by its indication of statistical significance. Indication of statistical significance is a defining attribute of an academic degree. An academic degree indicates statistical" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_RAFFLE> a skos:Concept ;
    skos:prefLabel "Raffle" ;
    skos:notation "1.133" ;
    skos:altLabel "RAFFLE" ;
    skos:altLabel "Raffle" ;
    skos:definition "A process that distributes prizes via lot numbers is a procedure defined by its distribution of prizes via lot numbers. (Definitional) This procedure operates by distributing prizes via lot numbers. (Procedural) A process that distributes prizes via lot numbers is a procedure defined by its distribution of prizes via lot numbers." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY_PRIM_AGE> a skos:Concept ;
    skos:prefLabel "Age" ;
    skos:notation "4.11" ;
    skos:altLabel "PRIM_AGE" ;
    skos:altLabel "Age" ;
    skos:definition "A temporal quality is defined as the measure of how long existence has persisted from a designated starting point. The duration of existence from a designated starting point is quantified by a temporal quality. A temporal quality is mandated to measure the length of existence originating from a particular starting point." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_QUALITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_PRIM_CONTINUOUSMODE> a skos:Concept ;
    skos:prefLabel "Continuous Mode" ;
    skos:notation "5.69" ;
    skos:altLabel "PRIM_CONTINUOUSMODE" ;
    skos:altLabel "ContinuousMode" ;
    skos:definition "A monitoring system sustains uninterrupted operation across the specified interval by assuming this role." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_PRIM_RISKMANAGEMENTACTIVITY> a skos:Concept ;
    skos:prefLabel "Risk Management Activity" ;
    skos:notation "0.53" ;
    skos:altLabel "PRIM_RISKMANAGEMENTACTIVITY" ;
    skos:altLabel "RiskManagementActivity" ;
    skos:definition "A corporate process is defined as the identification, assessment, and mitigation of potential hazards or uncertainties. The corporate process operates by identifying, assessing, and mitigating potential hazards or uncertainties. Potential hazards or uncertainties are subject to identification, assessment, and mitigation within a corporate process." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_PRIM_CHEMICAL> a skos:Concept ;
    skos:prefLabel "Chemical" ;
    skos:notation "2.2.90" ;
    skos:altLabel "PRIM_CHEMICAL" ;
    skos:altLabel "Chemical" ;
    skos:definition "A material entity consists exclusively of either a chemical substance or a mixture. When categorizing a material entity, assign it the type chemical substance or the type mixture. Every material entity must be identified as either a chemical substance or a mixture." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC_PRIM_SCHOOLSECURITYPOLICY> a skos:Concept ;
    skos:prefLabel "School Security Policy" ;
    skos:notation "3.10" ;
    skos:altLabel "PRIM_SCHOOLSECURITYPOLICY" ;
    skos:altLabel "SchoolSecurityPolicy" ;
    skos:definition "A specifically dependent continuant specifies rules and procedures for security within a school environment. (Simple declarative) Rules and procedures for security within a school environment are specified by a specifically dependent continuant. (Passive/relational-fronted) The specification of rules and procedures for security within a school environment is assigned to a specifically dependent continuant. (Nominalized/procedural)" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_PRIM_SCIENTIFICORGANIZATION> a skos:Concept ;
    skos:prefLabel "Scientific Organization" ;
    skos:notation "2.2.91" ;
    skos:altLabel "PRIM_SCIENTIFICORGANIZATION" ;
    skos:altLabel "ScientificOrganization" ;
    skos:definition "An organization qualifies under this definition when its principal aim is either conducting or supporting scientific research and development. To be classified as such, an organization must have its main objective directed toward carrying out or backing scientific research and development. The primary purpose of an organization is established as conducting or supporting scientific research and development." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC_PRIM_SERVICELEVELAGREEMENT> a skos:Concept ;
    skos:prefLabel "Service Level Agreement" ;
    skos:notation "3.11" ;
    skos:altLabel "PRIM_SERVICELEVELAGREEMENT" ;
    skos:altLabel "ServiceLevelAgreement" ;
    skos:definition "A specifically dependent continuant is an entity that establishes the expected service metrics, responsibilities, and standards governing the relationship between a service provider and a client. The expected service metrics, responsibilities, and standards between a service provider and a client are defined by a specifically dependent continuant. When specifying the expected service metrics, responsibilities, and standards between a service provider and a client, a specifically dependent continuant serves as the defining element." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_PRIM_STATEACTION> a skos:Concept ;
    skos:prefLabel "State Action" ;
    skos:notation "1.134" ;
    skos:altLabel "PRIM_STATEACTION" ;
    skos:altLabel "StateAction" ;
    skos:definition "StateAction derives its basis as an Act of Government. An Act of Government serves as the ground for StateAction. Grounding StateAction means classifying it as an Act of Government. (Adds \"classifying\" - risky)" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_PRIM_TARIFFSTRUCTURE> a skos:Concept ;
    skos:prefLabel "Tariff Structure" ;
    skos:notation "0.54" ;
    skos:altLabel "PRIM_TARIFFSTRUCTURE" ;
    skos:altLabel "TariffStructure" ;
    skos:definition "TariffStructure is defined structurally as a CatalogStructure. The structural grounding relation places TariffStructure within the CatalogStructure classification. TariffStructure is formally established as a CatalogStructure through structural grounding." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_DISPOSITION_PRIM_VULNERABILITYSTATE> a skos:Concept ;
    skos:prefLabel "Vulnerability State" ;
    skos:notation "6.5" ;
    skos:altLabel "PRIM_VULNERABILITYSTATE" ;
    skos:altLabel "VulnerabilityState" ;
    skos:definition "VulnerabilityState is defined by its status as a Vulnerability grounded in the ontology. The system establishes VulnerabilityState by grounding it as a Vulnerability. Grounding as a Vulnerability serves as the basis for VulnerabilityState." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_DISPOSITION> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_PRIM_SKILLIMPROVEMENT> a skos:Concept ;
    skos:prefLabel "Skill Improvement" ;
    skos:notation "1.135" ;
    skos:altLabel "PRIM_SKILLIMPROVEMENT" ;
    skos:altLabel "SkillImprovement" ;
    skos:definition "`SkillImprovement` is defined as a precise subtype of quality increase, corresponding to the enhancement of an individual's capabilities. The enhancement of an individual's capabilities is represented through `SkillImprovement`, which constitutes a specific form of increased quality. `SkillImprovement` stands as a formally recognized category of quality increase, structurally representing the enhancement of an individual's capabilities." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

