@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sdg:  <https://signals.zndx.org/sdg#> .

<https://signals.zndx.org/sdg/scheme> a skos:ConceptScheme ;
    skos:prefLabel "SDG column-type vocabulary (ontology-derived)" .

<https://signals.zndx.org/sdg#SDG_PROCESS> a skos:Concept ;
    skos:prefLabel "Process" ;
    skos:notation "1" ;
    skos:altLabel "PROC" ;
    skos:definition "A BFO process (occurrent): an entity that unfolds in time, e.g. an observation, a program execution, a governance activity." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> a skos:Concept ;
    skos:prefLabel "Independent Continuant" ;
    skos:notation "2" ;
    skos:altLabel "INDCONT" ;
    skos:definition "A BFO independent continuant: a bearer of qualities that persists through time." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ARTIFACT> a skos:Concept ;
    skos:prefLabel "Artifact" ;
    skos:notation "2.1" ;
    skos:altLabel "ARTIFACT" ;
    skos:definition "A CCO artifact: an object intentionally made to realize a function (instruments, systems, datasets-as-objects)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC> a skos:Concept ;
    skos:prefLabel "Generically Dependent Continuant" ;
    skos:notation "3" ;
    skos:altLabel "GDC" ;
    skos:definition "A BFO generically dependent continuant: a continuant that depends on one or more bearers and can migrate between them (information, patterns, designs)." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE> a skos:Concept ;
    skos:prefLabel "Information Content Entity" ;
    skos:notation "3.0" ;
    skos:altLabel "ICE" ;
    skos:definition "A CCO information content entity: a generically dependent continuant that is about, or carries information concerning, some entity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_QUALITY> a skos:Concept ;
    skos:prefLabel "Quality" ;
    skos:notation "4" ;
    skos:altLabel "QUAL" ;
    skos:definition "A BFO quality: a specifically dependent continuant that is exhibited whenever its bearer exists (a measurable/observable attribute)." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE> a skos:Concept ;
    skos:prefLabel "Role" ;
    skos:notation "5" ;
    skos:altLabel "ROLE" ;
    skos:definition "A BFO role: a realizable specifically dependent continuant a bearer has in virtue of external circumstances (physician role, foreign-key role)." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_DISPOSITION> a skos:Concept ;
    skos:prefLabel "Disposition" ;
    skos:notation "6" ;
    skos:altLabel "DISP" ;
    skos:definition "A BFO disposition: a realizable entity grounded in the bearer's physical make-up (a capacity or tendency to be realized in a process)." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> a skos:Concept ;
    skos:prefLabel "Material Entity" ;
    skos:notation "2.2" ;
    skos:altLabel "MATENT" ;
    skos:definition "A BFO material entity: an independent continuant that has matter as a part." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_INDEPENDENT_CONTINUANT> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> a skos:Concept ;
    skos:prefLabel "Descriptive Information Content Entity" ;
    skos:notation "3.1" ;
    skos:altLabel "DESCICE" ;
    skos:definition "An ICE that describes an entity or state of affairs (measurements, records, observations)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> a skos:Concept ;
    skos:prefLabel "Directive Information Content Entity" ;
    skos:notation "3.2" ;
    skos:altLabel "DIRICE" ;
    skos:definition "An ICE that prescribes or directs (plans, rules, requirements, policies)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> a skos:Concept ;
    skos:prefLabel "Designative Information Content Entity" ;
    skos:notation "3.3" ;
    skos:altLabel "DESIGICE" ;
    skos:definition "An ICE that designates or names an entity (identifiers, codes, keys)." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC> a skos:Concept ;
    skos:prefLabel "Generic Entity" ;
    skos:notation "0" ;
    skos:altLabel "GENERIC" ;
    skos:definition "Foundational / domain-agnostic axiom patterns without a specific BFO/CCO anchor." ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_PARENTING_ROLE> a skos:Concept ;
    skos:prefLabel "Parenting Role" ;
    skos:notation "5.1" ;
    skos:altLabel "PARENTING_ROLE" ;
    skos:altLabel "ParentingRole" ;
    skos:altLabel "DisabledAdult" ;
    skos:altLabel "ParentingActivity" ;
    skos:definition "A ParentingRole is a role that inheresIn exactly one DisabledAdult and realizes some ParentingActivity." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

