    skos:altLabel "Vertical Extent Measurement" ;
    skos:altLabel "Height Quantification" ;
    skos:altLabel "Vertical Dimension Measure" ;
    skos:altLabel "Height Data Point" ;
    skos:definition "A measurement unit that quantifies the vertical extent or height of an entity. This concept captures the physical distance from the base to the top of an object or structure, as recorded by precision instruments like laser levels or calipers. Applies to the measurement of vertical dimensions in manufacturing, construction, and physics contexts." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE_FILLER_HORSEIDENTITY> a skos:Concept ;
