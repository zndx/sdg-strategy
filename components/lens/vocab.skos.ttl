    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_CLEARING_PROCESS> a skos:Concept ;
    skos:prefLabel "Clearing Process" ;
    skos:notation "1.93" ;
    skos:altLabel "CLEARING_PROCESS" ;
    skos:altLabel "settlement process" ;
    skos:altLabel "financial clearing" ;
    skos:altLabel "instrument clearance" ;
    skos:altLabel "trade settlement" ;
    skos:altLabel "financial processing" ;
    skos:altLabel "clearing operation" ;
    skos:definition "This term describes the procedural mechanism through which financial instruments are processed and validated. It involves the systematic handling of instruments to ensure accurate recording and completion of financial transactions. The term emphasizes the active role of the process in managing the lifecycle of financial instruments from initiation to resolution. Applies to financial workflows where instruments are validated, reconciled, and finalized for settlement." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CLIENT> a skos:Concept ;
    skos:prefLabel "Client" ;
    skos:notation "2.2.8" ;
    skos:altLabel "CLIENT" ;
    skos:altLabel "service recipient" ;
    skos:altLabel "client agent" ;
    skos:altLabel "advice recipient" ;
    skos:altLabel "financial service user" ;
    skos:definition "An agent that receives a financial product advice service. This entity engages in the consumption of advisory services provided by financial professionals. The entity participates in the transaction where financial product advice flows to the recipient. An agent is defined as an entity that receives a financial product advice service. A financial product advice service is received by an agent. An agent that receives a financial product advice service. This entity engages in the consumption of advisory services provided by financial professionals." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE_CLIENT_PROFILE> a skos:Concept ;
    skos:prefLabel "Client Profile" ;
    skos:notation "3.3.2" ;
    skos:altLabel "CLIENT_PROFILE" ;
    skos:altLabel "Client Profile" ;
    skos:altLabel "Customer Profile" ;
    skos:altLabel "Client Information Record" ;
    skos:altLabel "Client Account Profile" ;
    skos:altLabel "Customer Information Profile" ;
    skos:altLabel "Client Data Profile" ;
    skos:definition "A process profile entity containing structured information about a specific network user or client relationship. This profile aggregates client data including contact information, service preferences, transaction history, and interaction records. The entity serves as a centralized information resource for client management and service delivery operations. A process profile is defined as an entity that represents or relates to a specific network user or client. (Definitional) Representation or relation to a specific network user or client characterizes a process profile. (Relational-fronted) Applies to process profiles that document and represent information about specific network users or clients. This term encompasses structured information records used by organizations to manage client relationships and service delivery." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CLINICAL_PERFORMANCE_DATA> a skos:Concept ;
    skos:prefLabel "Clinical Performance Data" ;
    skos:notation "0.7" ;
    skos:altLabel "CLINICAL_PERFORMANCE_DATA" ;
    skos:altLabel "Clinical Performance Metrics" ;
    skos:altLabel "Health Outcome Tracking Data" ;
    skos:altLabel "Clinical Quality Data" ;
    skos:altLabel "Performance Evaluation Data" ;
    skos:definition "This term represents the raw and aggregated numerical records that quantify health outcomes and clinical processes. It includes the specific measurements, timestamps, and patient identifiers that support ongoing performance reviews and resource allocation decisions. Clinical quality data is defined as the information that measures or monitors health outcome metrics specifically for performance evaluation. Health outcome metrics are quantified or tracked through clinical quality data to facilitate performance evaluation. Applied to datasets used by hospital administrators, clinical directors, and quality assurance teams to evaluate staff efficiency, patient recovery rates, and treatment success." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CLINICAL_SYSTEM> a skos:Concept ;
    skos:prefLabel "Clinical System" ;
    skos:notation "2.2.9" ;
    skos:altLabel "CLINICAL_SYSTEM" ;
    skos:altLabel "Clinical System" ;
    skos:altLabel "Clinical Care System" ;
    skos:altLabel "Healthcare Infrastructure" ;
    skos:altLabel "Clinical Service System" ;
    skos:altLabel "Medical Care System" ;
    skos:altLabel "Clinical Infrastructure" ;
    skos:definition "Designates an infrastructure system dedicated to delivering clinical care services and supporting medical operations. This entity encompasses the technological and physical resources enabling patient care delivery. Used to describe infrastructure systems dedicated to delivering clinical care services and supporting medical operations." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CLOUD_STORAGE_VOLUME> a skos:Concept ;
    skos:prefLabel "Cloud Storage Volume" ;
    skos:notation "2.2.10" ;
    skos:altLabel "CLOUD_STORAGE_VOLUME" ;
    skos:altLabel "Cloud Storage Volume" ;
    skos:altLabel "Database Storage Allocation" ;
    skos:altLabel "Cloud Database Partition" ;
    skos:altLabel "Virtual Storage Container" ;
    skos:altLabel "Cloud Data Volume" ;
    skos:definition "A digital storage device partition or allocation used to hold database containers in a cloud environment. This entity represents the allocated capacity and configuration of a cloud storage volume specifically dedicated to hosting database instances and their associated data files. A digital storage device partition or allocation is a cloud environment resource that holds database containers. (resource is implied by storage device partition/allocation) A digital storage device partition or allocation is a cloud Applies to cloud infrastructure configurations where database containers are stored on virtualized storage disks." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_COLLATERAL_EXCHANGE_PROCESS> a skos:Concept ;
    skos:prefLabel "Collateral Exchange Process" ;
    skos:notation "1.94" ;
    skos:altLabel "COLLATERAL_EXCHANGE_PROCESS" ;
    skos:altLabel "collateral exchange process" ;
    skos:altLabel "collateral swap" ;
    skos:altLabel "asset collateral exchange" ;
    skos:altLabel "collateral transfer act" ;
    skos:altLabel "margin collateral exchange" ;
    skos:definition "A financial deposit process that involves the corresponding withdrawal or exchange of collateral assets. This process manages the movement of pledged assets between parties to maintain required collateral levels. It ensures proper accounting and transfer of financial instruments during the exchange transaction. A financial deposit process is defined as an operation that involves the corresponding withdrawal or exchange of collateral assets. The corresponding withdrawal or exchange of collateral assets is involved in a financial deposit process. A financial deposit process that involves the corresponding withdrawal or exchange of collateral assets. This process manages the movement of pledged assets between parties to maintain required collateral levels." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_COLLEGE_ADMINISTRATION> a skos:Concept ;
    skos:prefLabel "College Administration" ;
    skos:notation "2.2.11" ;
    skos:altLabel "COLLEGE_ADMINISTRATION" ;
    skos:altLabel "higher education administration" ;
    skos:altLabel "college management body" ;
    skos:altLabel "university governance structure" ;
    skos:altLabel "institutional administration" ;
    skos:altLabel "academic administration" ;
    skos:altLabel "college governing body" ;
    skos:definition "An organization that manages a higher education institution. This organizational body directs the daily operations, strategic planning, and governance of the university or college. A higher education institution is managed and governed by an organizational body that holds that responsibility. The entity that manages and governs a higher education institution constitutes an organizational body. An organizational body responsible for the management and governance of a higher education institution. This structure oversees institutional operations, policy implementation, and academic standards." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_COLLEGE_COMMUNITY_MEMBER> a skos:Concept ;
    skos:prefLabel "College Community Member" ;
    skos:notation "2.2.12" ;
    skos:altLabel "COLLEGE_COMMUNITY_MEMBER" ;
    skos:altLabel "College Community Member" ;
    skos:altLabel "Educational Organization Member" ;
    skos:altLabel "College Member" ;
    skos:altLabel "University Member" ;
    skos:altLabel "Student/Faculty Member" ;
    skos:definition "An organization member who holds membership within an educational organization or college community. This role encompasses individuals participating in the academic and administrative functions of the institution. An organization member is defined as an entity that maintains membership within an educational organization or college community. Membership within an educational organization or college community constitutes the defining attribute of an organization member. This term denotes an organization member who holds membership within an educational organization or college community." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_COLLEGE_OFFICIAL> a skos:Concept ;
    skos:prefLabel "College Official" ;
    skos:notation "0.8" ;
    skos:altLabel "COLLEGE_OFFICIAL" ;
    skos:altLabel "College Official" ;
    skos:altLabel "Higher Education Official" ;
    skos:altLabel "University Official" ;
    skos:altLabel "Academic Official" ;
    skos:altLabel "College Staff Official" ;
    skos:altLabel "University Administrator" ;
    skos:definition "A staff member occupying an official administrative or academic position within a higher education institution. This role encompasses individuals holding formal positions in college governance, academic administration, or institutional leadership. The staff member performs official duties associated with their designated position within the educational institution. A staff member is an individual defined by the possession of an official administrative or academic position within a higher education institution. An official administrative or academic position within a higher education institution is held by a staff member. Applies to staff members holding administrative or academic positions within higher education institutions. This term encompasses individuals occupying official roles in college governance, administration, or academic leadership." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_COMMUNITY_HEALTHCARE_SETTING> a skos:Concept ;
    skos:prefLabel "Community Healthcare Setting" ;
    skos:notation "2.2.13" ;
    skos:altLabel "COMMUNITY_HEALTHCARE_SETTING" ;
    skos:altLabel "Community Healthcare Setting" ;
    skos:altLabel "Community Health Facility" ;
    skos:altLabel "Local Healthcare Environment" ;
    skos:altLabel "Community Care Setting" ;
    skos:altLabel "Healthcare Facility" ;
    skos:definition "A healthcare facility that delivers clinical care services within a community-based environment. This setting provides direct patient care and clinical service delivery to local populations. A healthcare facility is defined as an entity that delivers clinical care services within a community-based environment. Clinical care services are delivered by a healthcare facility situated within a community-based environment. This term describes a healthcare facility that delivers clinical care services within a community-based environment." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CONTINUOUS_EMISSIONS_MONITORING_SYSTEM> a skos:Concept ;
    skos:prefLabel "Continuous Emissions Monitoring System" ;
    skos:notation "2.2.14" ;
    skos:altLabel "CONTINUOUS_EMISSIONS_MONITORING_SYSTEM" ;
    skos:altLabel "Continuous Emissions Monitoring System" ;
    skos:altLabel "CEMS" ;
    skos:altLabel "Emissions Monitoring System" ;
    skos:altLabel "Continuous Monitoring System" ;
    skos:altLabel "Environmental Monitoring System" ;
    skos:definition "A continuous emissions monitoring system is an environment control system that participates in continuous emissions monitoring processes. These systems are designed to measure and record emissions data in real-time, providing critical information for environmental compliance and operational efficiency. An environment control system is characterized as a component that participates in continuous emissions monitoring processes. Participation in continuous emissions monitoring processes is the defining relation for an environment control system. Used for systems that continuously monitor emissions, typically in industrial or environmental contexts, to ensure compliance with regulatory standards." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_COPIED_DOCUMENT> a skos:Concept ;
    skos:prefLabel "Copied Document" ;
    skos:notation "2.2.15" ;
    skos:altLabel "COPIED_DOCUMENT" ;
    skos:altLabel "Material Copy of Document" ;
    skos:altLabel "Document Replica" ;
    skos:altLabel "Derived Document Copy" ;
    skos:altLabel "Copied Material Document" ;
    skos:altLabel "Document Copy Artifact" ;
    skos:definition "A material copy of a document that derives its information content from an original document. This term describes any physical or digital artifact that replicates the informational structure of a source document through duplication processes. The concept encompasses all material forms of document replication, from photocopies to digital reproductions, where the informational content flows directly from the original source. A copied document is a document defined by the possession of a role realized in a specific continuant. When a document maintains a role that is realized in a specific continuant, that document is classified as a copied document. Applies to physical or digital document instances that replicate the information content of an original source document. Used when tracking document lineage through material replication events." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CORPORATE_AGENT> a skos:Concept ;
    skos:prefLabel "Corporate Agent" ;
    skos:notation "2.2.16" ;
    skos:altLabel "CORPORATE_AGENT" ;
    skos:altLabel "Corporate Agent" ;
    skos:altLabel "Business Entity" ;
    skos:altLabel "Commercial Organization" ;
    skos:altLabel "Corporate Actor" ;
    skos:altLabel "Business Organization" ;
    skos:definition "A corporate agent operates as a registered business entity engaging in commercial transactions, regulatory compliance, or corporate governance activities. The term encompasses corporations, LLCs, or partnerships conducting market operations, managing assets, or fulfilling legal obligations within a commercial framework. An entity qualifies as a commercial organization precisely when it engages in corporate activities. Participation in corporate activities constitutes the defining characteristic of a commercial organization. Applies when a registered business entity engages in commercial transactions, regulatory compliance, or corporate governance activities. This term covers corporations, LLCs, or partnerships operating within a market." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_DISPOSITION_CORPORATE_AUDIT_FUNCTION> a skos:Concept ;
    skos:prefLabel "Corporate Audit Function" ;
    skos:notation "6.1" ;
    skos:altLabel "CORPORATE_AUDIT_FUNCTION" ;
    skos:altLabel "corporate audit function" ;
    skos:altLabel "financial compliance function" ;
    skos:altLabel "audit department function" ;
    skos:altLabel "corporate compliance activity" ;
    skos:altLabel "financial audit role" ;
    skos:definition "Corporate audit functions execute systematic reviews of financial data and business processes to ensure accuracy and regulatory adherence. These functions utilize standardized methodologies to assess risk management and internal controls within organizational frameworks. The term encompasses the specific activities performed to validate financial reporting and operational integrity. A financial artifact function is defined as a function that is realized in a corporate audit process. The realization context of a financial artifact function is a corporate audit process. Operational roles within corporate structures responsible for verifying financial records and ensuring regulatory compliance. The term applies to functions performed by internal audit teams or external auditors examining financial statements and operational procedures." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_DISPOSITION> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CORPORATE_COALITION> a skos:Concept ;
    skos:prefLabel "Corporate Coalition" ;
    skos:notation "2.2.17" ;
    skos:altLabel "CORPORATE_COALITION" ;
    skos:altLabel "Corporate Coalition" ;
    skos:altLabel "Business Alliance Group" ;
    skos:altLabel "Corporate Partnership Network" ;
    skos:altLabel "Commercial Organization Group" ;
    skos:altLabel "Corporate Coalition Entity" ;
    skos:definition "A group of organizations that includes at least one commercial organization as a participant. This term describes organizational structures where multiple commercial entities collaborate through formalized partnerships. The concept captures business arrangements where corporations join forces to pursue common goals, maintain shared operations, or execute joint commercial initiatives through structured organizational frameworks. A continuant type designated as a corporate coalition possesses a continuant part classified as a social role or function, thereby resolving the error where realized_in was wrongly used for a continuant subject instead of a process. The continuant part of a corporate coalition (which is itself a continuant type) must be a social role or function, a configuration that fixes the prior misuse of realized_in on a continuant subject rather than on a process. Applies to organizational structures formed by multiple commercial entities working together toward shared obj" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CORPORATE_EMPLOYEE> a skos:Concept ;
    skos:prefLabel "Corporate Employee" ;
    skos:notation "2.2.18" ;
    skos:altLabel "CORPORATE_EMPLOYEE" ;
    skos:altLabel "Corporate Employee" ;
    skos:altLabel "Corporate Staff Member" ;
    skos:altLabel "Corporate Worker" ;
    skos:altLabel "Corporate Team Member" ;
    skos:definition "A corporate employee is an organization member that participates in a corporate employment process. This member works within a corporate structure and contributes to corporate activities. The member fulfills corporate duties and responsibilities. An organization member is defined as any entity that participates in a corporate employment process. Participation in a corporate employment process characterizes an organization member. A corporate employee is an organization member that participates in a corporate employment process. This member works within a corporate structure." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CORPORATE_REPUTATION_METRIC> a skos:Concept ;
    skos:prefLabel "Corporate Reputation Metric" ;
    skos:notation "0.9" ;
    skos:altLabel "CORPORATE_REPUTATION_METRIC" ;
    skos:altLabel "Corporate Reputation Measurement" ;
    skos:altLabel "Reputation Assessment Metric" ;
    skos:altLabel "Corporate Brand Metric" ;
    skos:altLabel "Reputation Index Score" ;
    skos:altLabel "Corporate Standing Metric" ;
    skos:altLabel "Reputation Evaluation Measure" ;
    skos:definition "This term identifies measurement information content entities that quantify corporate reputation through structured data collection and analytical processes. Practitioners apply this label when documenting survey instruments, media monitoring reports, social sentiment scores, or brand equity assessments that capture public perception, stakeholder trust, and organizational standing in commercial markets. A corporate reputation metric is realized within a measurement process. (Simple declarative) A measurement process realizes a corporate reputation metric. (Active/procedural) A measurement information content entity that quantifies corporate reputation through structured data collection and analysis." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC_COURSE_SELECTION_SET> a skos:Concept ;
    skos:prefLabel "Course Selection Set" ;
    skos:notation "3.2" ;
    skos:altLabel "COURSE_SELECTION_SET" ;
    skos:altLabel "Course Selection Set" ;
    skos:altLabel "Course Set" ;
    skos:altLabel "Selected Courses" ;
    skos:altLabel "Course Package" ;
    skos:altLabel "Educational Course Set" ;
    skos:definition "A course selection set is a generically dependent continuant that comprises a set of courses selected for an educational track. This collection is tailored to meet specific educational goals or requirements, ensuring that participants acquire the necessary knowledge and skills through a structured curriculum. A set of course selections constitutes an information content entity. (Definitional) The classification of a set of course selections designates it as an information content entity. (Procedural/Act-focused) Refers to a collection of courses that have been selected for a specific educational track or program, often used in academic planning or curriculum design." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_COURT_DOCUMENT> a skos:Concept ;
    skos:prefLabel "Court Document" ;
    skos:notation "3.0.42" ;
    skos:altLabel "COURT_DOCUMENT" ;
    skos:altLabel "Court Record" ;
    skos:altLabel "Legal Filing" ;
    skos:altLabel "Judicial Document" ;
    skos:altLabel "Court Paperwork" ;
    skos:altLabel "Legal Record" ;
    skos:definition "A form document that participates in a legal proceeding. This term covers formal written records, such as motions, evidence submissions, or judgments, that are actively processed within court proceedings to advance legal cases or maintain judicial records. A form document is characterized as participating in a legal proceeding. Participation in a legal proceeding serves as the operational criterion for a form document. Applies to formal written records submitted to or generated by a court during legal proceedings. Practitioners use this term when cataloging evidence, motions, or judgments in litigation, compliance, or archival workflows." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CRIMINAL_JUSTICE_SYSTEM> a skos:Concept ;
    skos:prefLabel "Criminal Justice System" ;
    skos:notation "0.10" ;
    skos:altLabel "CRIMINAL_JUSTICE_SYSTEM" ;
    skos:altLabel "Criminal Justice System" ;
    skos:altLabel "CJS" ;
    skos:altLabel "Criminal Justice Infrastructure" ;
    skos:altLabel "Justice System Network" ;
    skos:altLabel "Criminal Justice Framework" ;
    skos:definition "The Criminal Justice System is a network of agencies and processes that enforce criminal law. This infrastructure supports law enforcement, courts, and corrections in maintaining public safety. The system coordinates investigations, prosecutions, and rehabilitation efforts. An infrastructure system is a system that participates in criminal justice processes. Participation in criminal justice processes characterizes an infrastructure system. The Criminal Justice System encompasses the network of agencies and processes that enforce criminal law. This infrastructure supports law enforcement, courts, and corrections in maintaining public safety. The system coordinates investigations, prosecutions, and rehabilitation efforts." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_CULTURAL_ATTRIBUTE> a skos:Concept ;
    skos:prefLabel "Cultural Attribute" ;
    skos:notation "0.11" ;
    skos:altLabel "CULTURAL_ATTRIBUTE" ;
    skos:altLabel "Cultural Quality" ;
    skos:altLabel "Organizational Quality" ;
    skos:altLabel "Culture Dimension" ;
    skos:altLabel "Cultural Trait" ;
    skos:definition "A cultural attribute is a quality that inheres in an organizational culture. This quality shapes the values and norms within the organization. The quality persists as a stable feature of the organizational culture. A quality is defined as an entity that inheres in an organizational culture. An organizational culture functions as the context for a quality that inheres within it. A cultural attribute describes the quality of an organizational culture. This quality inheres in the culture." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GDC_CURRICULUM> a skos:Concept ;
    skos:prefLabel "Curriculum" ;
    skos:notation "3.3" ;
    skos:altLabel "CURRICULUM" ;
    skos:altLabel "educational course plan" ;
    skos:altLabel "structured course set" ;
    skos:altLabel "academic program curriculum" ;
    skos:altLabel "course sequence" ;
    skos:altLabel "instructional curriculum" ;
    skos:altLabel "educational course framework" ;
    skos:definition "A generically dependent continuant that comprises a structured set of courses. This term represents the organized collection of courses designed for educational instruction. A structured set of courses comprising an educational program. This entity organizes individual courses into a coherent sequence for educational instruction." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GDC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CUSTOMER_NETWORK> a skos:Concept ;
    skos:prefLabel "Customer Network" ;
    skos:notation "2.2.19" ;
    skos:altLabel "CUSTOMER_NETWORK" ;
    skos:altLabel "Customer Network" ;
    skos:altLabel "Client Network" ;
    skos:altLabel "Consumer Network" ;
    skos:altLabel "Customer Device Network" ;
    skos:altLabel "Client Device Network" ;
    skos:definition "A customer network connects a business with its clients through digital devices such as smartphones, tablets, or web browsers. The term encompasses platforms used for customer engagement, loyalty program tracking, or service delivery via mobile applications and web interfaces. The relation has_continuant_part is kept because it accurately maps a network continuant to the device parts that constitute it. We retain has_continuant_part since it properly connects the network continuant with its device parts. Applies when tracking interactions between a business and its customers through digital devices. This term covers networks used for customer engagement, loyalty programs, or service delivery via mobile or web platforms." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_DISH> a skos:Concept ;
    skos:prefLabel "Dish" ;
    skos:notation "2.2.20" ;
    skos:altLabel "DISH" ;
    skos:altLabel "served food portion" ;
    skos:altLabel "plate meal" ;
    skos:altLabel "plated dish" ;
    skos:altLabel "food serving" ;
    skos:altLabel "meal portion" ;
    skos:altLabel "dinner plate" ;
    skos:definition "This term identifies portions of food that are actively served on dish receivers. It captures the specific configuration of food items arranged for presentation and consumption. The term emphasizes the relationship between the food portion and the physical receiver that holds it during service. A portion of food is defined as an item served on a dish receiver. The serving relationship on a dish receiver applies to a portion of food. Applies to food servings that are presented on specific receivers for consumption." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_DISTRICT_EMPLOYEE> a skos:Concept ;
    skos:prefLabel "District Employee" ;
    skos:notation "5.56" ;
    skos:altLabel "DISTRICT_EMPLOYEE" ;
    skos:altLabel "District Government Worker" ;
    skos:altLabel "Local Government Staff Member" ;
    skos:altLabel "District Member Role" ;
    skos:altLabel "District Office Employee" ;
    skos:altLabel "Municipal District Staff" ;
    skos:definition "An organization member role held by an individual affiliated with a seat of local government. The role encompasses duties within district administrative structures, supporting local governance and public service delivery. The concept designates an organization member role that is occupied by an individual who maintains an affiliation with a seat of local government. An individual affiliated with a seat of local government holds an organization member role. This organization member role held by an individual affiliated with a seat of local government applies to workers within district administrative structures. The role appears in local governance, public service, and administrative operations." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_DOMESTIC_VIOLENCE_VICTIM_CLIENT> a skos:Concept ;
    skos:prefLabel "Domestic Violence Victim Client" ;
    skos:notation "0.12" ;
    skos:altLabel "DOMESTIC_VIOLENCE_VICTIM_CLIENT" ;
    skos:altLabel "Domestic Violence Victim Client" ;
    skos:altLabel "Domestic Violence Survivor Client" ;
    skos:altLabel "DV Client" ;
    skos:altLabel "Domestic Violence Client" ;
    skos:altLabel "Victim of Domestic Violence Client" ;
    skos:definition "A domestic violence victim client is a survivor of domestic violence who is involved in a legal proceeding. This term highlights the intersection of personal safety and legal advocacy, emphasizing the need for specialized support and representation to navigate the legal system and secure relief. A survivor of domestic violence is defined as an individual who pursues legal advocacy or relief through a legal proceeding. The pursuit of legal advocacy or relief via a legal proceeding serves as the defining condition for a survivor of domestic violence in this model. Applies to individuals who are survivors of domestic violence and are involved in legal proceedings, seeking legal advocacy or relief." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_DONOR> a skos:Concept ;
    skos:prefLabel "Donor" ;
    skos:notation "1.95" ;
    skos:altLabel "DONOR" ;
    skos:altLabel "Hospital Donor" ;
    skos:altLabel "Hospital-Gift Donor" ;
    skos:altLabel "Donor-Hospital Recipient" ;
    skos:altLabel "Hospital-Beneficiary Donor" ;
    skos:altLabel "Donation Recipient Hospital" ;
    skos:altLabel "Hospital-Target Donor" ;
    skos:definition "This term identifies a donor entity whose donation transaction specifically designates a hospital as the recipient organization. Practitioners use this label when documenting charitable contributions, medical supply donations, or financial gifts directed to healthcare facilities for patient care, research, or operational support. A donating act qualifies as this type if a hospital serves as the recipient. In this donating act, a hospital fulfills the recipient role. A donor entity participating in an act of donation where the hospital serves as the direct recipient of the donated goods or funds." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_DONOR_AGENT> a skos:Concept ;
    skos:prefLabel "Donor Agent" ;
    skos:notation "2.2.21" ;
    skos:altLabel "DONOR_AGENT" ;
    skos:altLabel "Donation participant agent" ;
    skos:altLabel "Donating agent" ;
    skos:altLabel "Donation acting entity" ;
    skos:altLabel "Donor acting party" ;
    skos:definition "An agent that participates in the Act of Donating. The agent actively engages in the donation process, contributing to the successful completion of the donating act. An agent is defined as any entity that takes part in a donating act. An entity is recognized as an agent when it participates in a donating act. An agent that takes an active role in the act of donating." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_EARTH_OBSERVATION_DATA> a skos:Concept ;
    skos:prefLabel "Earth Observation Data" ;
    skos:notation "0.13" ;
    skos:altLabel "EARTH_OBSERVATION_DATA" ;
    skos:altLabel "satellite environmental data" ;
    skos:altLabel "Earth observation data" ;
    skos:altLabel "orbital environmental data" ;
    skos:altLabel "satellite-collected environmental data" ;
    skos:altLabel "environmental data from satellites" ;
    skos:altLabel "remote environmental data" ;
    skos:definition "Environmental data collected by a satellite artifact. This term applies to datasets captured by orbital platforms using specialized sensors to monitor the Earth's atmosphere, land, and oceans. Environmental data is defined by its collection through a satellite artifact. A satellite artifact is responsible for gathering environmental data. Environmental data gathered from orbit by satellite artifacts equipped with remote sensing instruments. This data supports atmospheric monitoring, land surface tracking, and oceanographic studies." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_ECONOMIC_GOODS_AND_SERVICES> a skos:Concept ;
    skos:prefLabel "Economic Goods And Services" ;
    skos:notation "0.14" ;
    skos:altLabel "ECONOMIC_GOODS_AND_SERVICES" ;
    skos:altLabel "Economic Goods and Services" ;
    skos:altLabel "Traded Economic Functions" ;
    skos:altLabel "Commercial Service Functions" ;
    skos:altLabel "Economic Trade Functions" ;
    skos:altLabel "Tariff Structure Services" ;
    skos:definition "A service function that is traded or regulated within a specific tariff structure. This term captures economic functions participating in structured trade arrangements governed by tariff frameworks. The concept encompasses service activities that operate within formalized economic systems, including functions involved in tariff-based transactions and regulated economic exchanges. A service function is identified as an item that is traded or regulated within a specific tariff structure. Applies to service functions traded within specific tariff structures. Used when documenting economic functions that participate in structured trade arrangements and tariff-based transactions." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_ENERGY_SAVING_COMPONENT> a skos:Concept ;
    skos:prefLabel "Energy Saving Component" ;
    skos:notation "2.2.22" ;
    skos:altLabel "ENERGY_SAVING_COMPONENT" ;
    skos:altLabel "Energy Efficiency Part" ;
    skos:altLabel "Power Saver Module" ;
    skos:altLabel "Efficiency Component" ;
    skos:altLabel "Energy Optimizer" ;
    skos:definition "A hardware part installed within a heating system to reduce power consumption and improve thermal efficiency. The component operates continuously to maintain optimized temperature settings and lower energy usage. A power source component is defined as a unit deployed within a heating system for the purpose of improving energy efficiency. Within a heating system, a power source component is utilized to improve energy efficiency. Applies to hardware parts installed in heating systems to reduce power consumption and improve thermal efficiency. These components operate continuously to maintain optimized temperature settings." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_ETHICAL_INVESTMENT_ASSET> a skos:Concept ;
    skos:prefLabel "Ethical Investment Asset" ;
    skos:notation "2.2.23" ;
    skos:altLabel "ETHICAL_INVESTMENT_ASSET" ;
    skos:altLabel "Ethical investment asset" ;
    skos:altLabel "Ethical financial instrument" ;
    skos:altLabel "Ethical investment" ;
    skos:altLabel "Ethical fund asset" ;
    skos:altLabel "Ethical portfolio asset" ;
    skos:definition "A financial instrument that is designated for or aligned with ethical investment strategies. This asset serves a purpose of directing capital toward organizations and projects that meet specific ethical criteria. A financial instrument is defined as such in this context when it is designated for or aligned with ethical investment strategies. The property of being designated for or aligned with ethical investment strategies applies to a financial instrument to satisfy this condition. Applies to a financial instrument designated for ethical investment strategies." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE_ETHICAL_REQUIREMENT> a skos:Concept ;
    skos:prefLabel "Ethical Requirement" ;
    skos:notation "3.2.5" ;
    skos:altLabel "ETHICAL_REQUIREMENT" ;
    skos:altLabel "Ethical Standard Requirement" ;
    skos:altLabel "Ethical Compliance Requirement" ;
    skos:altLabel "Research Ethics Requirement" ;
    skos:altLabel "Ethical Conduct Standard" ;
    skos:altLabel "Ethical Principle Requirement" ;
    skos:definition "Ethical requirement entities specify adherence to ethical principles or standards within research or professional contexts. Institutional review boards and compliance offices document these requirements to ensure ethical conduct during study implementation. A process requirement is the specification that mandates adherence to ethical principles or standards. A process requirement functions by specifying adherence to ethical principles or standards. Ethical requirement entities specify adherence to ethical principles or standards within research or professional contexts. Institutional review boards and compliance offices document these requirements to ensure ethical conduct during study implementation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DIRECTIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_EVALUATION_OUTCOME> a skos:Concept ;
    skos:prefLabel "Evaluation Outcome" ;
    skos:notation "1.96" ;
    skos:altLabel "EVALUATION_OUTCOME" ;
    skos:altLabel "Evaluation Result" ;
    skos:altLabel "Team Assessment Outcome" ;
    skos:altLabel "Assessment Result" ;
    skos:altLabel "Evaluation Gain" ;
    skos:altLabel "Assessment Result Artifact" ;
    skos:definition "An evaluation outcome represents the measurable result produced through systematic team assessment activities. This artifact captures quality improvements, performance metrics, and identified strengths derived from structured evaluation processes. A gain of quality is defined as an outcome that arises directly from a team assessment event. A team assessment event directly yields a gain of quality. An evaluation outcome represents the measurable result produced through systematic team assessment activities. This artifact captures quality improvements, performance metrics, and identified strengths derived from structured evaluation processes." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_EXECUTIVE_DIRECTOR_FUNCTION> a skos:Concept ;
    skos:prefLabel "Executive Director Function" ;
    skos:notation "5.57" ;
    skos:altLabel "EXECUTIVE_DIRECTOR_FUNCTION" ;
    skos:altLabel "ExecutiveDirectorFunction" ;
    skos:definition "A role within an organization that entails responsibility for executive direction and oversight constitutes an organization member role. An organization member role is characterized by its entailment of responsibility for executive direction and oversight. (Definitional/Characteristic) Responsibility for executive direction and oversight is entailed by an organization member role. (Relational-fronted/Passive)" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_EXECUTIVE_EXECUTION_FUNCTION> a skos:Concept ;
    skos:prefLabel "Executive Execution Function" ;
    skos:notation "0.15" ;
    skos:altLabel "EXECUTIVE_EXECUTION_FUNCTION" ;
    skos:altLabel "executive execution function" ;
    skos:altLabel "strategic implementation" ;
    skos:altLabel "leadership execution" ;
    skos:altLabel "executive action" ;
    skos:altLabel "management implementation" ;
    skos:altLabel "executive operations" ;
    skos:definition "Captures the operational process where senior leadership translates high-level strategy into actionable steps. This function focuses on the practical implementation of decisions, ensuring that organizational goals are achieved through direct management and execution. Applies to the active phase of leadership where strategic plans are translated into concrete actions, operational steps, or organizational changes." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_EXECUTIVE_TEAM> a skos:Concept ;
    skos:prefLabel "Executive Team" ;
    skos:notation "2.2.24" ;
    skos:altLabel "EXECUTIVE_TEAM" ;
    skos:altLabel "Executive Board" ;
    skos:altLabel "Senior Leadership" ;
    skos:altLabel "Executive Group" ;
    skos:altLabel "Leadership Team" ;
    skos:altLabel "Management Team" ;
    skos:definition "An organization composed of members holding executive leadership roles. This term describes groups of individuals who collectively hold executive leadership positions, such as CEOs, CFOs, or department heads, and collaborate on strategic decision-making and governance within an organization. Every organizational entity classified as an executive team must include at least one executive leadership process as a member. The membership relation of an executive team comprises at least one executive leadership process, while the team itself functions as an organizational entity. Applies to groups of individuals holding executive leadership roles within an organization. Practitioners use this term when describing governance structures, strategic decision-making bodies, or executive committees in corporate or institutional contexts." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_EXECUTIVE_TEAM_MEMBER> a skos:Concept ;
    skos:prefLabel "Executive Team Member" ;
    skos:notation "2.2.25" ;
    skos:altLabel "EXECUTIVE_TEAM_MEMBER" ;
    skos:altLabel "Executive Team Member" ;
    skos:altLabel "Executive Officer" ;
    skos:altLabel "Senior Leader" ;
    skos:altLabel "Executive Board Member" ;
    skos:altLabel "Leadership Team Member" ;
    skos:altLabel "Executive Participant" ;
    skos:definition "Designates an individual serving in a senior leadership role as part of an organization's executive team. This entity represents the active participation of a leader in executive decision-making and strategic governance. Applies to individuals serving in senior leadership roles as part of an organization's executive team." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_EXPEDITION_EQUIPMENT> a skos:Concept ;
    skos:prefLabel "Expedition Equipment" ;
    skos:notation "2.2.26" ;
    skos:altLabel "EXPEDITION_EQUIPMENT" ;
    skos:altLabel "Expedition Equipment" ;
    skos:altLabel "Arctic Gear" ;
    skos:altLabel "Polar Equipment" ;
    skos:altLabel "Expedition Gear" ;
    skos:altLabel "Field Equipment" ;
    skos:altLabel "Polar Gear" ;
    skos:definition "Designates equipment designed or utilized for polar research, logistics, and support missions. This entity encompasses the physical artifacts and tools deployed in Arctic environments to enable expedition activities. Equipment qualifies as arctic expedition gear if it is designed for an arctic expedition or if it is utilized for one. Equipment falls within the scope of arctic expedition use when it is designed for an arctic expedition or when it is utilized for an arctic expedition. (Definitional) Used to document equipment designed or utilized for polar research, logistics, and support missions." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_EXPEDITION_PARTICIPANT> a skos:Concept ;
    skos:prefLabel "Expedition Participant" ;
    skos:notation "2.2.27" ;
    skos:altLabel "EXPEDITION_PARTICIPANT" ;
    skos:altLabel "expedition crew member" ;
    skos:altLabel "arctic expedition member" ;
    skos:altLabel "expedition traveler" ;
    skos:altLabel "expedition staff" ;
    skos:altLabel "arctic crew member" ;
    skos:altLabel "expedition team member" ;
    skos:definition "This term identifies crew members who are actively participating in arctic expeditions. It represents the individuals who contribute to the execution and success of arctic expedition activities. The term grounds the concept of participation in the specific context of arctic expeditions and the roles of crew members within them. A crew member is defined as an individual who participates in an arctic expedition. A crew member is identified by their participation in an arctic expedition. Applies to crew members who are part of arctic expedition teams." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_EXPERIENCED_MENTOR> a skos:Concept ;
    skos:prefLabel "Experienced Mentor" ;
    skos:notation "5.58" ;
    skos:altLabel "EXPERIENCED_MENTOR" ;
    skos:altLabel "Experienced mentor" ;
    skos:altLabel "Professional mentor" ;
    skos:altLabel "Senior mentor" ;
    skos:altLabel "Mentor with professional experience" ;
    skos:altLabel "Experienced guidance provider" ;
    skos:definition "This term identifies an interpersonal relationship role held by an individual with substantial professional experience who provides mentorship. It encompasses guides who offer advice and support based on their career achievements and expertise. An interpersonal relationship role is formally defined as a position occupied by an experienced individual who performs the function of providing mentorship. This interpersonal relationship role is instantiated when an experienced individual assumes the position to deliver mentorship. Use this term for individuals with substantial professional experience who provide mentorship. It applies to the role of mentorship, not to mentorship programs, external agencies, or petitioners." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ROLE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE_EXPORT_EXECUTION> a skos:Concept ;
    skos:prefLabel "Export Execution" ;
    skos:notation "3.3.3" ;
    skos:altLabel "EXPORT_EXECUTION" ;
    skos:altLabel "PDF export execution profile" ;
    skos:altLabel "Pdf export process execution" ;
    skos:altLabel "Pdf export operation profile" ;
    skos:altLabel "Pdf export run profile" ;
    skos:definition "A process profile that defines the execution parameters for the Pdf Export Process. The profile captures the specific operational settings and workflow requirements that guide the realization of the PDF export activity. A process profile is defined as the entity that realizes the execution of a PDF export process. The execution of a PDF export process is realized by a process profile. A process profile that governs the execution parameters for the specific act of exporting data to a PDF format." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE_DESIGNATIVE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_EXPORTED_DATA_ARTIFACT> a skos:Concept ;
    skos:prefLabel "Exported Data Artifact" ;
    skos:notation "2.2.28" ;
    skos:altLabel "EXPORTED_DATA_ARTIFACT" ;
    skos:altLabel "Exported Data Artifact" ;
    skos:altLabel "Data Export Product" ;
    skos:altLabel "Exported Information Artifact" ;
    skos:altLabel "Data Export Material" ;
    skos:altLabel "Export Process Output" ;
    skos:definition "A material artifact that is produced by a data export process. This term captures physical or digital artifacts generated through systematic data export operations. The concept encompasses any material form of data output, from physical printouts to digital files, created through structured data export procedures that transform information into tangible or digital artifacts. Material artifacts are items generated through a data export process. The production of a material artifact occurs via a data export process. Applies to material artifacts produced through data export processes. Used when tracking information artifacts that result from systematic data export operations." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_EXTERNAL_AGENCY> a skos:Concept ;
    skos:prefLabel "External Agency" ;
    skos:notation "2.2.29" ;
    skos:altLabel "EXTERNAL_AGENCY" ;
    skos:altLabel "External Agency" ;
    skos:altLabel "Outside Business Partner" ;
    skos:altLabel "External Agent" ;
    skos:altLabel "Third-Party Agent" ;
    skos:altLabel "External Organization" ;
    skos:definition "An agent that maintains an external business partner relationship with an organization. This term applies to any independent entity or individual that engages in business activities with the organization through a formal partnership arrangement. An agent is defined as an entity that maintains an external business partner relationship with an organization. An external business partner relationship with an organization is maintained by an agent. Identifies an agent that maintains an external business partner relationship with an organization. Used to distinguish external entities from internal staff." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_INDUSTRIAL_EMISSION_SOURCE> a skos:Concept ;
    skos:prefLabel "Industrial Emission Source" ;
    skos:notation "2.2.30" ;
    skos:altLabel "INDUSTRIAL_EMISSION_SOURCE" ;
    skos:altLabel "industrial emission source" ;
    skos:altLabel "pollution source" ;
    skos:altLabel "emitting facility" ;
    skos:altLabel "industrial outlet" ;
    skos:altLabel "pollutant release point" ;
    skos:definition "This term identifies the physical power source or material entity that actively emits industrial pollutants into the surrounding environment. It captures the concrete origin point of emissions, such as a smokestack, exhaust pipe, or industrial furnace. Practitioners use it to track environmental impact and regulatory compliance at the source level. A power source is defined as an entity that releases industrial pollutants into the environment. (Definitional) Industrial pollutants are released into the environment by a power source. (Relational-fronted) Used when identifying the physical power source or facility component that releases industrial pollutants into the environment." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_INFORMATION_CAPABILITY> a skos:Concept ;
    skos:prefLabel "Information Capability" ;
    skos:notation "0.16" ;
    skos:altLabel "INFORMATION_CAPABILITY" ;
    skos:altLabel "information capability" ;
    skos:altLabel "information transmission capability" ;
    skos:altLabel "information processing capability" ;
    skos:altLabel "organizational information capability" ;
    skos:altLabel "information conveyance capability" ;
    skos:definition "An information capability represents an organization's inherent capacity to transmit, process, and manage information content through established systems, protocols, or workflows. Analysts and IT professionals employ this term when assessing organizational readiness, designing information architectures, or evaluating data flow efficiency within corporate or institutional settings. The capability encompasses the structural and procedural elements that enable reliable information exchange, supporting decision-making, operational continuity, and strategic alignment. An organizational capability is defined as a capacity that facilitates either the transmission or the processing of information content. The transmission or processing of information content is enabled by an organizational capability. Used in organizational studies and information systems to describe an organization's inherent capacity to transmit, process, or manage information content effectively, often involving specific te" ;
    skos:broader <https://signals.zndx.org/sdg#SDG_GENERIC> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_INFORMATION_ITEM> a skos:Concept ;
    skos:prefLabel "Information Item" ;
    skos:notation "3.0.43" ;
    skos:altLabel "INFORMATION_ITEM" ;
    skos:altLabel "Tagging metadata record" ;
    skos:altLabel "Social tagging data" ;
    skos:altLabel "Metadata encoding unit" ;
    skos:altLabel "Tag information element" ;
    skos:altLabel "Tagging content object" ;
    skos:definition "An information content entity that encodes metadata associated with a social tagging activity. This term denotes the discrete unit of information that captures details about tags, users, and resources involved in social tagging. It serves as the foundational element for organizing and retrieving tagged content. An information content entity is defined as the encoding of metadata linked to a social tagging activity. The encoding relationship of an information content entity applies to metadata connected to a social tagging activity. Applies to data structures that store and represent metadata generated during social tagging activities." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_INFORMATION_SYSTEM> a skos:Concept ;
    skos:prefLabel "Information System" ;
    skos:notation "2.2.31" ;
    skos:altLabel "INFORMATION_SYSTEM" ;
    skos:altLabel "Clinical Data Platform" ;
    skos:altLabel "Medical Records System" ;
    skos:altLabel "Health Information Exchange" ;
    skos:altLabel "Patient Data Repository" ;
    skos:altLabel "Clinical Documentation System" ;
    skos:definition "A communication system configured to manage, store, and process clinical documentation data. These systems maintain electronic patient records, track diagnostic results, and facilitate clinical decision-making by organizing patient data into searchable, secure digital repositories accessible to authorized healthcare providers. A communication system is set up to manage, store, and process clinical documentation data. (Too simple) Configuration of a communication system establishes the capability to manage, store, and process clinical documentation data. (Adds \"capability\") Software systems designed to store, retrieve, and manage electronic patient records, clinical notes, and diagnostic data within healthcare environments." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_INSPECTION_EVENT> a skos:Concept ;
    skos:prefLabel "Inspection Event" ;
    skos:notation "1.97" ;
    skos:altLabel "INSPECTION_EVENT" ;
    skos:altLabel "Inspection Event" ;
    skos:altLabel "Compliance Inspection" ;
    skos:altLabel "Condition Assessment Event" ;
    skos:altLabel "Inspection Activity" ;
    skos:altLabel "Regulatory Inspection" ;
    skos:definition "An act of observation conducted to verify compliance or condition, resulting in documented outcomes. This concept captures the specific instance of an inspection being performed, including the collection of evidence and the generation of inspection records that reflect the findings of the observation. An observation performed to confirm compliance or a condition constitutes an act that produces documented outcomes. Documented outcomes are the direct result of an observation act undertaken for verifying compliance or condition. Applies to formal inspection activities conducted to verify compliance, safety, or operational conditions." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_INTELLIGENCE_OUTPUT> a skos:Concept ;
    skos:prefLabel "Intelligence Output" ;
    skos:notation "2.2.32" ;
    skos:altLabel "INTELLIGENCE_OUTPUT" ;
    skos:altLabel "Intelligence Output" ;
    skos:altLabel "Healthcare Analytics Result" ;
    skos:altLabel "Analytical Information Artifact" ;
    skos:altLabel "Processed Intelligence" ;
    skos:altLabel "Healthcare Data Output" ;
    skos:definition "Intelligence Output is an information processing artifact that results from healthcare analytics processes. It represents the tangible outcomes of analyzing healthcare data, such as reports, dashboards, or alerts, which provide actionable insights for stakeholders. This output is generated through the application of analytical methods to healthcare data, enabling the extraction of meaningful information to support decision-making and operational improvements. An information processing artifact is defined as an entity that emerges when healthcare data undergoes analysis aimed at producing actionable insights. When healthcare data is analyzed for the purpose of deriving actionable insights, the outcome constitutes an information processing artifact. This term describes an information processing artifact generated from healthcare analytics, representing the results of analyzing healthcare data. It includes the outputs produced by processes that transform raw data into actionable insights," ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_INTERDISCIPLINARY_EDUCATION> a skos:Concept ;
    skos:prefLabel "Interdisciplinary Education" ;
    skos:notation "1.98" ;
    skos:altLabel "INTERDISCIPLINARY_EDUCATION" ;
    skos:altLabel "Interdisciplinary Education" ;
    skos:altLabel "Integrated Discipline Training" ;
    skos:altLabel "Multi-Disciplinary Instruction" ;
    skos:altLabel "Cross-Disciplinary Learning" ;
    skos:altLabel "Integrated Vocational Training" ;
    skos:definition "Interdisciplinary Education is an instructional process that integrates knowledge and methodologies from multiple academic disciplines. It combines content, methods, and perspectives from different fields to provide a comprehensive and cohesive learning experience. This approach fosters a deeper understanding of complex topics by connecting insights from various disciplines, enhancing the ability to address multifaceted challenges and develop integrated solutions. An instructional process is defined as a structure that integrates knowledge and methodologies from multiple academic disciplines. Knowledge and methodologies from multiple academic disciplines are integrated within an instructional process. This term describes an instructional process that integrates knowledge and methodologies from multiple academic disciplines. It involves the combination of content, methods, and perspectives from different fields to provide a comprehensive and cohesive learning experience." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_INVESTMENT_CHOICE_DECISION> a skos:Concept ;
    skos:prefLabel "Investment Choice Decision" ;
    skos:notation "1.99" ;
    skos:altLabel "INVESTMENT_CHOICE_DECISION" ;
    skos:altLabel "investment choice decision" ;
    skos:altLabel "investment selection act" ;
    skos:altLabel "financial option selection" ;
    skos:altLabel "portfolio decision act" ;
    skos:altLabel "asset allocation choice" ;
    skos:definition "An information processing act where an investor or advisor selects a specific financial investment option from a set of available alternatives. This process involves evaluating risk profiles, return expectations, and portfolio constraints to determine the final investment allocation. The act culminates in the formal selection of the chosen financial value for portfolio integration. An information processing act is defined as the selection of a specific financial investment option from among available alternatives. During an information processing act, the procedure consists of identifying and choosing a specific financial investment option from the available alternatives. An information processing act where an investor or advisor selects a specific financial investment option from a set of available alternatives. This process involves evaluating risk profiles, return expectations, and portfolio constraints to determine the final investment allocation." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_INVESTOR_FUNDING_SITUATION> a skos:Concept ;
    skos:prefLabel "Investor Funding Situation" ;
    skos:notation "1.100" ;
    skos:altLabel "INVESTOR_FUNDING_SITUATION" ;
    skos:altLabel "Investor Funding Situation" ;
    skos:altLabel "Investment Funding Event" ;
    skos:altLabel "Capital Allocation by Investor" ;
    skos:altLabel "Investor Funding Instance" ;
    skos:altLabel "Equity Funding Event" ;
    skos:definition "An act of funding where financial resources are allocated by an investor to support a business venture. This concept represents the specific instance of an institutional investor providing financial resources, such as equity or debt, to support the operational or growth needs of a business entity. An act of funding is defined as the allocation of financial resources by an investor to support a business venture. In an act of funding, an investor allocates financial resources to support a business venture. Applies to financial transactions where an institutional investor provides capital to a business venture." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_GENERIC_INVESTOR_RELATIONS_ACTIVITY> a skos:Concept ;
    skos:prefLabel "Investor Relations Activity" ;
    skos:notation "0.17" ;
    skos:altLabel "INVESTOR_RELATIONS_ACTIVITY" ;
    skos:altLabel "Investor Relations" ;
