    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_THREAT_INFORMATION> a skos:Concept ;
    skos:prefLabel "Threat Information" ;
    skos:notation "2.2.45" ;
