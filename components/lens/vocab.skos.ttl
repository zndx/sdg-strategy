    skos:altLabel "Audit specialist" ;
    skos:altLabel "Certified audit expert" ;
    skos:definition "A CertifiedInternalAuditor is a material entity that has a certificate. It identifies the individual who holds a specific certification. This term applies when a material entity possesses a certificate. A material entity is defined as an instance that has a certificate. A certificate is held by a material entity. A CertifiedInternalAuditor is a material entity that has a certificate." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CHEMICAL_INSTALLATION> a skos:Concept ;
    skos:prefLabel "Chemical Installation" ;
    skos:notation "2.2.6" ;
    skos:altLabel "CHEMICAL_INSTALLATION" ;
    skos:altLabel "Chemical processing plant" ;
    skos:altLabel "Chemical production facility" ;
    skos:altLabel "Chemical manufacturing site" ;
    skos:altLabel "Chemical manufacturing plant" ;
    skos:definition "A chemical manufacturing facility that handles chemical substances as core objects within its operational scope. The facility engages in the physical processing or manufacturing activities involving these chemical materials. A physical facility designed for the processing or manufacturing of chemical substances." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_CHILD_PROTECTION_TEAM> a skos:Concept ;
    skos:prefLabel "Child Protection Team" ;
    skos:notation "2.2.7" ;
    skos:altLabel "CHILD_PROTECTION_TEAM" ;
    skos:altLabel "ChildProtectionTeam" ;
