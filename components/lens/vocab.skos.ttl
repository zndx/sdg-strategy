    skos:altLabel "Market Participant" ;
    skos:altLabel "Autonomous Economic Actor" ;
    skos:altLabel "Independent Business Entity" ;
    skos:altLabel "Standalone Economic Agent" ;
    skos:definition "An Independent Economic Agent functions as an autonomous decision-maker that participates in market exchanges with external business partners. This entity maintains operational independence, negotiates contracts, and manages resources to achieve economic objectives. The agent engages in strategic market activities, including procurement, sales, and investment, to sustain its economic viability and competitive positioning. Applies to economic entities that participate in market exchanges as autonomous decision-makers, independent of other organizations." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_INDIVIDUAL> a skos:Concept ;
