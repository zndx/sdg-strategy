    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_HEALTHCARENETWORKINFRASTRUCTURE> a skos:Concept ;
    skos:prefLabel "Filler Healthcarenetworkinfrastructure" ;
    skos:notation "2.2.71" ;
    skos:altLabel "FILLER_HEALTHCARENETWORKINFRASTRUCTURE" ;
    skos:altLabel "Healthcare Network Infrastructure" ;
    skos:altLabel "Healthcare Network Support System" ;
    skos:altLabel "Medical Service Network Backbone" ;
    skos:altLabel "Clinical Service Network" ;
    skos:altLabel "Healthcare Connectivity Infrastructure" ;
    skos:definition "Healthcare Network Infrastructure constitutes the underlying network support system that facilitates the delivery of healthcare services. It includes the computer networks, servers, and communication channels that connect healthcare facilities, enabling the transmission of patient data, clinical information, and operational communications. This infrastructure ensures reliable and secure connectivity for healthcare operations, supporting the continuous provision of medical services and patient care. This term designates the physical and logical network components that provide connectivity for healthcare services within a designated operational area. It encompasses the hardware, software, and communication protocols that enable data exchange between healthcare facilities, providers, and patients." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY_FILLER_HEALTHCAREORGANIZATION> a skos:Concept ;
    skos:prefLabel "Filler Healthcareorganization" ;
    skos:notation "2.2.72" ;
    skos:altLabel "FILLER_HEALTHCAREORGANIZATION" ;
    skos:altLabel "Healthcare provider" ;
    skos:altLabel "Medical organization" ;
    skos:altLabel "Health service provider" ;
    skos:altLabel "Healthcare institution" ;
    skos:altLabel "Medical facility" ;
    skos:definition "A HealthcareOrganization is an Organization that provides healthcare services through healthcare facilities. It defines the entity responsible for delivering medical care. This term applies when an organization operates healthcare facilities to provide services. A HealthcareOrganization is an Organization that provides healthcare services through healthcare facilities." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_MATERIAL_ENTITY> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_DESCRIPTIVE_FILLER_HEIGHTMEASUREMENT> a skos:Concept ;
    skos:prefLabel "Filler Heightmeasurement" ;
    skos:notation "3.1.23" ;
