    skos:altLabel "VariationMarginRuleSet" ;
    skos:altLabel "CollateralExchangeProcess" ;
    skos:altLabel "ComplianceAudit" ;
    skos:definition "A VariationMarginRuleSet functions as a directive ICE that mandates a CollateralExchangeProcess and is verified by a ComplianceAudit. When operating as a directive ICE, a VariationMarginRuleSet mandates a CollateralExchangeProcess and is subject to verification by a ComplianceAudit. A ComplianceAudit verifies a VariationMarginRuleSet, and that same entity mandates a CollateralExchangeProcess, all while the VariationMarginRuleSet serves as a directive ICE." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ROLE_RECOGNITION_MANAGER_ROLE> a skos:Concept ;
