    skos:notation "1.81" ;
    skos:altLabel "RESIDENCY_REQUIREMENT" ;
    skos:altLabel "ResidencyRequirement" ;
    skos:altLabel "StudentAgent" ;
    skos:altLabel "AdministrativeOffice" ;
    skos:definition "Every instance of ResidencyRequirement qualifies as a DirectiveICE, and each such instance is linked to at least one StudentAgent through the mandatesCompletion relation and to at least one AdministrativeOffice through the enforcedByOffice relation. A ResidencyRequirement must function as a DirectiveICE, and it must mandate completion for at least one StudentAgent while being enforced by at least one AdministrativeOffice." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_PROCESS> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_ICE_APPEAL_WAIVER_CERTIFICATION> a skos:Concept ;
    skos:prefLabel "Appeal Waiver Certification" ;
    skos:notation "3.0.33" ;
    skos:altLabel "APPEAL_WAIVER_CERTIFICATION" ;
    skos:altLabel "AppealWaiverCertification" ;
    skos:altLabel "BoardOfEqualization" ;
    skos:altLabel "AppealWaiver" ;
    skos:altLabel "CertificationTime" ;
    skos:definition "An AppealWaiverCertification constitutes an InformationContentEntity that must certify for exactly one BoardOfEqualization, certify exactly one AppealWaiver, and include a certificationTime. The relation certifies for exactly one BoardOfEqualization and the relation certifies exactly one AppealWaiver, together with a certificationTime, define an AppealWaiverCertification as a type of InformationContentEntity. An AppealWaiverCertification, as an InformationContentEntity, stands in the certification relation to exactly one BoardOfEqualization and exactly one AppealWaiver, while also possessing a certificationTime." ;
    skos:broader <https://signals.zndx.org/sdg#SDG_ICE> ;
    skos:inScheme <https://signals.zndx.org/sdg/scheme> .

<https://signals.zndx.org/sdg#SDG_PROCESS_BOARD_MEETING_AGENDA_ITEM> a skos:Concept ;
